# ---------------------------------------------------------------- the page's requests

FREE_API = ("poll", "stop", "ponder")  # requests without a library row


def api_free(name, req):
    """A request of the page that names no model: poll, stop or ponder (deep mode)."""
    if name == "poll":
        return deep_poll(req)
    if name == "stop":
        return deep_stop(req)
    if name == "ponder":
        return ponder_status(req)
    return dict(ok=False, error=f"unknown request {name}")


def api(name, req, row):
    """One request of the page (POST /play/api/<name>, JSON): prepare, move, deep, eval or save, for the library row
    `row`. Returns the JSON answer (a dict with ok)."""
    if name == "prepare":
        p = resolve(row)
        a = ENGINE.request({"op": "load", "spec": p["spec"]})
        if not a.get("ok"):
            return a
        ev = engine_eval(p["spec"], [])
        cal = (a.get("report") or "").strip().splitlines()
        m = re.match(r"^calibration on \S+: (\S+ \(\d+ positions\))", cal[0]) if cal else None
        return dict(ok=True, calibration=m.group(1) if m else (cal[0] if cal else "none"), own_source=p["own_source"],
                    load_ms=a.get("load_ms"), probs=ev.get("probs"), kind=p["kind"],
                    model=os.path.relpath(p["model"], REPO))
    if name == "move":
        p = resolve(row)
        return engine_move(p["spec"], int(req.get("ply", 0)), req.get("moves") or [], req.get("policy") or "argmax",
                           0.02, int(req.get("seed") or 1), values=True)
    if name == "deep":
        return deep_start(row, req)
    if name == "eval":
        p = resolve(row)
        return engine_eval(p["spec"], req.get("moves") or [])
    if name == "save":
        p = resolve(row)
        path = save_game(row, p, req.get("game") or {})
        name = os.path.basename(path)
        h = dict(saved_games(400)).get(name) or {}
        return dict(ok=True, file=name, entry=saved_entry(name, h))
    return dict(ok=False, error=f"unknown request {name}")


# ---------------------------------------------------------------- checks from the command line

def find_row(arg, rows=None):
    ident, _, v = arg.partition("@")
    rows = rows if rows is not None else lib_rows()
    cands = [r for r in rows if r["id"] == ident]
    if not cands:
        sys.exit(f"no library row {ident}")
    if v:
        hit = [r for r in cands if str(int(r["version"])) == str(int(v))]
        if hit:
            return hit[0]
        return dict(cands[0], version=str(int(v)), version_role="other version")
    return cands[0]


def main():
    a = sys.argv[1:]
    if not a or a[0] not in ("resolve", "move", "legal", "deep"):
        sys.exit(__doc__)
    try:
        if a[0] == "legal":
            print(json.dumps(engine_legal(a[1:]), indent=1))
            return
        row = find_row(a[1])
        p = resolve(row, progress=lambda s: print("...", s, flush=True))
        if a[0] == "resolve":
            print(json.dumps(p, indent=1))
        elif a[0] == "deep":
            f = deep_fields(p["spec"], a[2], a[3], a[4:], jid=1)
            t = float(f["seconds"])
            out = ENGINE.request(f, timeout=t + DEEP_MARGIN_S if t else DEEP_NOLIMIT_S,
                                 progress=lambda it: print("... depth", it["depth"], it["san"], it["value"],
                                                           f"{it['at_ms'] / 1000:.2f} s", flush=True))
            print(json.dumps(out, indent=1))
        else:
            print(json.dumps(engine_move(p["spec"], int(a[2]), a[3:], values=True), indent=1))
    finally:
        ENGINE.stop()


if __name__ == "__main__":
    main()
