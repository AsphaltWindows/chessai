# ---------------------------------------------------------------- small helpers

def now():
    return f"{datetime.datetime.now():%Y-%m-%d %H:%M:%S}"


def atomic_write(path, text):
    tmp = f"{path}.tmp{os.getpid()}.{threading.get_ident()}"
    with open(tmp, "w") as f:
        f.write(text)
    os.replace(tmp, path)


def write_json(path, obj):
    atomic_write(path, json.dumps(obj, indent=1) + "\n")


def read_json(path, default=None):
    if not os.path.exists(path):
        return default
    with open(path) as f:
        return json.load(f)


def e1(x):
    """Elo and the like: one decimal, a plain number (never a "+" sign); empty for None."""
    return "" if x is None else f"{0.0 if abs(x) < 0.05 else x:.1f}"


def c2(x):
    return "" if x is None else f"{0.0 if abs(x) < 0.005 else x:.2f}"


def cell(x):
    if x is None:
        return ""
    if isinstance(x, bool):
        return "1" if x else "0"
    if isinstance(x, float):
        return "" if math.isnan(x) else f"{x:.2f}"
    return str(x)


def read_csv(path):
    if not os.path.exists(path):
        return []
    with open(path, newline="") as f:
        return list(csv.DictReader(f))


def csv_text(fields, rows):
    buf = io.StringIO()
    w = csv.DictWriter(buf, fieldnames=fields, lineterminator="\n", extrasaction="ignore")
    w.writeheader()
    for r in rows:
        w.writerow({k: cell(r.get(k)) for k in fields})
    return buf.getvalue()


def write_csv(path, fields, rows):
    atomic_write(path, csv_text(fields, rows))


def append_cycle_rows(path, fields, rows, cycle):
    """Adds `rows` of `cycle` to a per-cycle CSV, replacing rows of that cycle already there (a records phase run again
    after an interruption writes the same rows once)."""
    old = [r for r in read_csv(path) if r.get("cycle") != str(cycle)]
    write_csv(path, fields, old + rows)


def file_md5(path):
    h = hashlib.md5()
    with open(path, "rb") as f:
        for block in iter(lambda: f.read(1 << 20), b""):
            h.update(block)
    return h.hexdigest()


def link_or_copy(a, b):
    try:
        os.link(a, b)
    except OSError:
        shutil.copy2(a, b)


def link_tree(src, dst):
    shutil.copytree(src, dst, copy_function=link_or_copy)


def parse_flags(tokens):
    """[(flag, value or True)] in order; a flag takes the next token as its value unless that is another flag."""
    out, i = [], 0
    while i < len(tokens):
        t = tokens[i]
        if i + 1 < len(tokens) and not tokens[i + 1].startswith("--"):
            out.append((t, tokens[i + 1]))
            i += 2
        else:
            out.append((t, True))
            i += 1
    return out


def without_flags(tokens, flags):
    out = []
    for k, v in parse_flags(tokens):
        if k not in flags:
            out += [k] if v is True else [k, v]
    return out


def pid_alive(pid):
    return bool(pid) and os.path.exists(f"/proc/{pid}")


class FileLock:
    """An fcntl lock on a file (exclusive, or shared)."""

    def __init__(self, path, shared=False, block=True):
        self.path, self.shared, self.block = path, shared, block

    def __enter__(self):
        self.f = open(self.path, "a+")
        mode = (fcntl.LOCK_SH if self.shared else fcntl.LOCK_EX) | (0 if self.block else fcntl.LOCK_NB)
        try:
            fcntl.flock(self.f, mode)
        except OSError:
            self.f.close()
            raise
        return self

    def __exit__(self, *exc):
        fcntl.flock(self.f, fcntl.LOCK_UN)
        self.f.close()


# ---------------------------------------------------------------- child processes

CHILDREN = set()
CHILD_LOCK = threading.Lock()


def run_measured(cmd, log_path, title, env=None, cwd=None):
    """Runs cmd, streaming its output into log_path. Returns (exit code, CPU s, wall s, output). CPU is the child's
    own (rusage: user + system, all its threads)."""
    with open(log_path, "a") as f:
        f.write(f"== {title} {now()}: {shlex.join(cmd)}\n")
        f.flush()
        t0 = time.time()
        proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, env=env, cwd=cwd)
        with CHILD_LOCK:
            CHILDREN.add(proc)
        out = []
        try:
            for line in proc.stdout:
                f.write(line)
                f.flush()
                out.append(line)
            _, status, usage = os.wait4(proc.pid, 0)
        finally:
            with CHILD_LOCK:
                CHILDREN.discard(proc)
        proc.returncode = code = os.waitstatus_to_exitcode(status)
        cpu, wall = usage.ru_utime + usage.ru_stime, time.time() - t0
        f.write(f"== {title}: exit {code}, cpu {cpu:.1f} s, wall {wall:.1f} s\n")
    return code, cpu, wall, "".join(out)


def kill_children():
    with CHILD_LOCK:
        procs = list(CHILDREN)
    for p in procs:
        try:
            p.terminate()
        except OSError:
            pass


class Interrupted(Exception):
    pass


STOPPING = threading.Event()


def on_signal(signum, frame):
    STOPPING.set()
    kill_children()
    raise Interrupted(f"signal {signum}")


def check_interrupted():
    """Workers call this after a child returns: a child killed by an interruption records nothing."""
    if STOPPING.is_set():
        raise Interrupted("interrupted")


def threads_env(n):
    return dict(os.environ, RAYON_NUM_THREADS=str(max(1, int(n))))


# ---------------------------------------------------------------- recipes

def load_recipes(path=RECIPES):
    """recipes.txt (written by make_recipes.py): one row per model."""
    rows = []
    with open(path) as f:
        for n, line in enumerate(f, 1):
            if not line.strip() or line.startswith("#"):
                continue
            p = [x.strip() for x in line.rstrip("\n").split(" | ")]
            if len(p) != 11:
                sys.exit(f"{path}:{n}: want 11 fields separated by ' | ', got {len(p)}")
            model, recipe, arch, kind, seed, tb, sb, targs, sargs, sources, heldout = p
            rows.append(dict(model=model, recipe=recipe, archetype=arch, kind=kind, seed=seed,
                             train_binary=os.path.join(REPO, tb), selfplay_binary=os.path.join(REPO, sb),
                             train_args=[] if targs == "-" else shlex.split(targs), selfplay_args=shlex.split(sargs),
                             sources=sources.split(), heldout=None if heldout == "-" else heldout))
    return rows


def load_costs(path=COSTS):
    costs = {}
    for r in read_csv(path):
        costs[r["signature"]] = float(r["cpu_per_game"])  # the last measurement of a signature wins
    return costs


def round_size(anchor, costs, depth):
    """Self-play games per round at a training depth (the live league's rule): a round costs about what a round of
    `anchor` games costs at depth 0, from LR's costs with jitter10; never more than `anchor`."""
    if depth == 0:
        return anchor
    c0, cd = costs.get("lr d0 jitter10"), costs.get(f"lr d{depth} jitter10")
    if not c0 or not cd:
        return anchor
    return min(anchor, max(10, int(round(anchor * c0 / cd / 10.0)) * 10))


# ---------------------------------------------------------------- names

def entry_name(line, v, ply, frozen=False):
    return f"{line}@{v}{'F' if frozen else ''}-{ply}"


def parse_entry(name):
    m = ENTRY_RE.match(name)
    return (m["line"], int(m["v"]), m["f"] == "F", int(m["ply"])) if m else None


def is_model_ply2(name):
    """A model (not a random reference) playing at ply 2."""
    return is_model_at(name, 2)


def is_model_at(name, ply):
    """A model (not a random reference) playing at the given ply."""
    p = parse_entry(name)
    return p is not None and p[3] == ply


def qualifies(white, black, ply=2):
    """The training rule: a game counts if at least one side is a model at the league's entry ply (ply 2 unless the
    config's entry_ply says otherwise; random-2 doesn't count)."""
    return is_model_at(white, ply) or is_model_at(black, ply)


def entry_ply(cfg):
    """The ply of a league's main entries (each line's current version and its champion; the champion test, the
    plateau rule and the training rule are at it): config entry_ply (2026-11-10 ~22:30), 2 when absent (every league
    made before)."""
    return cfg.get("entry_ply", 2)


def major_of(crowned, v):
    """A version's major: the champions crowned up to it, the first (untrained) one not counted."""
    return sum(1 for c in crowned[1:] if c <= v)


def version_name(prefix, crowned, v, frozen=False):
    return f"{prefix}.{major_of(crowned, v)}.{v}{'F' if frozen else ''}"


def entry_class(name):
    if name in REFERENCE_PLY:
        return ("r", REFERENCE_PLY[name])
    p = parse_entry(name)
    return ("m", p[3]) if p else ("?", 0)


def option_prefix(kind, option):
    """Version names: the global league's are G.<major>.<v>[F]; an experiment line's E.<S|L|G>.<major>.<v>."""
    return "G" if kind == "global" else f"E.{OPTION_LETTER[option]}"


# ---------------------------------------------------------------- prices: CPU from a fixed formula

def price_key(context, kind, depth):
    return f"{context} {kind} {int(depth)}"


def prices_from_rows(rows):
    """{price_key: (us_per_game, us_per_ply)} of prices.csv rows."""
    return {price_key(r["context"], r["kind"], r["depth"]): (float(r.get("us_per_game") or 0.0),
                                                             float(r["us_per_ply"])) for r in rows}


def read_prices(path=PRICES):
    """{version: {price_key: (us_per_game, us_per_ply)}} of prices.csv, and the versions in file order."""
    table, order = {}, []
    if os.path.exists(path):
        for r in read_csv(path):
            v = r["version"]
            if v not in table:
                table[v] = {}
                order.append(v)
            table[v].update(prices_from_rows([r]))
    return table, order


def config_prices(version, us):
    """A config's `prices`: {version, us_per_game: {key: us}, us_per_ply: {key: us}}."""
    keys = sorted(us)
    return dict(version=version, us_per_game={k: us[k][0] for k in keys}, us_per_ply={k: us[k][1] for k in keys})


def prices_of_config(pr):
    """{price_key: (us_per_game, us_per_ply)} of a config's `prices`."""
    return {k: (pr.get("us_per_game", {}).get(k, 0.0), c) for k, c in pr["us_per_ply"].items()}


def load_prices(version=None, path=PRICES):
    """(version, {price_key: (us_per_game, us_per_ply)}): the given version of prices.csv, or its last one."""
    table, order = read_prices(path)
    if not order:
        sys.exit(f"{path}: no prices yet (leagues.py prices SPEC.json writes a version)")
    v = version or order[-1]
    if v not in table:
        sys.exit(f"{path}: no prices version {v} (there are {', '.join(order)})")
    return v, table[v]


def moves_of(plies):
    """(white's moves, black's moves) in a game of `plies` plies (white moves first)."""
    p = int(plies)
    return (p + 1) // 2, p // 2


def side_price(us, context, side, moves):
    """One side's price in s: its us_per_game plus its moves times its us_per_ply. side: (kind, depth)."""
    a, c = us[price_key(context, *side)]
    return (a + moves * c) / 1e6


def game_price(us, white, black, plies):
    """A tournament game's price in s: the sum of its sides' prices. white, black: (kind, depth)."""
    mw, mb = moves_of(plies)
    return side_price(us, "tournament", white, mw) + side_price(us, "tournament", black, mb)


def selfplay_round_price(us, kind, depth, games, plies):
    """A self-play round's price in s: both sides of each of its games are the line's model at its self-play depth,
    so 2 x games x us_per_game plus plies x us_per_ply."""
    a, c = us[price_key("self-play", kind, depth)]
    return (2 * int(games) * a + int(plies) * c) / 1e6


def side_of(name, kinds):
    """(kind, depth) of a tournament player: a reference is kind `random` at its ply, an entry its line's kind at the
    entry's ply. kinds: {line: kind}."""
    if name in REFERENCE_PLY:
        return "random", REFERENCE_PLY[name]
    p = parse_entry(name)
    if p is None or p[0] not in kinds:
        raise KeyError(f"no kind known for player {name}")
    return kinds[p[0]], p[3]


def pricer(us, kinds):
    """price(white, black, plies) for a league's tournament games."""
    return lambda white, black, plies: game_price(us, side_of(white, kinds), side_of(black, kinds), plies)


def selfplay_depth(lc):
    return int(dict(parse_flags(lc["selfplay_args"] or [])).get("--depth", 0))


def needed_prices(cfg):
    """The price keys a league's games need: references at their plies, every line's kind at plies 1 and 2, and each
    self-play line's kind at its self-play depth."""
    need = {price_key("tournament", "random", REFERENCE_PLY[r]) for r in cfg["references"]}
    for lc in cfg["lines"]:
        need |= {price_key("tournament", lc["kind"], d) for d in (1, 2)}
        if lc["option"] == "self-play":
            need.add(price_key("self-play", lc["kind"], selfplay_depth(lc)))
    return need


def check_prices(cfg):
    missing = sorted(needed_prices(cfg) - set(cfg["prices"]["us_per_ply"]))
    if missing:
        sys.exit(f"prices version {cfg['prices']['version']} has no price for: {', '.join(missing)}")


# ---------------------------------------------------------------- the rules (pure; the selftest checks them)

def champion_decision(elo_cur, elo_champ, se, k):
    """(decision, diff, z) of the champion test: the current version replaces the champion if its ply-2 rating leads
    the champion's by at least k standard errors of the difference."""
    if elo_cur is None or elo_champ is None or se is None or not se > 0:
        return "unrated", None, None
    diff = elo_cur - elo_champ
    z = diff / se
    return ("new-champion" if z >= k else "champion-kept"), diff, z


def anchor_update(anchors, current1, anchor_ratings, cycle, rules, used_entries=()):
    """The global league's anchors after a cycle.
    anchors: {"<lo>": record} (a copy is changed and returned); current1: [(entry, line, version, elo)] of this cycle's
    rated current ply-1 entries; anchor_ratings: {anchor entry: (elo, ci95) or None}; rules: step, margin,
    out_cycles, lowest. used_entries: anchor entries ever made (a version anchors once).
    1. An anchor more than `margin` outside its interval [lo, lo+step) for `out_cycles` straight cycles gives the
       interval up (available); it stays in the field until replaced. An unrated cycle leaves the streak as it is.
    2. An interval from `lowest` up that is empty or given up goes to the current ply-1 entry that lands in it with
       the highest rating; it gets a frozen copy (<line>@<v>F-1), rated from the next cycle. A replaced anchor leaves
       the field now. An entry fills only the interval it lands in.
    Returns (anchors, events, leaving): events [(event, lo, record)], leaving the replaced anchor entries."""
    anchors = copy.deepcopy(anchors)
    step, margin, out_cycles = rules["step"], rules["margin"], rules["out_cycles"]
    lowest = rules.get("lowest", step)
    events, leaving = [], []
    for lo in sorted(anchors, key=int):
        a = anchors[lo]
        r = anchor_ratings.get(a["entry"])
        if r is None:
            continue
        a["elo"], a["ci95"] = r[0], r[1]
        if a["available"]:
            continue
        lo_v = int(lo)
        outside = r[0] < lo_v - margin or r[0] > lo_v + step + margin
        a["outside_streak"] = a["outside_streak"] + 1 if outside else 0
        if a["outside_streak"] >= out_cycles:
            a["available"] = True
            events.append(("anchor-available", lo_v, dict(a)))
    claims = {}
    used = set(used_entries) | {a["entry"] for a in anchors.values()}
    for entry, line, v, elo in sorted(current1, key=lambda x: (-x[3], x[0])):
        if elo is None:
            continue
        lo = int(math.floor(elo / step)) * step
        if lo < lowest or str(lo) in claims or entry_name(line, v, 1, frozen=True) in used:
            continue
        held = anchors.get(str(lo))
        if held and not held["available"]:
            continue
        claims[str(lo)] = (entry, line, v, elo)
    for lo in sorted(claims, key=int):
        entry, line, v, elo = claims[lo]
        old = anchors.get(lo)
        if old:
            leaving.append(old["entry"])
            events.append(("anchor-replaced", int(lo), dict(old)))
        rec = dict(entry=entry_name(line, v, 1, frozen=True), line=line, version=v, source=entry, locked_cycle=cycle,
                   locked_elo=elo, outside_streak=0, available=False, elo=None, ci95=None)
        anchors[lo] = rec
        events.append(("anchor-locked", int(lo), dict(rec)))
    return anchors, events, leaving


def plan_copy(batch, used, est, min_rounds, carry=0.0):
    """Which global rounds an experiment copies this cycle, and how many rounds it plays.
    batch: the global batch ({"cycle", "rounds": [{t, ply2_price_s, ...}]}, priced by the experiment) or None; used:
    {(global cycle, t)}; est: the estimated qualifying price of one experiment round; carry: the priced s by which
    the global lines' data led the local lines' in earlier cycles (negative: trailed).
    The local lines should get this cycle's copied data plus the carry, in at least min_rounds rounds: copy the
    fewest newest unused full rounds (at least one) whose qualifying price covers min_rounds x est - carry; play
    round((copied + carry) / est) rounds, at least min_rounds (at least 1 if the carry leaves less). A batch too
    small to cover that is taken whole if none of it was used (the experiment plays the rounds it covers, at least
    1); if part of it was used, the experiment waits for the next.
    Returns None (wait) or (chosen rounds, rounds to play, copied qualifying price)."""
    if not batch or not batch.get("rounds"):
        return None
    c = batch["cycle"]
    unused = [r for r in batch["rounds"] if (c, r["t"]) not in used]
    if not unused:
        return None
    need = min_rounds * est - carry
    chosen, total = [], 0.0
    for r in sorted(unused, key=lambda r: -r["t"]):
        chosen.append(r)
        total += r["ply2_price_s"]
        if total >= need:
            break
    covered = total >= need
    if not covered and len(unused) < len(batch["rounds"]):
        return None
    n = max(1, int((total + carry) / est + 0.5)) if est > 0 else min_rounds
    if covered:
        n = max(n, min_rounds)
    return sorted(chosen, key=lambda r: r["t"]), n, total


def class_moves(rows):
    """Mean moves of white and black by the pair of classes (model or random, ply) of white and black in game rows
    (with plies); and the mean over all of them (for a pair of classes not seen)."""
    sums, tot = {}, [0, 0, 0]
    for r in rows:
        mw, mb = moves_of(r["plies"])
        s = sums.setdefault((entry_class(r["white"]), entry_class(r["black"])), [0, 0, 0])
        for x in (s, tot):
            x[0] += mw
            x[1] += mb
            x[2] += 1
    means = {k: (s[0] / s[2], s[1] / s[2]) for k, s in sums.items()}
    return means, ((tot[0] / tot[2], tot[1] / tot[2]) if tot[2] else (40.0, 40.0))


def estimate_round_ply2_price(names, sides, us, moves, fallback, ply=2):
    """One double round-robin's qualifying price for a field of entry names: each ordered qualifying pair priced at
    its classes' mean moves. sides: {name: (kind, depth)}; ply: the league's entry ply (the training rule's)."""
    total = 0.0
    for a in names:
        for b in names:
            if a != b and qualifies(a, b, ply):
                mw, mb = moves.get((entry_class(a), entry_class(b)), fallback)
                total += side_price(us, "tournament", sides[a], mw) + side_price(us, "tournament", sides[b], mb)
    return total


def estimate_self_games_price(names, sides, us, moves, fallback, ply=2):
    """One round's self-games' price (a league with self_games): each entry whose game against itself qualifies,
    priced at the mean moves of its class against itself."""
    total = 0.0
    for a in names:
        if qualifies(a, a, ply):
            mw, mb = moves.get((entry_class(a), entry_class(a)), fallback)
            total += side_price(us, "tournament", sides[a], mw) + side_price(us, "tournament", sides[a], mb)
    return total


def selfplay_plan(budget, used, round_price, chunk_share):
    """The next self-play chunk's rounds: rounds left = int((budget - used) / round_price + 0.5), in chunks of about
    chunk_share of the budget (at least 1 round); one round while no round's price is known. 0: stop. All in priced
    s, so the plan replays exactly."""
    if not round_price:
        return 1 if used < budget or used == 0 else 0
    left = int((budget - used) / round_price + 0.5)
    if left <= 0:
        return 0
    return min(left, max(1, int(chunk_share * budget / round_price + 0.5)))


# ---------------------------------------------------------------- ratings and the champion test's SE

def read_ratings(tour):
    out = {}
    for r in read_csv(os.path.join(tour, "ratings.csv")):
        try:
            out[r["player"]] = (float(r["elo"]), float(r["ci95"]), int(r["games"]))
        except (ValueError, KeyError):
            continue
    return out


def league_ratings(L):
    """A league's tournament ratings (read_ratings). With a rating zero (config rating_zero: an experiment without
    the random reference) they are re-centred on it, so it rates 0; while it is unrated they stay as the tournament
    gives them (relative to the rated players' mean)."""
    ratings = read_ratings(L.p("tour"))
    z = L.cfg.get("rating_zero")
    if z and z in ratings:
        z0 = ratings[z][0]
        ratings = {k: (e - z0, ci, g) for k, (e, ci, g) in ratings.items()}
    return ratings


def fit_pin(L, ratings):
    """The player contrast_ses pins: the tournament's anchor (random), or with a rating zero that entry, or while it
    is unrated the first rated player by name (a contrast's SE is the same whichever rated player is pinned)."""
    z = L.cfg.get("rating_zero")
    if not z:
        return ANCHOR
    return z if z in ratings or not ratings else min(ratings)


def contrast_ses(tour, ratings, pairs, anchor=ANCHOR):
    """Copied from cycles/champ/cycle.py (contrast_ses): each pair's standard error from the fit's covariance (the
    inverse of its information matrix at its ratings, from every game in games.csv between rated players, retired ones
    included, the anchor pinned), eliminating the players in no pair from the sparse matrix first and factoring the
    small dense rest. pairs: [(players a, players b)], each the mean rating of a minus that of b. Returns the list of
    standard errors, or None if the matrix is not positive definite."""
    w2 = (math.log(10) / 400) ** 2
    count = _pair_counts_fast(tour, ratings)
    if count is None:
        count = {}
        with open(os.path.join(tour, "games.csv")) as f:
            next(f, None)
            for line in f:
                _, white, black, _ = line.split(",", 3)
                if white != black and white in ratings and black in ratings:
                    key = (white, black) if white < black else (black, white)
                    count[key] = count.get(key, 0) + 1
    a_ = {}
    for (a, b), n in count.items():
        p = 1 / (1 + 10 ** (-(ratings[a][0] - ratings[b][0]) / 400))
        w = n * p * (1 - p) * w2
        for x in (a, b):
            if x != anchor:
                row = a_.setdefault(x, {})
                row[x] = row.get(x, 0.0) + w
        if a != anchor and b != anchor:
            a_[a][b] = a_[a].get(b, 0.0) - w
            a_[b][a] = a_[b].get(a, 0.0) - w
    keep = sorted({x for a, b in pairs for x in list(a) + list(b) if x in a_})
    kept = set(keep)
    for x in sorted((x for x in a_ if x not in kept), key=lambda x: (len(a_[x]), x)):
        row = a_.pop(x)
        d = row.pop(x)
        if not d > 0:
            return None
        nb = list(row.items())
        for u, a_ux in nb:
            ru = a_[u]
            del ru[x]
            f = a_ux / d
            for v, a_xv in nb:
                ru[v] = ru.get(v, 0.0) - f * a_xv
    k = len(keep)
    lower = [[a_[p].get(q, 0.0) for q in keep] for p in keep]
    for j in range(k):
        row_j = lower[j]
        d = row_j[j] - sum(v * v for v in row_j[:j])
        if not d > 0:
            return None
        row_j[j] = d = math.sqrt(d)
        for i in range(j + 1, k):
            row_i = lower[i]
            row_i[j] = (row_i[j] - sum(x * y for x, y in zip(row_i[:j], row_j[:j]))) / d
    index = {p: i for i, p in enumerate(keep)}
    out = []
    for a, b in pairs:
        e = [0.0] * k
        for names, sign in ((a, 1.0), (b, -1.0)):
            for n in names:
                if n in index:
                    e[index[n]] += sign / len(names)
        y = []
        for i, row in enumerate(lower):
            y.append((e[i] - sum(x * v for x, v in zip(row[:i], y))) / row[i])
        out.append(math.sqrt(sum(v * v for v in y)))
    return out


# ---------------------------------------------------------------- leagues: creation

def deep_merge(base, over):
    out = copy.deepcopy(base)
    for k, v in over.items():
        if isinstance(v, dict) and isinstance(out.get(k), dict):
            out[k] = deep_merge(out[k], v)
        else:
            out[k] = copy.deepcopy(v)
    return out


def league_dir_of(root, kind, name):
    return os.path.join(root, "global") if kind == "global" else os.path.join(root, "experiments", name)


def global_line(row, entered):
    return dict(line=row["recipe"], model=row["recipe"], recipe=row["recipe"], option="league", kind=row["kind"],
                archetype=row["archetype"], train_binary=row["train_binary"], train_args=row["train_args"],
                selfplay_binary=None, selfplay_args=None, heldout=row["heldout"], entered_cycle=entered)


def recipe_rows(recipes, names):
    by_recipe = {}
    for r in recipes:
        by_recipe.setdefault(r["recipe"], r)
    out = []
    for m in names:
        if m not in by_recipe:
            hint = [r["recipe"] for r in recipes if r["model"] == m]
            sys.exit(f"{m}: not a recipe in {RECIPES}" + (f" (it is a model of recipe {hint[0]})" if hint else ""))
        out.append(by_recipe[m])
    return out


# ---------------------------------------------------------------- experiment models: variants, sweeps, replicates

ID_RE = re.compile(r"[A-Za-z0-9][A-Za-z0-9_.+=#-]*")
REPLICATE_SEED_STEP = 100003  # a replicate's training seeds are this far apart, so they never meet over cycles
INIT_SEED_FLAGS = {"--moe-seed": {"moe", "moenb", "nbgate", "hybrid"}, "--fm-seed": {"fm"}}
HELP_CACHE = {}


def binary_flags(binary, sub):
    """({flags}, {flag: default}) a binary's subcommand accepts, from its --help."""
    key = (binary, sub)
    if key not in HELP_CACHE:
        r = subprocess.run([binary, sub, "--help"], capture_output=True, text=True)
        flags, defaults, last = set(), {}, None
        for line in r.stdout.splitlines():
            m = re.match(r"^\s+(?:-\w, )?(--[a-z0-9][a-z0-9-]*)", line)
            if m:
                last = m.group(1)
                flags.add(last)
                continue
            d = re.search(r"\[default: ([^\]]+)\]", line)
            if d and last:
                defaults.setdefault(last, d.group(1))
        if r.returncode != 0 or not flags:
            sys.exit(f"{binary} {sub} --help gave no flags (exit {r.returncode})")
        HELP_CACHE[key] = (flags, defaults)
    return HELP_CACHE[key]


def apply_overrides(args, overrides):
    """args with each (flag, value) of overrides in effect: value True is a bare flag, None removes the flag, else
    the flag takes the value (where it was, or appended)."""
    ov = dict(overrides)
    out, seen = [], set()
    for flag, val in parse_flags(args):
        if flag in ov:
            if flag in seen:
                continue
            seen.add(flag)
            val = ov[flag]
            if val is None:
                continue
        out.append((flag, val))
    for flag, val in overrides:
        if flag not in seen and val is not None:
            out.append((flag, val))
            seen.add(flag)
    flat = []
    for flag, val in out:
        flat += [flag] if val is True else [flag, str(val)]
    return flat


def override_value(v):
    """A spec value as an argument: true is a bare flag, null (or false) removes the flag, numbers as written."""
    if v is True or v is None:
        return v
    if v is False:
        return None
    if isinstance(v, float):
        return repr(v)
    return str(v)


def override_token(flag, v, sep="="):
    name = flag.lstrip("-")
    return name if v is True else f"{name}{sep}off" if v is None else f"{name}{sep}{v}"


def expand_models(items, recipes, options):
    """An experiment spec's models as model variants, in spec order. An item is a model name (recipes.txt's model
    column) or {"model": NAME, "set": {flag: value}, "sweep": {flag: [values]} (one flag, or two for a grid),
    "to": "auto" | "train" | "selfplay" | "both" or {flag: one of these}, "replicates": N}. "auto" (the default)
    applies a flag to each argument list whose binary accepts it; every flag must be accepted where it goes. Returns
    [dict(id, label, row, train_overrides, selfplay_overrides, replicate, seed_offset)]."""
    by_model = {r["model"]: r for r in recipes}
    out = []
    for item in items:
        item = {"model": item} if isinstance(item, str) else dict(item)
        unknown = set(item) - {"model", "set", "sweep", "to", "replicates"}
        if unknown:
            sys.exit(f"spec: unknown model keys {sorted(unknown)}")
        m = item.get("model")
        if m not in by_model:
            sys.exit(f"{m}: not a model in {RECIPES}")
        row = by_model[m]
        fixed = [(f, override_value(v)) for f, v in (item.get("set") or {}).items()]
        sweep = list((item.get("sweep") or {}).items())
        if len(sweep) > 2:
            sys.exit(f"spec: {m}: sweep one flag, or two for a grid")
        for f, vals in sweep:
            if not isinstance(vals, list) or not vals:
                sys.exit(f"spec: {m}: sweep {f} needs a list of values")
            if f in dict(fixed):
                sys.exit(f"spec: {m}: {f} is both set and swept")
        combos = [[]]
        for f, vals in sweep:
            combos = [c + [(f, override_value(v))] for c in combos for v in vals]
        to = item.get("to", "auto")
        reps = item.get("replicates", 1)
        if not isinstance(reps, int) or isinstance(reps, bool) or reps < 1:
            sys.exit(f"spec: {m}: replicates must be a whole number from 1")
        uses_sp = "self-play" in options
        uses_train = bool(set(options) & {"local", "global"})  # train also makes every line's version 0
        for combo in combos:
            overrides = fixed + combo
            for f, v in overrides:
                if not re.fullmatch(r"--[a-z0-9][a-z0-9-]*", f):
                    sys.exit(f"spec: {m}: {f!r} is not a flag")
                if f in ("--seed", "--model", "--rounds", "--games", "--threads", "--resume", "--start", "--init"):
                    sys.exit(f"spec: {m}: {f} is the driver's to set")
                if v not in (True, None) and not re.fullmatch(r"[A-Za-z0-9_.+-]+", v):
                    sys.exit(f"spec: {m}: value {v!r} of {f} can't go into a name (letters, digits, _ . + - only)")
            tr_ov, sp_ov = [], []
            for f, v in overrides:
                t = to.get(f, "auto") if isinstance(to, dict) else to
                if t not in ("auto", "train", "selfplay", "both"):
                    sys.exit(f"spec: {m}: to must be auto, train, selfplay or both")
                tr_ok = f in binary_flags(row["train_binary"], "train")[0]
                sp_ok = f in binary_flags(row["selfplay_binary"], "self-play")[0]
                want_sp = t in ("selfplay", "both") or (t == "auto" and sp_ok and uses_sp)
                want_tr = t in ("train", "both") or (t == "auto" and tr_ok and (uses_train or want_sp))
                if want_tr and not tr_ok:
                    sys.exit(f"spec: {m}: {os.path.basename(row['train_binary'])} train doesn't accept {f}")
                if want_sp and not sp_ok:
                    sys.exit(f"spec: {m}: {os.path.basename(row['selfplay_binary'])} self-play doesn't accept {f}")
                if want_sp and not uses_sp:
                    sys.exit(f"spec: {m}: {f} is for self-play, and this experiment has no self-play lines")
                if want_tr and not want_sp and not uses_train:
                    sys.exit(f"spec: {m}: {f} would change only the untrained version 0 (no local or global lines, "
                             f"and the self-play binary doesn't take it)")
                if not want_tr and not want_sp:
                    sys.exit(f"spec: {m}: no binary of this experiment's lines accepts {f}")
                if want_tr:
                    tr_ov.append((f, v))
                if want_sp:
                    sp_ov.append((f, v))
            base_id = m + "".join("+" + override_token(f, v) for f, v in overrides)
            base_label = " ".join([m] + [override_token(f, v) for f, v in overrides])
            for r in range(1, reps + 1):
                vid = base_id + (f"#{r}" if reps > 1 else "")
                if not ID_RE.fullmatch(vid):
                    sys.exit(f"spec: model id {vid!r} has characters a line name can't have")
                out.append(dict(id=vid, label=base_label + (f" #{r}" if reps > 1 else ""), row=row,
                                train_overrides=tr_ov, selfplay_overrides=sp_ov, replicate=r, seed_offset=r - 1))
    ids = [x["id"] for x in out]
    dup = sorted({i for i in ids if ids.count(i) > 1})
    if dup:
        sys.exit(f"spec: models given twice: {', '.join(dup)}")
    return out


def seeded_args(args, binary, sub, kind, offset):
    """A replicate's arguments: its self-play --seed and its model's initial-weight seeds (--moe-seed, --fm-seed,
    for the kinds that use them) moved by its seed offset; unchanged at offset 0."""
    if not offset:
        return list(args)
    flags = dict(parse_flags(args))
    defaults = binary_flags(binary, sub)[1]
    ov = []
    if sub == "self-play":
        if "--seed" not in flags:
            sys.exit(f"{binary}: self-play args without --seed can't be replicated")
        ov.append(("--seed", str(int(flags["--seed"]) + offset)))
    for f, kinds in INIT_SEED_FLAGS.items():
        if kind in kinds:
            base = flags.get(f, defaults.get(f))
            if base is None:
                sys.exit(f"{binary} {sub}: no default for {f}")
            ov.append((f, str(int(base) + offset)))
    return apply_overrides(args, ov)


def experiment_line(v, option):
    row = v["row"]
    tr_args = seeded_args(apply_overrides(row["train_args"], v["train_overrides"]), row["train_binary"], "train",
                          row["kind"], v["seed_offset"])
    sp = option == "self-play"
    sp_args = (seeded_args(apply_overrides(row["selfplay_args"], v["selfplay_overrides"]), row["selfplay_binary"],
                           "self-play", row["kind"], v["seed_offset"]) if sp else None)
    return dict(line=f"{v['id']}.{SUFFIX[option]}", model=v["id"], label=v["label"], base_model=row["model"],
                recipe=row["recipe"], option=option, kind=row["kind"], archetype=row["archetype"],
                train_binary=row["train_binary"], train_args=tr_args,
                selfplay_binary=row["selfplay_binary"] if sp else None, selfplay_args=sp_args,
                heldout=row["heldout"], entered_cycle=1,
                train_overrides=[list(x) for x in v["train_overrides"]],
                selfplay_overrides=[list(x) for x in v["selfplay_overrides"]] if sp else [],
                replicate=v["replicate"], seed_offset=v["seed_offset"])


def make_config(spec):
    """A league's config.json from a spec: {"kind": "global" or "experiment", "root": DIR, "name": NAME (experiments),
    "models": [...], "options": [...] (experiments: self-play, local, global), "cycles": N (experiments),
    "global_source": DIR (experiments with the global option; default ROOT/global), "prices_version": V (default:
    prices.csv's last), "selfplay_budget_s": S (self-play-only experiments: priced CPU s per line per cycle, default
    120; refused for other leagues)}, plus any key of DEFAULTS to override (nested keys merge). The global league's
    models are recipes (recipes.txt's recipe column); an experiment's are models (its model column), each run under
    every chosen option. The prices version's constants are copied into the config: the league keeps them."""
    kind = spec.get("kind")
    if kind not in ("global", "experiment"):
        sys.exit("spec: kind must be global or experiment")
    root = os.path.abspath(spec["root"])
    name = "global" if kind == "global" else spec.get("name", "")
    if not NAME_RE.fullmatch(name):
        sys.exit(f"spec: bad name {name!r}")
    models = list(spec.get("models") or [])
    if not models:
        sys.exit("spec: give models")
    if kind == "global" and (len({json.dumps(m) for m in models}) != len(models)
                             or not all(isinstance(m, str) for m in models)):
        sys.exit("spec: the global league's models are recipe names, each once")
    cfg = deep_merge(DEFAULTS, {k: v for k, v in spec.items() if k in DEFAULTS})
    cfg = dict(name=name, kind=kind, created=now(), root=root, **cfg)
    recipes = load_recipes()
    lines = []
    if kind == "global":
        for row in recipe_rows(recipes, models):
            lines.append(global_line(row, 1))
        cfg["cycles"] = None
        cfg["global_source"] = None
    else:
        options = list(spec.get("options") or [])
        if not options or set(options) - set(OPTION_ORDER) or len(set(options)) != len(options):
            sys.exit(f"spec: options must be some of {', '.join(OPTION_ORDER)}, each once")
        if not isinstance(cfg.get("cycles"), int) or cfg["cycles"] < 1:
            sys.exit("spec: an experiment needs cycles (a number from 1)")
        for v in expand_models(models, recipes, options):
            for o in OPTION_ORDER:
                if o in options:
                    lines.append(experiment_line(v, o))
        cfg["patience_cycles"] = None
        cfg["anchors"] = None
        if "global" in options:
            src = os.path.abspath(spec.get("global_source") or os.path.join(root, "global"))
            g = read_json(os.path.join(src, "config.json"))
            if not g or g.get("kind") != "global":
                sys.exit(f"{src}: no global league there (config.json of kind global)")
            cfg["global_source"] = src
        else:
            cfg["global_source"] = None
    entry_ply_option(spec, cfg, lines)
    costs = load_costs()
    for lc in lines:
        if lc["option"] == "self-play":  # games per round, fixed here so a replay plays the same rounds
            lc["selfplay_games"] = round_size(cfg["selfplay"]["round_anchor_games"], costs, selfplay_depth(lc))
    cfg["lines"] = lines
    sp_only = kind == "experiment" and set(spec.get("options") or []) == {"self-play"}
    if sp_only:
        b = spec.get("selfplay_budget_s", SELFPLAY_BUDGET_DEFAULT)
        if not isinstance(b, (int, float)) or isinstance(b, bool) or not b > 0:
            sys.exit("spec: selfplay_budget_s must be a positive number of priced CPU s")
        cfg["selfplay_budget_s"] = float(b)
    else:
        if spec.get("selfplay_budget_s") is not None:
            sys.exit("spec: selfplay_budget_s is for self-play-only experiments; with local or global lines the "
                     "self-play budget is the price of the cycle's local data")
        cfg["selfplay_budget_s"] = None
    version, us = load_prices(spec.get("prices_version"))
    cfg["prices"] = config_prices(version, us)
    batch4_options(spec, cfg)
    check_prices(cfg)
    check_binaries(cfg)
    self_games_option(spec, cfg)
    return league_dir_of(root, kind, name), cfg


def is_count(x, lowest):
    return isinstance(x, int) and not isinstance(x, bool) and x >= lowest


def entry_ply_option(spec, cfg, lines):
    """"entry_ply": P (added 2026-11-10 ~22:30; the user: experiments screen at ply 1, winners are upgraded to ply 2
    later), kept out of DEFAULTS so that a spec without it gives the same config.json and the same league as before,
    at ply 2. Each line's current version and its champion play at ply P (entries <line>@<v>-P); the rating zero, the
    champion test, the plateau rule and the training rule (a game counts if a model at ply P plays in it) are at P.
    Experiments only: the global league's entries and anchors are at plies 1 and 2. With P 1 there are no other
    ply-1 entries (ply1_entries false, set when the spec doesn't say; true is refused) and no global option (it copies
    the global league's games with a model at ply 2). A self-play line whose depth neither the spec nor its recipe
    sets (the binary's default, 0) self-plays at depth P, the depth the tournament gives a ply-P entry (create sets
    it; lines.csv and the line's selfplay_args show it, and selfplay_depth_default records it); a --depth the spec or
    the recipe sets stays (F-L-d2jit self-plays at depth 2 whatever the entry ply)."""
    if "entry_ply" not in spec:
        return
    p = spec["entry_ply"]
    if isinstance(p, bool) or p not in (1, 2):
        sys.exit("spec: entry_ply must be 1 or 2")
    if cfg["kind"] != "experiment":
        sys.exit("spec: entry_ply is for experiments (the global league's entries and anchors are at plies 1 and 2)")
    if p != 2:
        if spec.get("ply1_entries"):
            sys.exit(f"spec: with entry_ply {p} the main entries are at ply {p}: ply1_entries must be false")
        if any(lc["option"] == "global" for lc in lines):
            sys.exit("spec: the global option trains on the global league's games with a model at ply 2; it needs "
                     "entry_ply 2")
        cfg["ply1_entries"] = False
    for lc in lines:
        if (lc["option"] == "self-play" and not any(f == "--depth" for f, _ in lc["selfplay_overrides"])
                and "--depth" not in dict(parse_flags(lc["selfplay_args"])) and selfplay_depth(lc) != p):
            lc["selfplay_args"] = apply_overrides(lc["selfplay_args"], [("--depth", str(p))])
            lc["selfplay_depth_default"] = p
    cfg["entry_ply"] = p
    cfg["train"] = dict(cfg["train"], qualify=f"a model at ply {p}")


def scaled_plateau_cycles(k2, lines):
    """A scaled plateau's K: round(k2 x sqrt(2 / lines)), at least 1 (k2 is K for 2 lines; halves rounded up). The
    user's rule of 2026-11-10 ~22:15: with more lines some line crowns more often by chance, so the wait is shorter."""
    return max(1, int(math.floor(k2 * math.sqrt(2.0 / lines) + 0.5)))


def batch4_options(spec, cfg):
    """The experiment options added on 2026-11-10 (batch 4), kept out of DEFAULTS so that a spec without them gives
    the same config.json and the same league as before:
    - "ply1_entries": false: no current@1 entries (a line's entries are its current version and its champion at ply
      2, one entry when they are the same version);
    - "plateau": {"cycles": K, "min_cycles": M}: the experiment ends after the first cycle from M on in which no line
      has crowned a champion for K cycles; "cycles" stays the cap;
    - "plateau": {"scaled": true or {"k2": K2}, "min_cycles": M} (added 2026-11-10 ~22:15): the same rule with K
      computed here from the number of lines n, K = round(K2 x sqrt(2 / n)) (K2 default 50); config.json keeps K as
      plateau.cycles and the inputs as plateau.scaled {"k2", "lines"}, so the driver runs the same rule;
    - references without "random" (the tournament's anchor): config.json gets "rating_zero", the first line's version
      0 at ply 2 (in every experiment's first field). The tournament then runs without --anchor (ratings relative to
      the rated players' mean), and the driver re-centres the ratings on rating_zero and pins it in the champion
      test's SE (a contrast's SE doesn't depend on which rated player is pinned).
    Experiments only: the global league keeps its references and ply-1 entries (its anchors are ply-1 entries rated
    from random's 0) and has patience instead of a plateau."""
    kind = cfg["kind"]
    if "ply1_entries" in spec:
        if not isinstance(spec["ply1_entries"], bool):
            sys.exit("spec: ply1_entries must be true or false")
        if kind != "experiment" and not spec["ply1_entries"]:
            sys.exit("spec: the global league's anchors are ply-1 entries: ply1_entries false is for experiments")
        cfg["ply1_entries"] = spec["ply1_entries"]
    if spec.get("plateau") is not None:
        pl = spec["plateau"]
        if kind != "experiment":
            sys.exit("spec: plateau is for experiments (the global league has patience)")
        if isinstance(pl, dict) and "scaled" in pl:
            sc = pl["scaled"]
            k2 = sc.get("k2", PLATEAU_K2_DEFAULT) if isinstance(sc, dict) else PLATEAU_K2_DEFAULT
            if (set(pl) - {"scaled", "min_cycles"}
                    or not (sc is True or (isinstance(sc, dict) and not set(sc) - {"k2"}))
                    or not isinstance(k2, (int, float)) or isinstance(k2, bool) or not 0 < k2 < float("inf")
                    or not is_count(pl.get("min_cycles", 0), 0)):
                sys.exit('spec: a scaled plateau must be {"scaled": true or {"k2": K2 (above 0; default '
                         f'{PLATEAU_K2_DEFAULT})}}, "min_cycles": M (from 0)}}')
            n = len(cfg["lines"])
            cfg["plateau"] = dict(cycles=scaled_plateau_cycles(k2, n), min_cycles=pl.get("min_cycles", 0),
                                  scaled=dict(k2=k2, lines=n))
        else:
            if (not isinstance(pl, dict) or set(pl) - {"cycles", "min_cycles"} or not is_count(pl.get("cycles"), 1)
                    or not is_count(pl.get("min_cycles", 0), 0)):
                sys.exit('spec: plateau must be {"cycles": K (from 1), "min_cycles": M (from 0)}, or {"scaled": true '
                         'or {"k2": K2}, "min_cycles": M}')
            cfg["plateau"] = dict(cycles=pl["cycles"], min_cycles=pl.get("min_cycles", 0))
    if ANCHOR not in cfg["references"]:
        if kind != "experiment":
            sys.exit(f"spec: the global league needs the {ANCHOR} reference (its anchors' Elo is relative to it)")
        cfg["rating_zero"] = entry_name(cfg["lines"][0]["line"], 0, entry_ply(cfg))


def self_games_option(spec, cfg):
    """"self_games": true (added 2026-11-10 ~22:15, the user's default for experiments with local play; the global
    league may have it too), kept out of DEFAULTS so that a spec without it gives the same config.json and the same
    league as before. Each round every entry whose game against itself is a training game (a model at the entry ply)
    plays one, in the self-games phase (phase_selfgames): training games for the local lines only. Needs a line that
    trains on the league's own games (local, or the global league's lines) and a tournament binary with
    `replay-games`, which plays them as the tournament plays its games."""
    if "self_games" not in spec:
        return
    sg = spec["self_games"]
    if not isinstance(sg, bool):
        sys.exit("spec: self_games must be true or false")
    if sg:
        if not any(lc["option"] in ("league", "local") for lc in cfg["lines"]):
            sys.exit("spec: self_games are training games for local lines, and this experiment has none")
        binary = cfg["tournament"]["binary"]
        r = subprocess.run([binary, "replay-games", "--help"], capture_output=True, text=True)
        if r.returncode != 0:
            sys.exit(f"spec: self_games need a tournament binary with replay-games; {binary} has none")
        flags, _ = binary_flags(binary, "replay-games")
        need = {"--seed", "--use-probs"} | {f for f, _ in parse_flags(cfg["tournament"].get("flags", []))
                                            if f in ("--policy", "--temperature")}
        if need - flags:
            sys.exit(f"spec: {binary} replay-games lacks {', '.join(sorted(need - flags))}")
    cfg["self_games"] = sg


def check_binaries(cfg):
    need = {cfg["tournament"]["binary"]}
    for lc in cfg["lines"]:
        need.add(lc["train_binary"])
        if lc["option"] == "self-play":
            need.add(lc["selfplay_binary"])
    missing = sorted(b for b in need if not os.access(b, os.X_OK))
    if missing:
        sys.exit("missing binaries: " + ", ".join(missing))


def new_line_state():
    return dict(status="active", version=0, major=0, champion=0, patience=0, crowned=[0], retired_cycle=None,
                sp_version=0, carry_s=0.0, sp_round_price_s=None)


def cmd_create(spec_path):
    with open(spec_path) as f:
        spec = json.load(f)
    ldir, cfg = make_config(spec)
    if os.path.exists(os.path.join(ldir, "config.json")):
        sys.exit(f"{ldir} already has a league")
    os.makedirs(ldir, exist_ok=True)
    write_json(os.path.join(ldir, "config.json"), cfg)
    state = dict(cycle=0, phase="idle", status="created", pid=None, updated=now(), current=None,
                 lines={lc["line"]: new_line_state() for lc in cfg["lines"]}, anchors={}, anchor_entries=[],
                 used_global_rounds=[], global_wait=None, last_round_ply2_cpu_s=None, global_carry_s=0.0)
    write_json(os.path.join(ldir, "state.json"), state)
    L = League(ldir)
    write_lines_csv(L)
    L.log(f"created {cfg['kind']} league {cfg['name']}: {len(cfg['lines'])} lines")
    write_index(cfg["root"])
    print(ldir)


def cmd_add(ldir, recipes_named):
    L = League(ldir)
    if L.cfg["kind"] != "global":
        sys.exit("add: global league only (an experiment's field is fixed)")
    lk = FileLock(L.p(".lock"), block=False)
    try:
        lk.__enter__()
    except OSError:
        sys.exit("add: a driver runs this league; stop it (leagues.py stop), then add")
    try:
        if L.state.get("current"):
            sys.exit("add: a cycle is under way; add between cycles")
        have = {lc["line"] for lc in L.cfg["lines"]}
        entered = L.state["cycle"] + 1
        for row in recipe_rows(load_recipes(), recipes_named):
            if row["recipe"] in have:
                sys.exit(f"{row['recipe']} is already in the league")
            lc = global_line(row, entered)
            L.cfg["lines"].append(lc)
            L.state["lines"][lc["line"]] = new_line_state()
        check_prices(L.cfg)
        check_binaries(L.cfg)
        write_json(L.p("config.json"), L.cfg)
        L.save()
        write_lines_csv(L)
        L.log(f"added {', '.join(recipes_named)}: they enter untrained in cycle {entered}")
    finally:
        lk.__exit__(None, None, None)


# ---------------------------------------------------------------- a league

class League:
    def __init__(self, path):
        self.dir = os.path.abspath(path)
        self.cfg = read_json(self.p("config.json"))
        if not self.cfg:
            sys.exit(f"{self.dir}: no config.json")
        self.state = read_json(self.p("state.json"))
        self.mutex = threading.RLock()
        self.lines = {lc["line"]: lc for lc in self.cfg["lines"]}
        pr = self.cfg.get("prices")  # None in a league made before prices: it can be read, not run
        self.us = prices_of_config(pr) if pr else None
        self.price = pricer(self.us, {lc["line"]: lc["kind"] for lc in self.cfg["lines"]}) if pr else None

    def p(self, *parts):
        return os.path.join(self.dir, *parts)

    @property
    def is_global(self):
        return self.cfg["kind"] == "global"

    def prefix_of(self, line):
        return option_prefix(self.cfg["kind"], self.lines[line]["option"])

    def nice(self):
        return ["nice", "-n", str(self.cfg["nice"])]

    def per_job_threads(self):
        return max(1, self.cfg["threads"] // max(1, self.cfg["jobs"]))

    def model_path(self, line, v):
        return self.p("runs", line, f"{self.lines[line]['kind']}{v}.model")

    def state_path(self, line, v):
        return self.p("runs", line, f"{self.lines[line]['kind']}{v}.state")

    def spec(self, line, v):
        return f"cal:{self.p('owncal', own_key(line, v))}:{self.lines[line]['kind']}:{self.model_path(line, v)}"

    def vname(self, line, v, frozen=False, crowned=None):
        crowned = crowned if crowned is not None else self.state["lines"][line]["crowned"]
        return version_name(self.prefix_of(line), crowned, v, frozen)

    def save(self, index=False):
        with self.mutex:
            self.state["updated"] = now()
            write_json(self.p("state.json"), self.state)
        if index:
            write_index(self.cfg["root"])

    def set_phase(self, phase, status="running"):
        with self.mutex:
            self.state["phase"] = phase
            self.state["status"] = status
            if self.state.get("current"):
                self.state["current"]["phase"] = phase
        self.save(index=True)

    def log(self, msg):
        line = f"{now()} {msg}"
        print(line, flush=True)
        with open(self.p("driver.log"), "a") as f:
            f.write(line + "\n")


def own_key(line, v):
    return f"{line}@{v}"


# ---------------------------------------------------------------- the index

def league_dirs(root):
    out = []
    if os.path.exists(os.path.join(root, "global", "config.json")):
        out.append(os.path.join(root, "global"))
    ex = os.path.join(root, "experiments")
    if os.path.isdir(ex):
        for n in sorted(os.listdir(ex)):
            if os.path.exists(os.path.join(ex, n, "config.json")):
                out.append(os.path.join(ex, n))
    return out


def league_summary(root, d):
    cfg = read_json(os.path.join(d, "config.json"))
    st = read_json(os.path.join(d, "state.json")) or {}
    status = st.get("status", "created")
    pid = st.get("pid")
    if status in ("running", "waiting") and not pid_alive(pid):
        status, pid = "stopped", None
    if status not in ("running", "waiting"):
        pid = None
    models, labels, options = [], [], []
    for lc in cfg.get("lines", []):
        if lc["model"] not in models:
            models.append(lc["model"])
            labels.append(lc.get("label", lc["model"]))
        if lc["option"] not in options:
            options.append(lc["option"])
    return dict(name=cfg["name"], kind=cfg["kind"], dir=os.path.relpath(d, root), status=status,
                cycle=st.get("cycle", 0), cycles_planned=cfg.get("cycles"), models=models, options=options,
                lines=len(cfg.get("lines", [])), created=cfg.get("created"), updated=st.get("updated"), pid=pid,
                phase=st.get("phase"), labels=labels, prices_version=(cfg.get("prices") or {}).get("version"),
                selfplay_budget_s=cfg.get("selfplay_budget_s"))


def write_index(root):
    os.makedirs(root, exist_ok=True)
    with FileLock(os.path.join(root, ".index.lock")):
        leagues = [league_summary(root, d) for d in league_dirs(root)]
        write_json(os.path.join(root, "index.json"), dict(updated=now(), leagues=leagues))


# ---------------------------------------------------------------- the field

def field_of(L, st, c):
    """Cycle c's field from state st, in a fixed order: the references, each active line's current version at ply 1
    (unless the config's ply1_entries is false) and at the entry ply (2 unless the config's entry_ply says otherwise)
    and its champion at the entry ply (one entry when the current version is the champion), then the anchors by
    interval. [dict(entry, ply, role, line, version, frozen, spec)]."""
    out = [dict(entry=r, ply=REFERENCE_PLY[r], role="reference", line="", version=None, frozen=False, spec="rand")
           for r in L.cfg["references"]]
    ply1 = L.cfg.get("ply1_entries", True)
    p = entry_ply(L.cfg)
    for lc in L.cfg["lines"]:
        line = lc["line"]
        ls = st["lines"][line]
        if ls["status"] != "active" or lc["entered_cycle"] > c:
            continue
        v, ch = ls["version"], ls["champion"]
        if ply1:
            out.append(dict(entry=entry_name(line, v, 1), ply=1, role="current", line=line, version=v, frozen=False,
                            spec=L.spec(line, v)))
        out.append(dict(entry=entry_name(line, v, p), ply=p, role="current+champion" if v == ch else "current",
                        line=line, version=v, frozen=False, spec=L.spec(line, v)))
        if ch != v:
            out.append(dict(entry=entry_name(line, ch, p), ply=p, role="champion", line=line, version=ch,
                            frozen=False, spec=L.spec(line, ch)))
    for lo in sorted(st["anchors"], key=int):
        a = st["anchors"][lo]
        out.append(dict(entry=a["entry"], ply=1, role="anchor", line=a["line"], version=a["version"], frozen=True,
                        spec=L.spec(a["line"], a["version"])))
    return out


def lines_in_cycle(L, st, c):
    return [lc for lc in L.cfg["lines"]
            if st["lines"][lc["line"]]["status"] == "active" and lc["entered_cycle"] <= c]


# ---------------------------------------------------------------- untrained versions and own calibration

def train_seed(L, lc, cycle):
    """`train --seed` of a line in a cycle (0: version 0): the league's train seed plus the cycle; a replicate's is
    moved by REPLICATE_SEED_STEP per seed offset."""
    return L.cfg["train"]["seed"] + cycle + REPLICATE_SEED_STEP * lc.get("seed_offset", 0)


def make_version0(train_binary, kind, train_args, seed, target, nogames, work, log, nice):
    """An untrained model: `train` on a round holding one empty game (0 positions), with the recipe's options minus
    its label flags (labelling needs positions; an untrained model doesn't depend on its labels). Returns CPU s."""
    game = os.path.join(nogames, "round0", "a~b")
    if not os.path.isdir(game):
        os.makedirs(game)
        for f in GAME_FILES:
            open(os.path.join(game, f), "w").close()
    shutil.rmtree(work, ignore_errors=True)
    cmd = nice + [train_binary, "train", nogames, work, "--model", kind, "--rounds", "1", "--seed", str(seed),
                  *without_flags(train_args, LABEL_FLAGS)]
    code, cpu, _, out = run_measured(cmd, log, "untrained version 0", env=threads_env(1))
    made = os.path.join(work, f"{kind}1.model")
    if code != 0 or not os.path.exists(made):
        raise RuntimeError(f"{target}: untrained version failed (exit {code}): {out.strip()[-300:]}")
    os.replace(made, target)
    shutil.rmtree(work, ignore_errors=True)
    return cpu


def make_untrained(L, lc):
    """Version 0 of a line (make_version0)."""
    line, kind = lc["line"], lc["kind"]
    target = L.model_path(line, 0)
    if os.path.exists(target):
        return 0.0
    os.makedirs(L.p("runs", line), exist_ok=True)
    return make_version0(lc["train_binary"], kind, lc["train_args"], train_seed(L, lc, 0), target, L.p(".nogames"),
                         L.p("runs", f".v0-{line}"), L.p("runs", line + ".log"), L.nice())


def own_done(L, line, v):
    d = L.p("owncal", own_key(line, v))
    return os.path.isdir(d) and all(os.path.exists(os.path.join(d, f)) for f in GAME_FILES)


def make_own(L, line, v, threads):
    """Version v's own calibration games (as the live league's calibration "own"): the version plays itself at ply
    calibration.depth, calibration.games games, log-odds softmax at calibration.temperature, seed calibration.seed,
    with its recipe's held-out calibration (as the live league plays them); the league spec then fits its
    calibration on them (cal:owncal/<line>@<v>:KIND:PATH). Returns the CPU s."""
    lc = L.lines[line]
    key, root = own_key(line, v), L.p("owncal")
    os.makedirs(root, exist_ok=True)
    final, tmp = os.path.join(root, key), os.path.join(root, f".tmp-{key}")
    if own_done(L, line, v):
        return 0.0
    model = L.model_path(line, v)
    o = L.cfg["calibration"]
    held = (o.get("heldout") or {}).get(lc.get("heldout")) if lc.get("heldout") else None
    play = f"cal:{held}:{lc['kind']}:{model}" if held else f"{lc['kind']}:{model}"
    write_json(os.path.join(root, key + ".json"), dict(play=play, model=model, md5=file_md5(model)))
    shutil.rmtree(tmp, ignore_errors=True)
    shutil.rmtree(final, ignore_errors=True)
    cmd = L.nice() + [L.cfg["tournament"]["binary"], "arena", play, play, "--use-probs", "--games", str(o["games"]),
                      "--a-policy", o["policy"], "--b-policy", o["policy"], "--temperature", str(o["temperature"]),
                      "--a-depth", str(o["depth"]), "--b-depth", str(o["depth"]), "--seed", str(o["seed"]),
                      "--out", tmp]
    code, cpu, _, out = run_measured(cmd, os.path.join(root, key + ".arena"), f"own games of {key}",
                                     env=threads_env(threads))
    check_interrupted()
    if code != 0 or not all(os.path.exists(os.path.join(tmp, f)) for f in GAME_FILES):
        shutil.rmtree(tmp, ignore_errors=True)
        raise RuntimeError(f"own games of {key} failed (exit {code}); see owncal/{key}.arena")
    os.rename(tmp, final)
    return cpu


def own_gc(L, keep_keys):
    """Deletes own games of versions no longer in the field (their .json and .arena records stay)."""
    root = L.p("owncal")
    if not os.path.isdir(root):
        return
    for n in sorted(os.listdir(root)):
        p = os.path.join(root, n)
        if os.path.isdir(p) and (n.startswith(".tmp-") or n not in keep_keys):
            shutil.rmtree(p, ignore_errors=True)


# ---------------------------------------------------------------- the tournament

def read_entries(path):
    out = []
    if os.path.exists(path):
        with open(path) as f:
            for line in f:
                s = line.strip()
                if s and not s.startswith("#"):
                    name, depth, sp = s.split()
                    out.append((name, int(depth), sp))
    return out


# ---------------------------------------------------------------- exact fast scans of tour/games.csv and game_cpu.csv

# done_round_robins (twice), clean_partial, game_rows and contrast_ses read tour/games.csv or tour/game_cpu.csv whole,
# every cycle, and both files grow by every cycle's games. A cache beside tour/ (scan-cache/<file>.json) summarizes a
# file's complete lines before byte L, with the original code's own expressions. It is trusted only when the file is
# unchanged since the cache was saved (same device, inode, size, mtime and ctime) or when the SHA-256 of the file's
# bytes [0, L) is the saved one; then only the lines after L, or the lines of the rounds asked for, are read, by the
# original code. Each function runs its original code instead whenever the summary can't prove the same result: no
# cache possible (not a league's tour/ file, a locale encoding other than UTF-8, a "\r" in the file, bytes that don't
# decode), lines the original code would reject, or rounds out of order in the file.

SCAN_CACHE = "scan-cache"
SCAN_VERSION = 1
_SCAN_MEMO = {}  # (path, kind) -> (entry, pairs) as last verified or saved by this process


def _scan_stat(st):
    return [st.st_dev, st.st_ino, st.st_size, st.st_mtime_ns, st.st_ctime_ns]


def _scan_cache_path(path):
    """<league>/scan-cache/<file>.json for a league's tour/<file>; None for any other path (no cache)."""
    tour = os.path.dirname(os.path.abspath(path))
    league = os.path.dirname(tour)
    if os.path.basename(tour) != "tour" or not os.path.isfile(os.path.join(league, "config.json")):
        return None
    return os.path.join(league, SCAN_CACHE, os.path.basename(path) + ".json")


def _scan_new(kind):
    s = dict(max_t=-1, last_t=None, sorted=True, starts=[])
    if kind == "games":
        s.update(t_ok=True, pairs_ok=True)
    else:
        s.update(int_ok=True, all_valid=True)
    return s


def _scan_line(kind, s, pairs, line, off):
    """Adds one complete text line (with its "\\n") at byte offset off to the summary s. games.csv: the round as
    done_round_robins reads it (game_rows' rows are the lines with 5 or more fields, the same first field) and the
    pair as contrast_ses reads it; game_cpu.csv: the rows clean_partial keeps and game_rows reads. starts: the offset
    of the first line of each round, while the rounds never go down (sorted)."""
    t = None
    if kind == "games":
        if line.strip():
            try:
                t = int(line.split(",", 1)[0])
            except ValueError:
                s["t_ok"] = False
        if s["pairs_ok"]:
            parts = line.split(",", 3)
            if len(parts) != 4:
                s["pairs_ok"] = False
            elif parts[1] != parts[2]:
                white, black = parts[1], parts[2]
                key = (white, black) if white < black else (black, white)
                pairs[key] = pairs.get(key, 0) + 1
    else:
        parts = line.rstrip("\n").split(",")
        if len(parts) == 4 and parts[0].isdigit():
            try:
                t = int(parts[0])
            except ValueError:
                s["int_ok"] = False
        else:
            s["all_valid"] = False
    if t is not None:
        if t > s["max_t"]:
            s["max_t"] = t
        if s["last_t"] is None or t > s["last_t"]:
            s["starts"].append([t, off])
            s["last_t"] = t
        elif t < s["last_t"]:
            s["sorted"] = False


def _scan_load(cp, key):
    """The saved (entry, pairs) for this file, or None."""
    try:
        with open(cp) as f:
            entry = json.load(f)
        if (entry.get("version") != SCAN_VERSION or [entry.get("path"), entry.get("kind")] != list(key)
                or not isinstance(entry.get("L"), int) or not isinstance(entry.get("s"), dict)):
            return None
        pairs = None
        if key[1] == "games":
            with open(cp[:-len(".json")] + ".pairs.json") as f:
                d = json.load(f)
            if d.get("L") != entry["L"] or d.get("sha256") != entry["sha256"]:
                return None
            names, flat = d["names"], d["flat"]
            pairs = {(names[flat[k]], names[flat[k + 1]]): flat[k + 2] for k in range(0, len(flat), 3)}
        return entry, pairs
    except (OSError, ValueError, KeyError, TypeError, IndexError):
        return None


def _scan_save(cp, entry, pairs):
    try:
        os.makedirs(os.path.dirname(cp), exist_ok=True)
        if pairs is not None:
            index, names, flat = {}, [], []
            for (a, b), n in pairs.items():
                for x in (a, b):
                    if x not in index:
                        index[x] = len(names)
                        names.append(x)
                flat += (index[a], index[b], n)
            atomic_write(cp[:-len(".json")] + ".pairs.json",
                         json.dumps(dict(L=entry["L"], sha256=entry["sha256"], names=names, flat=flat),
                                    separators=(",", ":")))
        atomic_write(cp, json.dumps(entry, separators=(",", ":")))
    except OSError:
        pass


class _ScanView:
    """A file's summary s of its complete lines before byte L (verified), the mapped file and `tail`: the text lines
    after L as the original code reads them (the final line without "\\n", if any, unless it is the header)."""

    def __init__(self, entry, pairs, mm, tail):
        self.s, self.L, self.pairs, self.mm, self.tail = entry["s"], entry["L"], pairs, mm, tail

    def lines(self, t_from, t_to):
        """With s["sorted"]: the lines of rounds t_from <= t < t_to among the complete lines, then the tail. In file
        order they hold every line the original code takes for that range (and lines it skips anyway)."""
        ts = [t for t, _ in self.s["starts"]]

        def at(t):
            i = bisect.bisect_left(ts, t)
            return self.s["starts"][i][1] if i < len(ts) else self.L

        a, b = at(t_from), at(t_to)
        out = [x + "\n" for x in self.mm[a:b].decode("utf-8").split("\n")[:-1]] if b > a else []
        return out + self.tail


def _scan_view(path, kind, f, mm, st):
    """A _ScanView of the binary file f at path (mapped as mm, its stat st), the cache verified and extended to
    every complete line (and saved); None when no cache can be used."""
    cp = _scan_cache_path(path)
    if cp is None:
        return None
    with open(path) as tf:  # the original code's text mode decodes with this encoding
        if codecs.lookup(tf.encoding).name != "utf-8":
            return None
    size = st.st_size
    key = (os.path.abspath(path), kind)
    got = _SCAN_MEMO.get(key) or _scan_load(cp, key)
    entry, pairs = got if got else (None, None)
    h = None
    if entry is not None and entry["stat"] != _scan_stat(st):
        h = hashlib.sha256()
        if entry["L"] <= size:
            with memoryview(mm) as mv, mv[:entry["L"]] as part:
                h.update(part)
        if entry["L"] > size or h.hexdigest() != entry["sha256"]:
            entry, h = None, None
    end = mm.rfind(b"\n") + 1  # every complete line
    if entry is not None and h is None and end != entry["L"]:  # unchanged since saved, so this can't be
        entry = None
    changed = False
    if entry is None:
        entry = dict(version=SCAN_VERSION, path=key[0], kind=kind, L=0, sha256=hashlib.sha256().hexdigest(),
                     stat=None, s=_scan_new(kind))
        pairs = {} if kind == "games" else None
        h = hashlib.sha256()
        changed = True
    a = entry["L"]
    if mm.find(b"\r", a) != -1:
        return None
    if end > a:
        s = copy.deepcopy(entry["s"])
        pairs = dict(pairs) if pairs is not None else None
        f.seek(a)
        off = a
        for bline in f:
            if off >= end:
                break
            if off > 0:  # the file's first line is the header, which the original code skips
                _scan_line(kind, s, pairs, bline.decode("utf-8"), off)
            off += len(bline)
        if off != end:
            return None
        with memoryview(mm) as mv, mv[a:end] as part:
            h.update(part)
        entry = dict(entry, L=end, sha256=h.hexdigest(), s=s)
        changed = True
    if _scan_stat(os.fstat(f.fileno())) != _scan_stat(st) or _scan_stat(os.stat(path)) != _scan_stat(st):
        return None  # written or replaced while we read it
    if changed or entry["stat"] != _scan_stat(st):
        entry = dict(entry, stat=_scan_stat(st))
        _scan_save(cp, entry, pairs if changed else None)  # an unchanged L and SHA-256 keep their pairs file
    _SCAN_MEMO[key] = (entry, pairs)
    tail = []
    if size > end and end > 0:
        tail = [mm[end:size].decode("utf-8")]
    return _ScanView(entry, pairs, mm, tail)


@contextlib.contextmanager
def _scan_open(path, kind):
    """A _ScanView of the file, or None (then the caller runs its original code)."""
    f = mm = view = None
    try:
        try:
            f = open(path, "rb")
            st = os.fstat(f.fileno())
            if st.st_size > 0:
                mm = mmap.mmap(f.fileno(), st.st_size, access=mmap.ACCESS_READ)
                view = _scan_view(path, kind, f, mm, st)
        except (OSError, ValueError, KeyError, TypeError, IndexError):  # a damaged cache, an odd file: no cache
            view = None
        yield view
    finally:
        if mm is not None:
            mm.close()
        if f is not None:
            f.close()


def _done_round_robins_fast(p):
    if not os.path.exists(p):
        return None
    with _scan_open(p, "games") as v:
        if v is None or not v.s["t_ok"]:
            return None
        t = v.s["max_t"]
        for line in v.tail:
            if line.strip():
                t = max(t, int(line.split(",", 1)[0]))
        return t + 1


def _cpu_all_kept(p, done):
    """True when clean_partial's original code would keep every line of game_cpu.csv (and so not write it)."""
    with _scan_open(p, "game_cpu") as v:
        return (v is not None and v.s["int_ok"] and v.s["all_valid"] and v.s["max_t"] < done and not v.tail)


def _game_rows_fast(tour, t_from, t_to, price, ply=2):
    pc, pg = os.path.join(tour, "game_cpu.csv"), os.path.join(tour, "games.csv")
    if not os.path.exists(pg):
        return None
    cpu = {}
    if os.path.exists(pc):
        with _scan_open(pc, "game_cpu") as v:
            if v is None or not (v.s["int_ok"] and v.s["sorted"]):
                return None
            for line in v.lines(t_from, t_to):
                parts = line.rstrip("\n").split(",")
                if len(parts) == 4 and parts[0].isdigit() and t_from <= int(parts[0]) < t_to:
                    try:
                        cpu[(int(parts[0]), parts[1], parts[2])] = float(parts[3])
                    except ValueError:
                        pass
    rows = []
    with _scan_open(pg, "games") as v:
        if v is None or not (v.s["t_ok"] and v.s["sorted"]):
            return None
        for line in v.lines(t_from, t_to):
            parts = line.rstrip("\n").split(",")
            if len(parts) < 5:
                continue
            t = int(parts[0])
            if t_from <= t < t_to:
                rows.append(dict(t=t, white=parts[1], black=parts[2], result=parts[3], plies=parts[4],
                                 cpu_s=cpu.get((t, parts[1], parts[2])), ply2=qualifies(parts[1], parts[2], ply),
                                 price_s=price(parts[1], parts[2], parts[4]) if price else None))
    return rows


def _pair_counts_fast(tour, ratings):
    """contrast_ses' pair counts (same keys, order and counts), or None."""
    p = os.path.join(tour, "games.csv")
    if not os.path.exists(p):
        return None
    with _scan_open(p, "games") as v:
        if v is None or not v.s["pairs_ok"] or v.pairs is None:
            return None
        count = {k: n for k, n in v.pairs.items() if k[0] in ratings and k[1] in ratings}
        for line in v.tail:
            _, white, black, _ = line.split(",", 3)
            if white != black and white in ratings and black in ratings:
                key = (white, black) if white < black else (black, white)
                count[key] = count.get(key, 0) + 1
        return count


def done_round_robins(tour):
    p = os.path.join(tour, "games.csv")
    fast = _done_round_robins_fast(p)
    if fast is not None:
        return fast
    t = -1
    if os.path.exists(p):
        with open(p) as f:
            next(f, None)
            for line in f:
                if line.strip():
                    t = max(t, int(line.split(",", 1)[0]))
    return t + 1


def write_players(L, field):
    """players.txt is the field; every earlier player not in it is in retired.txt (its games stay in the fit)."""
    tour = L.p("tour")
    os.makedirs(tour, exist_ok=True)
    names = {e["entry"] for e in field}
    old_players = read_entries(os.path.join(tour, "players.txt"))
    retired = [r for r in read_entries(os.path.join(tour, "retired.txt")) if r[0] not in names]
    have = {r[0] for r in retired}
    retired += [r for r in old_players if r[0] not in names and r[0] not in have]
    head = "# NAME DEPTH SPEC: written by leagues/leagues.py\n"
    atomic_write(os.path.join(tour, "retired.txt"),
                 "# Players out of the field: their games stay in the fit (tournament --retired).\n"
                 + "".join(f"{n} {d} {s}\n" for n, d, s in retired))
    atomic_write(os.path.join(tour, "players.txt"),
                 head + "".join(f"{e['entry']} {e['ply']} {e['spec']}\n" for e in field))


def clean_partial(L, done):
    """Before (re)running the tournament: saved rounds and CPU rows of rounds not in games.csv go (a run cut short
    replays them, the same games)."""
    pool = L.p("pool")
    if os.path.isdir(pool):
        for r in os.listdir(pool):
            m = re.fullmatch(r"round(\d+)", r)
            if m and int(m.group(1)) >= done:
                shutil.rmtree(os.path.join(pool, r), ignore_errors=True)
    p = L.p("tour", "game_cpu.csv")
    if os.path.exists(p) and not _cpu_all_kept(p, done):
        with open(p) as f:
            lines = f.readlines()
        keep = lines[:1]
        for line in lines[1:]:
            parts = line.rstrip("\n").split(",")
            if line.endswith("\n") and len(parts) == 4 and parts[0].isdigit() and int(parts[0]) < done:
                keep.append(line)
        if keep != lines:
            atomic_write(p, "".join(keep))


def league_busy(L):
    """A chessai binary (tournament, arena, train or self-play) with an argument in this league dir that this driver
    didn't start, such as one left running by a killed driver."""
    with CHILD_LOCK:
        mine = {p.pid for p in CHILDREN}
    for pid in os.listdir("/proc"):
        if not pid.isdigit() or int(pid) in mine:
            continue
        try:
            with open(f"/proc/{pid}/cmdline", "rb") as f:
                args = [a.decode(errors="replace") for a in f.read().split(b"\0") if a]
        except OSError:
            continue
        if args and os.path.basename(args[0]).startswith("chessai") and any(a.startswith(L.dir + "/")
                                                                             for a in args[1:]):
            return int(pid)
    return None


def wait_not_busy(L):
    while True:
        pid = league_busy(L)
        if not pid:
            return
        L.log(f"waiting for pid {pid}, still working in this league")
        time.sleep(30)


def game_rows(tour, t_from, t_to, price=None, ply=2):
    """games.csv rows of tournaments t_from <= t < t_to, with their measured CPU (game_cpu.csv; cpu_s None if
    missing) and, given price(white, black, plies), their price_s. ply2: the game qualifies for training (a model at
    the entry ply `ply`)."""
    fast = _game_rows_fast(tour, t_from, t_to, price, ply)
    if fast is not None:
        return fast
    cpu = {}
    p = os.path.join(tour, "game_cpu.csv")
    if os.path.exists(p):
        with open(p) as f:
            next(f, None)
            for line in f:
                parts = line.rstrip("\n").split(",")
                if len(parts) == 4 and parts[0].isdigit() and t_from <= int(parts[0]) < t_to:
                    try:
                        cpu[(int(parts[0]), parts[1], parts[2])] = float(parts[3])
                    except ValueError:
                        pass
    rows = []
    with open(os.path.join(tour, "games.csv")) as f:
        next(f, None)
        for line in f:
            parts = line.rstrip("\n").split(",")
            if len(parts) < 5:
                continue
            t = int(parts[0])
            if t_from <= t < t_to:
                rows.append(dict(t=t, white=parts[1], black=parts[2], result=parts[3], plies=parts[4],
                                 cpu_s=cpu.get((t, parts[1], parts[2])), ply2=qualifies(parts[1], parts[2], ply),
                                 price_s=price(parts[1], parts[2], parts[4]) if price else None))
    return rows


def round_stats(rows, t0, n, players, walls):
    """Per round: games, qualifying games, their prices (the decisions use these) and their measured CPU (games
    without a CPU row get the cycle's mean; counted in `estimated`)."""
    known = [r["cpu_s"] for r in rows if r["cpu_s"] is not None]
    mean = sum(known) / len(known) if known else 0.0
    out = []
    for i in range(n):
        t = t0 + i
        rs = [r for r in rows if r["t"] == t]
        cpu = [r["cpu_s"] if r["cpu_s"] is not None else mean for r in rs]
        out.append(dict(t=t, round=i + 1, players=players, games=len(rs), ply2_games=sum(1 for r in rs if r["ply2"]),
                        cpu_s=sum(cpu), ply2_cpu_s=sum(c for c, r in zip(cpu, rs) if r["ply2"]),
                        wall_s=walls.get(str(t)), estimated=sum(1 for r in rs if r["cpu_s"] is None),
                        price_s=sum(r["price_s"] for r in rs), ply2_price_s=sum(r["price_s"] for r in rs if r["ply2"])))
    return out


def saved_games(pool, ts=None):
    """[(t, white, black, dir)] of the games tournament --save-games wrote: pool/round{t}/{white}~{black}/."""
    out = []
    if not os.path.isdir(pool):
        return out
    for r in os.listdir(pool):
        m = re.fullmatch(r"round(\d+)", r)
        if not m or (ts is not None and int(m.group(1)) not in ts):
            continue
        for g in os.listdir(os.path.join(pool, r)):
            white, sep, black = g.partition("~")
            path = os.path.join(pool, r, g)
            if sep and os.path.isfile(os.path.join(path, OUTCOMES[0])):
                out.append((int(m.group(1)), white, black, path))
    return sorted(out)


# ---------------------------------------------------------------- the global batch, and copying it

def batch_dir(gdir):
    return os.path.join(gdir, "batch")


def read_batch(gdir):
    return read_json(os.path.join(batch_dir(gdir), "batch.json"))


def publish_batch(L, cur):
    """The cycle's rounds become the batch (hard links to the saved games), replacing the last one under an exclusive
    lock on batch.lock."""
    new, old, cur_dir = L.p("batch.new"), L.p("batch.old"), batch_dir(L.dir)
    shutil.rmtree(new, ignore_errors=True)
    os.makedirs(new)
    for r in cur["rounds"]:
        src = L.p("pool", f"round{r['t']}")
        if os.path.isdir(src):
            link_tree(src, os.path.join(new, f"round{r['t']}"))
    rows = game_rows(L.p("tour"), cur["t0"], cur["t0"] + cur["rounds_planned"], L.price, entry_ply(L.cfg))
    write_csv(os.path.join(new, "games.csv"), BATCH_GAMES_FIELDS,
              [dict(r, cpu_s=f"{r['cpu_s']:.6f}" if r["cpu_s"] is not None else "", ply2=r["ply2"],
                    price_s=f"{r['price_s']:.6f}") for r in rows])
    write_json(os.path.join(new, "batch.json"), dict(
        cycle=cur["cycle"], made=now(), prices_version=L.cfg["prices"]["version"],
        rounds=[dict(t=r["t"], games=r["games"], ply2_games=r["ply2_games"], cpu_s=round(r["cpu_s"], 3),
                     ply2_cpu_s=round(r["ply2_cpu_s"], 3), price_s=round(r["price_s"], 6),
                     ply2_price_s=round(r["ply2_price_s"], 6)) for r in cur["rounds"]]))
    with FileLock(L.p("batch.lock")):
        shutil.rmtree(old, ignore_errors=True)
        if os.path.exists(cur_dir):
            os.rename(cur_dir, old)
        os.rename(new, cur_dir)
    shutil.rmtree(old, ignore_errors=True)


def experiment_round_estimate(L, cur, batch_rows):
    """The qualifying price of one experiment round: this cycle's field, each qualifying pair at the mean moves of
    its pair of classes (model or random, ply; white's and black's) in last cycle's games, times its sides' prices
    (so a field that grew or shrank is priced right); in the first cycle, at the global batch's mean moves. With
    self_games, the round's self-games are added, each at its class's mean moves against itself."""
    field = field_of(L, L.state, cur["cycle"])
    names = [e["entry"] for e in field]
    kinds = {lc["line"]: lc["kind"] for lc in L.cfg["lines"]}
    sides = {n: side_of(n, kinds) for n in names}

    p = entry_ply(L.cfg)

    def est(moves, fallback):
        e = estimate_round_ply2_price(names, sides, L.us, moves, fallback, p)
        if L.cfg.get("self_games"):
            e += estimate_self_games_price(names, sides, L.us, moves, fallback, p)
        return e

    last = L.state.get("last_rounds")
    if last:
        moves, fallback = class_moves(game_rows(L.p("tour"), last[0], last[0] + last[1]))
        if moves:
            return est(moves, fallback), "last cycle's moves by class"
    moves, fallback = class_moves(batch_rows)
    return est(moves, fallback), "global batch's moves by class"


def priced_batch(L, src, batch):
    """The batch's game rows and rounds priced with this league's prices (the global league's kinds): an experiment
    prices what it copies itself, so its decisions don't depend on the global league's prices version."""
    gcfg = read_json(os.path.join(src, "config.json"))
    price = pricer(L.us, {lc["line"]: lc["kind"] for lc in gcfg["lines"]})
    rows = read_csv(os.path.join(batch_dir(src), "games.csv"))
    sums = {}
    for r in rows:
        r["ply2"] = qualifies(r["white"], r["black"])
        r["batch_price_s"] = r.get("price_s", "")
        r["price_s"] = price(r["white"], r["black"], r["plies"])
        s = sums.setdefault(int(r["t"]), [0.0, 0.0])
        s[0] += r["price_s"]
        if r["ply2"]:
            s[1] += r["price_s"]
    rounds = [dict(x, price_s=sums.get(x["t"], [0.0, 0.0])[0], ply2_price_s=sums.get(x["t"], [0.0, 0.0])[1])
              for x in batch["rounds"]]
    return rows, rounds


def try_copy(L, cur):
    """The copy step: True once this cycle's global rounds are copied (cur["copied"]), False to wait."""
    if cur.get("copied"):
        return True
    src = L.cfg["global_source"]
    lock = os.path.join(src, "batch.lock")
    if not os.path.exists(os.path.join(batch_dir(src), "batch.json")):
        return False
    with FileLock(lock, shared=True):
        batch = read_batch(src)
        if not batch:
            return False
        rows, rounds = priced_batch(L, src, batch)
        est, how = experiment_round_estimate(L, cur, rows)
        used = {tuple(x) for x in L.state["used_global_rounds"]}
        carry = L.state.get("global_carry_s", 0.0)
        plan = plan_copy(dict(batch, rounds=rounds), used, est, L.cfg["min_rounds"], carry)
        if plan is None:
            return False
        chosen, n, total = plan
        dst = L.p("copied")
        shutil.rmtree(dst, ignore_errors=True)
        os.makedirs(dst)
        ts = {r["t"] for r in chosen}
        for t in sorted(ts):
            link_tree(os.path.join(batch_dir(src), f"round{t}"), os.path.join(dst, f"round{t}"))
        write_csv(os.path.join(dst, "games.csv"), BATCH_GAMES_FIELDS,
                  [dict(r, price_s=f"{r['price_s']:.6f}") for r in rows if int(r["t"]) in ts])
    with L.mutex:
        cur["copied"] = dict(global_cycle=batch["cycle"], rounds=chosen, cpu_s=sum(r["cpu_s"] for r in chosen),
                             ply2_cpu_s=sum(r["ply2_cpu_s"] for r in chosen),
                             price_s=sum(r["price_s"] for r in chosen), ply2_price_s=total,
                             est_round_ply2_price_s=est, estimate=how, carry_before_s=carry, copied_at=now())
        cur["rounds_planned"] = n
        L.state["used_global_rounds"] += [[batch["cycle"], r["t"]] for r in chosen]
        cur["events"].append(dict(date=now(), line="", event="copied", entry="", version_name="", value=len(chosen),
                                  detail=f"global cycle {batch['cycle']} rounds "
                                         + " ".join(str(r["t"]) for r in chosen)
                                         + f"; ply-2 price {total:.1f} s and carry {carry:.1f} s cover {n} rounds"
                                           f" at {est:.1f} s ({how})"))
    L.save()
    return True


def copied_games(L):
    """[(t, white, black, dir)] of the copied rounds' qualifying games (the batch's ply2 column)."""
    rows = read_csv(L.p("copied", "games.csv"))
    q = {(int(r["t"]), r["white"], r["black"]) for r in rows if r["ply2"] in ("1", "True", "true")}
    return [g for g in saved_games(L.p("copied")) if (g[0], g[1], g[2]) in q]


# ---------------------------------------------------------------- training

def build_set(L, name, games):
    """A training set: round0/ with a link per game, named <t>~<white>~<black> (train reads them in name order)."""
    d = L.p("trainsets", name)
    shutil.rmtree(d, ignore_errors=True)
    r0 = os.path.join(d, "round0")
    os.makedirs(r0)
    for t, white, black, path in games:
        os.symlink(path, os.path.join(r0, f"{t:06d}~{white}~{black}"))
    return d


def train_line(L, lc, setdir, ngames, cycle, v):
    """Trains version v once on the set; the result becomes version v+1. Returns the record."""
    line, kind = lc["line"], lc["kind"]
    work = L.p("runs", f".train-{line}")
    shutil.rmtree(work, ignore_errors=True)
    out = os.path.join(work, "out")
    start = []
    if v >= 1:
        start = ["--start", L.state_path(line, v) if kind in TREE_KINDS else L.model_path(line, v)]
    cmd = L.nice() + [lc["train_binary"], "train", setdir, out, "--model", kind, "--rounds", "1", "--seed",
                      str(train_seed(L, lc, cycle)), *start, *lc["train_args"]]
    code, cpu, wall, text = run_measured(cmd, L.p("runs", line + ".log"), f"cycle {cycle} train",
                                         env=threads_env(L.per_job_threads()))
    m = re.search(r"^round 0: (\d+) positions", text, re.M)
    trained = os.path.join(out, f"{kind}1.model")
    rec = dict(ok=False, games=ngames, positions=int(m.group(1)) if m else None, cpu_s=round(cpu, 2),
               wall_s=round(wall, 2))
    if code != 0 or not os.path.exists(trained):
        rec["note"] = f"train failed (exit {code}: {(text.strip().splitlines() or [''])[-1][:100]})"
        shutil.rmtree(work, ignore_errors=True)
        return rec
    st_out = os.path.join(out, f"{kind}1.state")
    if os.path.exists(st_out):
        os.replace(st_out, L.state_path(line, v + 1))
    os.replace(trained, L.model_path(line, v + 1))
    shutil.rmtree(work, ignore_errors=True)
    rec["ok"] = True
    return rec


# ---------------------------------------------------------------- self-play

def last_version(run_dir, kind):
    n = 0
    while os.path.exists(os.path.join(run_dir, f"{kind}{n + 1}.model")):
        n += 1
    return n


def trim_side_file(path, start):
    """Drops from a self-play run's ladder.csv or results.txt the rounds from `start` on (copied from the live
    driver): an interrupted round's rows go, as it is replayed."""
    name = os.path.basename(path)
    if not os.path.exists(path):
        return
    with open(path) as f:
        lines = f.readlines()
    keep = []
    for i, line in enumerate(lines):
        m = re.match(r"(\d+)," if name == "ladder.csv" else r"round (\d+)\b", line)
        if (m and int(m.group(1)) >= start) or (name == "ladder.csv" and i > 0 and not m):
            continue
        keep.append(line if line.endswith("\n") else line + "\n")
    if keep != lines:
        atomic_write(path, "".join(keep))


SP_ROUND_RE = re.compile(r"^round (?P<round>\d+): [+](?P<w>\d+) -(?P<b>\d+) =(?P<d>\d+), (?P<plies>\d+) plies, play",
                         re.M)


def sp_round_of(m):
    """(round, games, plies) of a self-play output line matched by SP_ROUND_RE."""
    return int(m["round"]), int(m["w"]) + int(m["b"]) + int(m["d"]), int(m["plies"])


def read_plies(path):
    """{round: (games, plies)} of a self-play run's plies.csv."""
    return ({int(r["round"]): (int(r["games"]), int(r["plies"])) for r in read_csv(path)}
            if os.path.exists(path) else {})


def sync_selfplay(L, lc):
    """A self-play line's rounds and their games and plies, which price them: runs/<line>/sp/plies.csv, completed
    from the self-play output in the line's log (a driver killed during a chunk records nothing itself). A round
    saved without a known ply count (killed between saving it and printing it) is rolled back with the rounds after
    it, to be played again: each round has its own seeds, so it replays the same. Returns (rounds played, {round:
    (games, plies)}): every round before the first not played has its counts."""
    line, kind = lc["line"], lc["kind"]
    run_dir = L.p("runs", line, "sp")
    path = os.path.join(run_dir, "plies.csv")
    v = last_version(run_dir, kind)
    plies = read_plies(path)
    if any(r not in plies for r in range(v)):
        log = L.p("runs", line + ".log")
        if os.path.exists(log):
            with open(log) as f:
                for m in SP_ROUND_RE.finditer(f.read()):
                    r, games, n = sp_round_of(m)
                    plies.setdefault(r, (games, n))
        lost = [r for r in range(v) if r not in plies]
        if lost:
            first = min(lost)
            for k in range(first + 1, v + 1):
                for ext in ("model", "state"):
                    f = os.path.join(run_dir, f"{kind}{k}.{ext}")
                    if os.path.exists(f):
                        os.remove(f)
            for side in ("ladder.csv", "results.txt"):
                trim_side_file(os.path.join(run_dir, side), first)
            L.log(f"{line}: self-play rounds {first}-{v - 1} rolled back (no ply count); they play again")
            v = first
    plies = {r: n for r, n in plies.items() if r < v}
    depth = selfplay_depth(lc)
    text = csv_text(PLIES_FIELDS, [dict(round=r, games=g, plies=n,
                                        price_s=f"{selfplay_round_price(L.us, kind, depth, g, n):.6f}")
                                   for r, (g, n) in sorted(plies.items())])
    if not os.path.exists(path) or open(path).read() != text:
        atomic_write(path, text)
    return v, plies


def selfplay_times(out):
    """(play, train, labels) wall s summed over a self-play run's rounds, from its output."""
    play = sum(float(x) for x in re.findall(r"^round \d+: .*\bplay ([\d.]+)s", out, re.M))
    train = sum(float(x) for x in re.findall(r"^round \d+: .*\btrain ([\d.]+)s", out, re.M))
    labels = sum(float(x) for x in re.findall(r"^round \d+: calibration .*\blabels ([\d.]+)s", out, re.M))
    return play, train, labels


def generation_cpu(cpu, play_s, train_s, labels_s, threads):
    """A self-play job's CPU spent playing games: its CPU split by the wall time of its phases, playing and
    labelling on `threads` threads, training on one (the output gives wall times only; a busy machine stretches
    them alike). Measured, so for information only."""
    work = play_s * threads + train_s + labels_s * threads
    return cpu * play_s * threads / work if work > 0 else 0.0


def selfplay_line(L, lc, cur, budget, fail_after_chunk=False):
    """The line's self-play this cycle: chunks of rounds (--resume, exact) until the price of its rounds (their
    plies at the line's self-play price per ply) reaches about `budget` priced s. Every decision uses prices, so the
    rounds played replay exactly; the job's measured CPU is recorded beside them (generation: the job's CPU minus
    its training, single-threaded, and its labelling, on the job's threads). Progress is in cur["selfplay"][line]."""
    line, kind = lc["line"], lc["kind"]
    ls = L.state["lines"][line]
    run_dir = L.p("runs", line, "sp")
    os.makedirs(run_dir, exist_ok=True)
    args = lc["selfplay_args"]
    depth = selfplay_depth(lc)
    size = lc.get("selfplay_games") or round_size(L.cfg["selfplay"]["round_anchor_games"], load_costs(), depth)
    threads = L.per_job_threads()
    with L.mutex:
        p = cur["selfplay"].setdefault(line, dict(budget=budget, start=ls["sp_version"], size=size, depth=depth,
                                                  cpu=0.0, gen_cpu=0.0, parts=[]))
    log = L.p("runs", line + ".log")

    def account(v, plies):
        prices = [selfplay_round_price(L.us, kind, depth, *plies[r]) for r in range(p["start"], v)]
        with L.mutex:
            p["covered"], p["gen_price"] = v, sum(prices)
            p["games"] = sum(plies[r][0] for r in range(p["start"], v))
            p["plies"] = sum(plies[r][1] for r in range(p["start"], v))
        return prices

    while True:
        v, plies = sync_selfplay(L, lc)
        if v < p["start"]:
            raise RuntimeError(f"{line}: self-play rounds of earlier cycles have no ply counts")
        prices = account(v, plies)
        round_price = sum(prices) / len(prices) if prices else ls.get("sp_round_price_s")
        chunk = selfplay_plan(p["budget"], p["gen_price"], round_price, L.cfg["selfplay"]["chunk"])
        L.save()
        if chunk <= 0:
            break
        fresh = v == 0 or (kind == "moe" and v < 2)  # --resume needs a model and its opponent
        target = v + chunk
        if fresh:
            target = max(target, 2 if kind == "moe" else 1)
        for side in ("ladder.csv", "results.txt"):
            trim_side_file(os.path.join(run_dir, side), 0 if fresh else v)
        cmd = L.nice() + [lc["selfplay_binary"], "self-play", run_dir, *args, "--games", str(size), "--threads",
                          str(threads), "--rounds", str(target)] + ([] if fresh else ["--resume"])
        code, cpu, wall, out = run_measured(cmd, log, f"cycle {cur['cycle']} self-play", env=threads_env(threads))
        check_interrupted()
        v2, _ = sync_selfplay(L, lc)
        play_s, train_s, labels_s = selfplay_times(out)
        gen = generation_cpu(cpu, play_s, train_s, labels_s, threads)
        with L.mutex:
            p["parts"].append([v, v2, code, round(cpu, 2), round(gen, 2), round(train_s, 2), round(labels_s, 2),
                               round(wall, 2)])
            p["cpu"] += cpu
            p["gen_cpu"] += gen
            if code != 0 or v2 <= v:
                p["failed"] = f"self-play exit {code}, {v2 - v} rounds saved"
        L.save()
        if p.get("failed"):
            break
        if fail_after_chunk:
            raise SystemExit(EXIT_INJECTED)
    v, plies = sync_selfplay(L, lc)
    prices = account(v, plies)
    with L.mutex:
        p["end"] = v
        p["round_price"] = sum(prices) / len(prices) if prices else None
        p["done"] = True
    L.save()
    return p


# ---------------------------------------------------------------- one cycle

def fail_hook(c, point):
    """Failure injection for the resume test: env LEAGUES_FAIL_AT=<cycle>:<point>."""
    return os.environ.get("LEAGUES_FAIL_AT") == f"{c}:{point}"


def inject(c, point):
    if fail_hook(c, point):
        print(f"injected failure at cycle {c} {point}", flush=True)
        raise SystemExit(EXIT_INJECTED)


def check_stop(L):
    if os.path.exists(L.p("STOP")):
        os.remove(L.p("STOP"))
        L.log("STOP found: stopping")
        L.state["status"] = "stopped"
        L.state["pid"] = None
        L.save(index=True)
        raise SystemExit(EXIT_STOPPED)


def start_cycle(L):
    st = L.state
    c = st["cycle"] + 1
    cur = st.get("current")
    if cur and cur["cycle"] == c:
        L.log(f"cycle {c} resumes at phase {cur['phase']}")
        L.set_phase(cur["phase"])
        return cur
    cur = st["current"] = dict(cycle=c, started=now(), phase=None, events=[], rounds_planned=None, t0=None,
                               cal={}, cal_made=0, trained={}, selfplay={}, decisions=None, wait_s=0.0)
    L.log(f"cycle {c} starts")
    with_global = any(lc["option"] == "global" for lc in L.cfg["lines"])
    L.set_phase("copy" if with_global else "calibration")
    return cur


def phase_copy(L, cur):
    c = cur["cycle"]
    if cur.get("copied"):
        return
    if last_cycle(L, c):
        L.log(f"cycle {c}: the experiment's last cycle trains nothing, so it copies no global rounds")
        return
    poll = L.cfg.get("wait_poll_s", 60)
    gw = L.state.get("global_wait")
    waited_from = gw["since_ts"] if gw and gw.get("cycle") == c else None  # a wait an earlier run began
    while not try_copy(L, cur):
        if waited_from is None:
            waited_from = time.time()
            with L.mutex:
                cur["events"].append(dict(date=now(), line="", event="wait-start", entry="", version_name="", value="",
                                          detail="no unused global rounds"))
                L.state["global_wait"] = dict(since=now(), since_ts=waited_from, cycle=c)
            L.log(f"cycle {c}: no unused global rounds; waiting")
        if L.state["status"] != "waiting":
            L.set_phase("waiting", status="waiting")
        check_stop(L)
        time.sleep(poll)
    if waited_from is not None:
        w = time.time() - waited_from
        with L.mutex:
            cur["wait_s"] = round(cur.get("wait_s", 0.0) + w, 1)
            cur["events"].append(dict(date=now(), line="", event="wait-end", entry="", version_name="", value=round(w, 1),
                                      detail="global rounds available"))
            L.state["global_wait"] = None
    k = cur["copied"]
    L.log(f"cycle {c}: copied global cycle {k['global_cycle']} rounds "
          f"{' '.join(str(r['t']) for r in k['rounds'])} (ply-2 price {k['ply2_price_s']:.1f} s, carry "
          f"{k['carry_before_s']:.1f} s); {cur['rounds_planned']} rounds at {k['est_round_ply2_price_s']:.1f} s "
          f"({k['estimate']})")


def phase_calibration(L, cur):
    c = cur["cycle"]
    if cur["rounds_planned"] is None:
        cur["rounds_planned"] = L.cfg["rounds_per_cycle"]
    for lc in lines_in_cycle(L, L.state, c):
        line = lc["line"]
        if not os.path.exists(L.model_path(line, L.state["lines"][line]["version"])):
            if L.state["lines"][line]["version"] != 0:
                raise RuntimeError(f"{line}: version {L.state['lines'][line]['version']}'s model is missing")
            make_untrained(L, lc)
        if lc["entered_cycle"] == c and not any(e["event"] == "entered" and e["line"] == line for e in cur["events"]):
            cur["events"].append(dict(date=now(), line=line, event="entered",
                                      entry=entry_name(line, 0, entry_ply(L.cfg)), version_name=L.vname(line, 0),
                                      value="", detail="untrained"))
    field = field_of(L, L.state, c)
    cur["field"] = field
    keys = sorted({(e["line"], e["version"]) for e in field if e["role"] != "reference"})
    todo = [k for k in keys if not own_done(L, *k)]
    L.save()
    if todo:
        wait_not_busy(L)
        L.log(f"cycle {c}: own calibration games of {len(todo)} versions")
        workers = max(1, L.cfg["jobs"])

        def one(k):
            cpu = make_own(L, k[0], k[1], L.per_job_threads())
            with L.mutex:
                cur["cal"][k[0]] = round(cur["cal"].get(k[0], 0.0) + cpu, 2)
                cur["cal_made"] += 1
            return cpu

        with ThreadPoolExecutor(workers) as ex:
            list(ex.map(one, todo))
        L.save()


def phase_tournament(L, cur):
    c = cur["cycle"]
    tour = L.p("tour")
    write_players(L, cur["field"])
    done = done_round_robins(tour)
    if cur["t0"] is None:
        cur["t0"] = done
        L.save()
    t0, n = cur["t0"], cur["rounds_planned"]
    target = t0 + n
    if done < t0:
        raise RuntimeError(f"games.csv has {done} round-robins; the cycle started at {t0}")
    clean_partial(L, done)
    partial = fail_hook(c, "tournament-partial")
    t = L.cfg["tournament"]
    anchor = [] if L.cfg.get("rating_zero") else ["--anchor", ANCHOR]  # no random: relative to the rated players' mean
    cmd = L.nice() + [t["binary"], "tournament", "players.txt", ".", "--tournaments",
                      str(min(target, t0 + 1) if partial else target), "--use-probs", *anchor, "--seed",
                      str(L.cfg["seed"]), "--no-catch-up", "--retired", "retired.txt", "--prior-draws", "0",
                      *t.get("flags", []), "--save-games", L.p("pool")] + (["--game-cpu"] if t.get("game_cpu") else [])
    wait_not_busy(L)
    L.log(f"cycle {c}: tournament, {len(cur['field'])} players, rounds {t0}-{target - 1}"
          + (f" (from {done})" if done > t0 else ""))
    code, cpu, wall, out = run_measured(cmd, os.path.join(tour, "tournament.log"), f"cycle {c} tournament",
                                        env=threads_env(L.cfg["threads"]), cwd=tour)
    check_interrupted()
    walls = cur.setdefault("round_walls", {})
    for m in re.finditer(r"^tournament (\d+)/\d+: \d+ games in (\d+)s", out, re.M):
        walls[str(int(m.group(1)) - 1)] = float(m.group(2))
    cur["tournament_proc_cpu_s"] = round(cur.get("tournament_proc_cpu_s", 0.0) + cpu, 2)
    cur["tournament_wall_s"] = round(cur.get("tournament_wall_s", 0.0) + wall, 2)
    L.save()
    if code != 0:
        raise RuntimeError(f"tournament failed (exit {code}); see {tour}/tournament.log")
    if partial:
        inject(c, "tournament-partial")
    if done_round_robins(tour) != target:
        raise RuntimeError(f"tournament stopped at {done_round_robins(tour)} round-robins, not {target}")
    rows = game_rows(tour, t0, target, L.price, entry_ply(L.cfg))
    cur["rounds"] = round_stats(rows, t0, n, len(cur["field"]), walls)
    cur["data_cpu_target_s"] = round(sum(r["ply2_cpu_s"] for r in cur["rounds"]), 3)
    cur["data_price_target_s"] = sum(r["ply2_price_s"] for r in cur["rounds"])
    L.save()


def phase_decide(L, cur):
    c, cfg, st = cur["cycle"], L.cfg, L.state
    ratings = league_ratings(L)
    ply1 = cfg.get("ply1_entries", True)
    p = entry_ply(cfg)
    dec, tests, pairs = {}, [], []
    for lc in lines_in_cycle(L, st, c):
        line = lc["line"]
        ls = st["lines"][line]
        v, ch = ls["version"], ls["champion"]
        d = dict(version=v, champion=ch, entry1=entry_name(line, v, 1) if ply1 else "", entry2=entry_name(line, v, p),
                 champion_entry=entry_name(line, ch, p), diff=None, se=None, z=None, note="")
        d["r1"], d["r2"], d["rc"] = (ratings.get(d["entry1"]), ratings.get(d["entry2"]),
                                     ratings.get(d["champion_entry"]))
        if lc["entered_cycle"] == c and v == 0:
            d["decision"] = "first-champion"
        elif v == ch:
            d["decision"] = "champion-kept"
            d["note"] = "the current version is the champion"
        elif d["r2"] is None or d["rc"] is None:
            d["decision"] = "unrated"
        else:
            tests.append(line)
            pairs.append(([d["entry2"]], [d["champion_entry"]]))
        dec[line] = d
    ses = contrast_ses(L.p("tour"), ratings, pairs, anchor=fit_pin(L, ratings)) if pairs else []
    for i, line in enumerate(tests):
        d = dec[line]
        se = ses[i] if ses else None
        d["decision"], d["diff"], d["z"] = champion_decision(d["r2"][0], d["rc"][0], se, cfg["champion_se"])
        d["se"] = se
        if se is None:
            d["note"] = "no SE: the fit's matrix is not positive definite"
    for line, d in dec.items():
        ls = st["lines"][line]
        if L.is_global:
            p = 0 if d["decision"] in ("first-champion", "new-champion") else ls["patience"] + 1
            d["patience"] = p
            d["retire"] = p >= cfg["patience_cycles"]
            if d["retire"]:
                d["decision"] = "retired"
        else:
            d["patience"], d["retire"] = None, False
    cur["decisions"] = dec
    pl = cfg.get("plateau")
    if pl and not L.is_global:
        crowned_now = any(d["decision"] in ("first-champion", "new-champion") for d in dec.values())
        cur["last_crown_cycle"] = c if crowned_now else st.get("last_crown_cycle", 0)
        cur["plateau_stop"] = plateau_stop(c, cur["last_crown_cycle"], pl)
    if L.is_global:
        current1 = [(d["entry1"], line, d["version"], d["r1"][0]) for line, d in dec.items() if d["r1"]]
        aratings = {a["entry"]: (ratings[a["entry"]][:2] if a["entry"] in ratings else None)
                    for a in st["anchors"].values()}
        anchors, events, leaving = anchor_update(st["anchors"], current1, aratings, c, cfg["anchors"],
                                                 st.get("anchor_entries", []))
        cur["anchors_after"], cur["anchor_events"], cur["anchors_leaving"] = anchors, events, leaving
    L.save()
    crowned = [line for line, d in dec.items() if d["decision"] == "new-champion"]
    L.log(f"cycle {c}: decided; new champions: {', '.join(crowned) or 'none'}"
          + (f"; the last crowning was in cycle {cur['last_crown_cycle']}" if "last_crown_cycle" in cur else ""))
    if cur.get("plateau_stop"):
        L.log(f"cycle {c}: plateau: no new champion for {c - cur['last_crown_cycle']} cycles (rule: "
              f"{pl['cycles']} cycles, from cycle {pl['min_cycles']}); this is the experiment's last cycle")


def plateau_stop(c, last_crown, rules):
    """The plateau rule (an experiment's "plateau": {"cycles": K, "min_cycles": M}): cycle c is the last when no
    line has crowned a champion in the K cycles since the last crowning (cycle last_crown; the first champions count,
    in the first cycle), and c is at least M."""
    return c >= rules.get("min_cycles", 0) and c - last_crown >= rules["cycles"]


def last_cycle(L, c):
    """An experiment's last cycle (it trains nothing): its cycles are used up, or its decisions found the plateau."""
    if L.is_global:
        return False
    if c >= L.cfg["cycles"]:
        return True
    cur = (L.state or {}).get("current")
    return bool(cur and cur.get("cycle") == c and cur.get("plateau_stop"))


# ---------------------------------------------------------------- self-games (a league with "self_games": true)

def self_game_entries(L, field):
    """The field's entries that play a self-game each round: those whose game against itself is a training game (a
    model at the league's entry ply), in field order."""
    p = entry_ply(L.cfg)
    return [e for e in field if qualifies(e["entry"], e["entry"], p)]


def self_games_wanted(L, cur):
    """Whether this cycle plays self-games: some line trains on the league's own games after it (not an experiment's
    last cycle; not every local line retiring)."""
    if last_cycle(L, cur["cycle"]):
        return False
    dec = cur["decisions"]
    return any(lc["line"] in dec and not dec[lc["line"]]["retire"] and lc["option"] in ("league", "local")
               for lc in L.cfg["lines"])


def self_games_pool(L):
    return L.p("selfpool")


def phase_selfgames(L, cur):
    """Each round of the cycle, every entry whose game against itself qualifies for training (a model at the entry
    ply) plays one game against itself: the same version at the same ply. The tournament binary's `replay-games`
    plays them as the tournament plays its games (the same players, policy, temperature and move choice), each entry
    paired with a twin (its spec and depth under the name <entry>.twin), round t's game of entry i seeded
    derive_seed(seed + SELF_GAMES_SEED_OFFSET, t, g), g the pairing's index in replay-games' players list (the
    self-game entries, then their twins); so they replay exactly and share no seed stream with the round-robins.
    They are training games only: saved to selfpool/round{t}/{entry}~{entry}/, never in tour/games.csv, so outside
    the rating fit, the champion test, the head-to-head tables and the plateau rule. Priced like tournament games
    (tournament prices of the entry's kind at its ply), their price is added to the cycle's local data price
    (data_price_target_s), which sets the self-play lines' budget and the global carry; their measured CPU (the
    replay-games process) is added to data_cpu_target_s. Recorded in self_games.csv and totals.csv (records)."""
    c = cur["cycle"]
    sg = cur.get("self_games")
    if sg and sg.get("done"):
        return
    pool = self_games_pool(L)
    shutil.rmtree(pool, ignore_errors=True)
    entries = self_game_entries(L, cur["field"]) if self_games_wanted(L, cur) else []
    ts = [r["t"] for r in cur["rounds"]]
    rec = dict(entries=len(entries), rounds=len(ts), games=0, plies=0, price_s=0.0, proc_cpu_s=0.0, wall_s=0.0)
    rows = []
    if entries and ts:
        os.makedirs(pool)
        twins = [e["entry"] + SELF_GAMES_TWIN for e in entries]
        players = os.path.join(pool, "players.txt")
        atomic_write(players, "# NAME DEPTH SPEC: written by leagues/leagues.py (self-games: the entries, then "
                              "their twins)\n" + "".join(f"{e['entry']} {e['ply']} {e['spec']}\n" for e in entries)
                     + "".join(f"{tw} {e['ply']} {e['spec']}\n" for tw, e in zip(twins, entries)))
        want = [(t, e["entry"], tw) for t in ts for e, tw in zip(entries, twins)]
        games = os.path.join(pool, "games.txt")
        atomic_write(games, "".join(f"{t} {w} {b}\n" for t, w, b in want))
        tc = L.cfg["tournament"]
        passed = [x for f, v in parse_flags(tc.get("flags", [])) if f in ("--policy", "--temperature") for x in (f, v)]
        cmd = L.nice() + [tc["binary"], "replay-games", players, games, os.path.join(pool, "out"), "--use-probs",
                          "--seed", str(L.cfg["seed"] + SELF_GAMES_SEED_OFFSET), *passed]
        wait_not_busy(L)
        L.log(f"cycle {c}: self-games, {plural(len(entries), 'entry', 'entries')} x {plural(len(ts), 'round')}")
        code, cpu, wall, out = run_measured(cmd, L.p("self_games.log"), f"cycle {c} self-games",
                                            env=threads_env(L.cfg["threads"]))
        check_interrupted()
        if code != 0:
            raise RuntimeError(f"self-games failed (exit {code}); see {L.p('self_games.log')}")
        got = {}
        for m in re.finditer(r"^(\d+),(\S+?),(\S+?),(1-0|0-1|1/2-1/2),(\d+)$", out, re.M):
            got[(int(m.group(1)), m.group(2), m.group(3))] = (m.group(4), int(m.group(5)))
        if set(got) != set(want):
            raise RuntimeError(f"self-games: replay-games reported {len(got)} games, not the {len(want)} asked for")
        total = 0.0
        for t, w, b in want:
            result, plies = got[(t, w, b)]
            os.makedirs(os.path.join(pool, f"round{t}"), exist_ok=True)
            os.rename(os.path.join(pool, "out", f"round{t}", f"{w}~{b}"), os.path.join(pool, f"round{t}", f"{w}~{w}"))
            price = L.price(w, w, plies)
            total += price
            rows.append(dict(cycle=c, t=t, entry=w, white=w, black=w, result=result, plies=plies,
                             price_s=f"{price:.6f}"))
        shutil.rmtree(os.path.join(pool, "out"), ignore_errors=True)
        inject(c, "self-games-partial")  # the resume test: games saved, the phase not done (it replays them)
        rec.update(games=len(rows), plies=sum(r["plies"] for r in rows), price_s=total, proc_cpu_s=round(cpu, 2),
                   wall_s=round(wall, 2))
    else:
        L.log(f"cycle {c}: no self-games (" + ("no round" if entries else "nothing trains on them this cycle") + ")")
    if rows or os.path.isdir(pool):
        write_csv(os.path.join(pool, "games.csv"), SELF_GAMES_FIELDS, rows)
    rec["done"] = True
    with L.mutex:
        cur["self_games"] = rec
        cur["data_cpu_target_s"] = round(sum(r["ply2_cpu_s"] for r in cur["rounds"]) + rec["proc_cpu_s"], 3)
        cur["data_price_target_s"] = sum(r["ply2_price_s"] for r in cur["rounds"]) + rec["price_s"]
    L.save()


def self_games_rows(L):
    """This cycle's self_games.csv rows (selfpool/games.csv; none when it played none)."""
    return read_csv(os.path.join(self_games_pool(L), "games.csv"))


def phase_train(L, cur):
    c = cur["cycle"]
    dec = cur["decisions"]
    if last_cycle(L, c):
        L.log(f"cycle {c}: the experiment's last cycle; no training (no cycle would rate the new versions)")
        return
    todo = [lc for lc in L.cfg["lines"] if lc["line"] in dec and not dec[lc["line"]]["retire"]
            and lc["option"] in ("league", "local", "global")]
    if not todo:
        return
    sets = {}
    ts = {r["t"] for r in cur["rounds"]}
    if any(lc["option"] in ("league", "local") for lc in todo):
        p = entry_ply(L.cfg)
        games = [g for g in saved_games(L.p("pool"), ts) if qualifies(g[1], g[2], p)]
        if L.cfg.get("self_games"):  # the self-games join the round-robins' games, ordered by round and names
            games = sorted(games + [g for g in saved_games(self_games_pool(L), ts) if qualifies(g[1], g[2], p)])
        sets["local"] = (build_set(L, "local", games), len(games), cur["data_cpu_target_s"],
                         cur["data_price_target_s"])
    if any(lc["option"] == "global" for lc in todo):
        games = copied_games(L)
        sets["global"] = (build_set(L, "global", games), len(games), cur["copied"]["ply2_cpu_s"],
                          cur["copied"]["ply2_price_s"])
    left = [lc for lc in todo if lc["line"] not in cur["trained"]]
    if left:
        L.log(f"cycle {c}: training {len(left)} lines"
              + "".join(f"; {k} set {v[1]} games" for k, v in sets.items()))

    def one(lc):
        key = "global" if lc["option"] == "global" else "local"
        setdir, ngames, data_cpu, data_price = sets[key]
        v = L.state["lines"][lc["line"]]["version"]
        if ngames == 0:
            rec = dict(ok=False, games=0, positions=0, cpu_s=0.0, note="no games to train on")
        else:
            wait_not_busy(L)
            rec = train_line(L, lc, setdir, ngames, c, v)
            check_interrupted()
        rec["data_cpu_s"] = round(data_cpu, 3)
        rec["data_price_s"] = data_price
        with L.mutex:
            cur["trained"][lc["line"]] = rec
        L.save()
        if fail_hook(c, "train-one"):
            os.environ.pop("LEAGUES_FAIL_AT", None)
            kill_children()
            os._exit(EXIT_INJECTED)
        return rec

    with ThreadPoolExecutor(max(1, L.cfg["jobs"])) as ex:
        list(ex.map(one, left))


def selfplay_target(L, cur):
    """A self-play line's budget this cycle before its carry, in priced s: a self-play-only experiment's fixed
    selfplay_budget_s; otherwise the price of the cycle's local data (its games with a model at ply 2)."""
    fixed = L.cfg.get("selfplay_budget_s")
    return float(fixed) if fixed else cur["data_price_target_s"]


def phase_selfplay(L, cur):
    c = cur["cycle"]
    dec = cur["decisions"]
    if last_cycle(L, c):
        return
    todo = [lc for lc in L.cfg["lines"] if lc["line"] in dec and lc["option"] == "self-play"]
    left = [lc for lc in todo if not cur["selfplay"].get(lc["line"], {}).get("done")]
    if not left:
        return
    target = selfplay_target(L, cur)
    L.log(f"cycle {c}: self-play of {plural(len(left), 'line')}, {target:.1f} priced s each (plus carry)")
    inject_chunk = fail_hook(c, "self-play-chunk")
    wait_not_busy(L)

    def one(lc):
        ls = L.state["lines"][lc["line"]]
        p = cur["selfplay"].get(lc["line"])
        budget = p["budget"] if p else target + ls.get("carry_s", 0.0)
        return selfplay_line(L, lc, cur, budget, fail_after_chunk=inject_chunk)

    with ThreadPoolExecutor(max(1, L.cfg["jobs"])) as ex:
        list(ex.map(one, left))


# ---------------------------------------------------------------- records

def apply_decisions(L, cur):
    """The state after the cycle (a copy): champions, majors, patience, retirements, versions, self-play accounting,
    anchors."""
    st = copy.deepcopy(L.state)
    c = cur["cycle"]
    for line, d in cur["decisions"].items():
        ls = st["lines"][line]
        lc = L.lines[line]
        if d["decision"] == "new-champion":
            ls["crowned"].append(d["version"])
            ls["champion"] = d["version"]
            ls["major"] = len(ls["crowned"]) - 1
        if d["patience"] is not None:
            ls["patience"] = d["patience"]
        if d["retire"]:
            ls["status"] = "retired"
            ls["retired_cycle"] = c
            continue
        if lc["option"] == "self-play":
            p = cur["selfplay"].get(line) or {}
            end = p.get("end", ls["sp_version"])
            if end > ls["sp_version"]:
                ls["version"] += 1
                ls["sp_version"] = end
            ls.pop("sp_cost", None)
            if p:
                if p.get("round_price"):
                    ls["sp_round_price_s"] = p["round_price"]
                ls["carry_s"] = 0.0 if p.get("failed") else round(p["budget"] - p.get("gen_price", 0.0), 6)
        else:
            rec = cur["trained"].get(line) or {}
            if rec.get("ok"):
                ls["version"] += 1
    if L.is_global:
        st["anchors"] = cur["anchors_after"]
        st["anchor_entries"] = sorted(set(st.get("anchor_entries", [])) | {a["entry"] for a in st["anchors"].values()})
    if "last_crown_cycle" in cur:
        st["last_crown_cycle"] = cur["last_crown_cycle"]
    k = cur.get("copied")
    if k and not last_cycle(L, c):
        st["global_carry_s"] = round(st.get("global_carry_s", 0.0) + k["ply2_price_s"] - cur["data_price_target_s"], 6)
    rounds = cur["rounds"]
    if rounds:
        st["last_round_ply2_cpu_s"] = round(sum(r["ply2_cpu_s"] for r in rounds) / len(rounds), 3)
        st["last_rounds"] = [cur["t0"], len(rounds)]
    return st


def link_selfplay_versions(L, cur, new_st):
    """A self-play line's new version is its run's last model: linked as runs/<line>/<kind><v>.model."""
    for line, p in cur["selfplay"].items():
        ls_new = new_st["lines"][line]
        if ls_new["version"] > L.state["lines"][line]["version"]:
            src = os.path.join(L.p("runs", line, "sp"), f"{L.lines[line]['kind']}{ls_new['sp_version']}.model")
            dst = L.model_path(line, ls_new["version"])
            if not os.path.exists(dst):
                link_or_copy(src, dst)


def phase_records(L, cur):
    c, cfg = cur["cycle"], L.cfg
    st0 = L.state
    new_st = apply_decisions(L, cur)
    link_selfplay_versions(L, cur, new_st)
    ratings = league_ratings(L)
    date = now()
    dec = cur["decisions"]

    def rating(name):
        r = ratings.get(name)
        return (r[0], r[1], r[2]) if r else (None, None, None)

    # cycles.csv
    rows = []
    for lc in cfg["lines"]:
        line = lc["line"]
        if line not in dec:
            continue
        d, ls0, ls1 = dec[line], st0["lines"][line], new_st["lines"][line]
        crowned0 = ls0["crowned"]
        r1, r2, rc = rating(d["entry1"]), rating(d["entry2"]), rating(d["champion_entry"])
        tr = cur["trained"].get(line) or {}
        sp = cur["selfplay"].get(line) or {}
        note = d.get("note") or tr.get("note") or sp.get("failed") or ""
        data_cpu = tr.get("data_cpu_s") if lc["option"] != "self-play" else sp.get("gen_cpu")
        data_price = tr.get("data_price_s") if lc["option"] != "self-play" else sp.get("gen_price")
        sp_rounds = (sp.get("end", sp.get("start", 0)) - sp.get("start", 0)) if sp else None
        rows.append(dict(
            cycle=c, date=date, line=line, model=lc["model"], option=lc["option"], status=ls1["status"],
            version=d["version"], version_name=version_name(L.prefix_of(line), crowned0, d["version"]),
            entry1=d["entry1"], elo1=e1(r1[0]), ci1=e1(r1[1]), entry2=d["entry2"], elo2=e1(r2[0]), ci2=e1(r2[1]),
            champion=d["champion"], champion_name=version_name(L.prefix_of(line), crowned0, d["champion"]),
            champion_entry=d["champion_entry"], champion_elo=e1(rc[0]), champion_ci=e1(rc[1]),
            diff=e1(d["diff"]), se_diff=e1(d["se"]), z=c2(d["z"]), decision=d["decision"],
            new_name=(version_name(L.prefix_of(line), ls1["crowned"], d["version"])
                      if d["decision"] == "new-champion" else ""),
            patience=d["patience"], train_games=tr.get("games"), train_positions=tr.get("positions"),
            train_cpu_s=c2(tr.get("cpu_s")), data_cpu_s=c2(data_cpu),
            selfplay_budget_s=c2(sp.get("budget")), selfplay_cpu_s=c2(sp.get("cpu")),
            selfplay_gen_cpu_s=c2(sp.get("gen_cpu")), selfplay_rounds=sp_rounds,
            selfplay_games=sp.get("games", sp_rounds * sp.get("size", 0)) if sp else None,
            cal_cpu_s=c2(cur["cal"].get(line, 0.0)),
            next_version=ls1["version"] if ls1["status"] == "active" else "",
            note=note, selfplay_carry_s=c2(ls1.get("carry_s")) if lc["option"] == "self-play" else "",
            data_price_s=c2(data_price), selfplay_price_s=c2(sp.get("gen_price")),
            selfplay_plies=sp.get("plies") if sp else None, label=lc.get("label", lc["model"])))
    append_cycle_rows(L.p("cycles.csv"), CYCLES_FIELDS, rows, c)

    # rounds.csv
    append_cycle_rows(L.p("rounds.csv"), ROUNDS_FIELDS,
                      [dict(r, cycle=c, cpu_s=c2(r["cpu_s"]), ply2_cpu_s=c2(r["ply2_cpu_s"]),
                            wall_s=e1(r["wall_s"]), price_s=c2(r["price_s"]), ply2_price_s=c2(r["ply2_price_s"]))
                       for r in cur["rounds"]], c)
    inject(c, "records-half")

    # events.csv
    events = []
    for e in cur["events"]:
        events.append(dict(e, cycle=c, date=e.get("date") or date))
    for line, d in dec.items():
        if d["decision"] == "first-champion":
            events.append(dict(cycle=c, date=date, line=line, event="first-champion", entry=d["entry2"],
                               version_name=L.vname(line, d["version"], crowned=new_st["lines"][line]["crowned"]),
                               value="", detail="the untrained version"))
        elif d["decision"] == "new-champion":
            events.append(dict(cycle=c, date=date, line=line, event="new-champion", entry=d["entry2"],
                               version_name=L.vname(line, d["version"], crowned=new_st["lines"][line]["crowned"]),
                               value=c2(d["z"]), detail=f"diff {e1(d['diff'])} SE {e1(d['se'])}"))
        if d["retire"]:
            events.append(dict(cycle=c, date=date, line=line, event="retired", entry="",
                               version_name="", value=d["patience"], detail="no new champion in patience cycles"))
    for ev, lo, a in cur.get("anchor_events") or []:
        crowned = new_st["lines"][a["line"]]["crowned"]
        detail = {"anchor-locked": f"from {a.get('source', '')} at {e1(a.get('locked_elo'))}",
                  "anchor-available": f"{a['outside_streak']} cycles more than {cfg['anchors']['margin']} outside",
                  "anchor-replaced": "left the field"}[ev]
        events.append(dict(cycle=c, date=date, line=a["line"], event=ev, entry=a["entry"],
                           version_name=L.vname(a["line"], a["version"], True, crowned), value=lo, detail=detail))
    done = cfg["kind"] == "experiment" and last_cycle(L, c)
    plateau = bool(done and cur.get("plateau_stop"))
    if done:
        events.append(dict(cycle=c, date=date, line="", event="done", entry="", version_name="", value=c,
                           detail=(f"plateau: no new champion since cycle {cur['last_crown_cycle']} "
                                   f"({c - cur['last_crown_cycle']} cycles)" if plateau else f"{cfg['cycles']} cycles")))
    append_cycle_rows(L.p("events.csv"), EVENTS_FIELDS, events, c)

    # history.csv
    hist = []
    for e in cur["field"]:
        r = rating(e["entry"])
        vn = ""
        if e["line"]:
            vn = L.vname(e["line"], e["version"], e["frozen"], st0["lines"][e["line"]]["crowned"])
        hist.append(dict(cycle=c, entry=e["entry"], line=e["line"], version=e["version"], version_name=vn,
                         ply=e["ply"], role=e["role"], elo=e1(r[0]), ci95=e1(r[1]), games=r[2]))
    append_cycle_rows(L.p("history.csv"), HISTORY_FIELDS, hist, c)

    # copied.csv
    if cur.get("copied"):
        k = cur["copied"]
        append_cycle_rows(L.p("copied.csv"), COPIED_FIELDS, [
            dict(cycle=c, global_cycle=k["global_cycle"], t=r["t"], games=r["games"], ply2_games=r["ply2_games"],
                 cpu_s=c2(r["cpu_s"]), ply2_cpu_s=c2(r["ply2_cpu_s"]), copied_at=k["copied_at"],
                 price_s=c2(r["price_s"]), ply2_price_s=c2(r["ply2_price_s"]))
            for r in k["rounds"]], c)

    # totals.csv
    rounds = cur["rounds"]
    sp = cur["selfplay"].values()
    ev_names = [e["event"] for e in events]
    k = cur.get("copied") or {}
    total = dict(
        cycle=c, start=cur["started"], end=date,
        wall_s=e1((datetime.datetime.strptime(date, "%Y-%m-%d %H:%M:%S")
                   - datetime.datetime.strptime(cur["started"], "%Y-%m-%d %H:%M:%S")).total_seconds()),
        kind=cfg["kind"], lines_active=sum(1 for ls in new_st["lines"].values() if ls["status"] == "active"),
        lines_retired=sum(1 for ls in new_st["lines"].values() if ls["status"] == "retired"),
        field=len(cur["field"]), anchors=len(new_st["anchors"]), rounds=len(rounds),
        games=sum(r["games"] for r in rounds), ply2_games=sum(r["ply2_games"] for r in rounds),
        tournament_cpu_s=c2(sum(r["cpu_s"] for r in rounds)), ply2_cpu_s=c2(sum(r["ply2_cpu_s"] for r in rounds)),
        tournament_wall_s=e1(cur.get("tournament_wall_s")),
        train_cpu_s=c2(sum((t.get("cpu_s") or 0.0) for t in cur["trained"].values())),
        selfplay_cpu_s=c2(sum(p.get("cpu", 0.0) for p in sp)),
        selfplay_gen_cpu_s=c2(sum(p.get("gen_cpu", 0.0) for p in sp)),
        cal_cpu_s=c2(sum(cur["cal"].values())), cal_made=cur["cal_made"],
        new_champions=ev_names.count("new-champion"), retired=ev_names.count("retired"),
        anchors_locked=ev_names.count("anchor-locked"), anchors_replaced=ev_names.count("anchor-replaced"),
        global_rounds=len(k.get("rounds", [])) if k else "", global_cpu_s=c2(k.get("cpu_s")) if k else "",
        global_ply2_cpu_s=c2(k.get("ply2_cpu_s")) if k else "", wait_s=e1(cur.get("wait_s", 0.0)),
        data_cpu_target_s=c2(cur.get("data_cpu_target_s")),
        tournament_proc_cpu_s=c2(cur.get("tournament_proc_cpu_s")),
        price_s=c2(sum(r["price_s"] for r in rounds)), ply2_price_s=c2(sum(r["ply2_price_s"] for r in rounds)),
        global_price_s=c2(k.get("price_s")) if k else "", global_ply2_price_s=c2(k.get("ply2_price_s")) if k else "",
        global_carry_s=c2(new_st.get("global_carry_s")) if any(x["option"] == "global" for x in cfg["lines"]) else "",
        data_price_target_s=c2(cur.get("data_price_target_s")),
        selfplay_price_s=c2(sum(p.get("gen_price", 0.0) for p in sp)) if cur["selfplay"] else "",
        prices_version=cfg["prices"]["version"])
    totals_fields = TOTALS_FIELDS
    if cfg.get("self_games"):  # the self-games' columns, and self_games.csv, only in a league with them
        g = cur.get("self_games") or {}
        total.update(self_games=g.get("games", 0), self_games_plies=g.get("plies", 0),
                     self_games_price_s=c2(g.get("price_s", 0.0)), self_games_proc_cpu_s=c2(g.get("proc_cpu_s", 0.0)),
                     self_games_wall_s=e1(g.get("wall_s", 0.0)))
        totals_fields = TOTALS_FIELDS + SELF_GAMES_TOTALS_FIELDS
        append_cycle_rows(L.p("self_games.csv"), SELF_GAMES_FIELDS, self_games_rows(L), c)
    append_cycle_rows(L.p("totals.csv"), totals_fields, [total], c)

    # entries.csv: every entry ever in the field, with its latest role
    next_field = [] if done else field_of(L, new_st, c + 1)
    nxt = {e["entry"]: e for e in next_field}
    reg = {r["entry"]: r for r in read_csv(L.p("entries.csv"))}
    now_names = {e["entry"] for e in cur["field"]}
    for e in cur["field"] + next_field:
        r = reg.get(e["entry"])
        cont = e["entry"] in nxt
        if r is None:
            r = reg[e["entry"]] = dict(entry=e["entry"], joined_cycle=c if e["entry"] in now_names else c + 1,
                                       left_cycle="")
        src = nxt.get(e["entry"], e)
        vn = ""
        if e["line"]:
            vn = L.vname(e["line"], e["version"], e["frozen"], new_st["lines"][e["line"]]["crowned"])
        r.update(line=e["line"], version=e["version"], version_name=vn, ply=e["ply"], role=src["role"],
                 in_field=1 if cont else 0, model_file="" if not e["line"] else L.model_path(e["line"], e["version"]),
                 spec=e["spec"])
        if not cont and not r.get("left_cycle"):
            r["left_cycle"] = c
        if cont:
            r["left_cycle"] = ""
    write_csv(L.p("entries.csv"), ENTRIES_FIELDS, list(reg.values()))

    # anchors.csv
    if L.is_global:
        arows = []
        for lo in sorted(new_st["anchors"], key=int):
            a = new_st["anchors"][lo]
            arows.append(dict(interval_lo=lo, interval_hi=int(lo) + cfg["anchors"]["step"], entry=a["entry"],
                              line=a["line"], version=a["version"],
                              version_name=L.vname(a["line"], a["version"], True,
                                                   new_st["lines"][a["line"]]["crowned"]),
                              locked_cycle=a["locked_cycle"], locked_elo=e1(a["locked_elo"]), elo=e1(a.get("elo")),
                              ci95=e1(a.get("ci95")), outside_streak=a["outside_streak"],
                              available=1 if a["available"] else 0))
        write_csv(L.p("anchors.csv"), ANCHORS_FIELDS, arows)

    write_report(L, cur, new_st, rows, total, events)

    # the new state
    with L.mutex:
        new_st["cycle"] = c
        new_st["current"] = None
        new_st["phase"] = "idle"
        new_st["status"] = "done" if done else "running"
        L.state = new_st
    L.save(index=True)
    write_lines_csv(L)
    L.log(f"cycle {c} done" + ((" (experiment finished: plateau)" if plateau else " (experiment finished)")
                               if done else ""))

    # cleanup: the cycle's games (the global batch keeps its own links), sets, old training states, own games
    for d in ("pool", "trainsets", "copied") + (("selfpool",) if cfg.get("self_games") else ()):
        shutil.rmtree(L.p(d), ignore_errors=True)
    for line, ls in new_st["lines"].items():
        rd = L.p("runs", line)
        kind = L.lines[line]["kind"]
        if not os.path.isdir(rd):
            continue
        for f in os.listdir(rd):
            m = re.fullmatch(re.escape(kind) + r"(\d+)\.state", f)
            if m and int(m.group(1)) < ls["version"]:
                os.remove(os.path.join(rd, f))
    own_gc(L, {own_key(e["line"], e["version"]) for e in next_field if e["line"]})


def write_lines_csv(L):
    rows = []
    st = L.state
    for lc in L.cfg["lines"]:
        ls = st["lines"][lc["line"]]
        rows.append(dict(line=lc["line"], model=lc["model"], option=lc["option"], kind=lc["kind"],
                         archetype=lc["archetype"], status=ls["status"], version=ls["version"],
                         version_name=L.vname(lc["line"], ls["version"]), champion=ls["champion"],
                         champion_name=L.vname(lc["line"], ls["champion"]),
                         patience=ls["patience"] if L.is_global else "", entered_cycle=lc["entered_cycle"],
                         retired_cycle=ls["retired_cycle"], train_binary=os.path.relpath(lc["train_binary"], REPO),
                         train_args=shlex.join(lc["train_args"]),
                         selfplay_binary=os.path.relpath(lc["selfplay_binary"], REPO) if lc["selfplay_binary"] else "",
                         selfplay_args=shlex.join(lc["selfplay_args"]) if lc["selfplay_args"] else "",
                         label=lc.get("label", lc["model"]), base_model=lc.get("base_model", lc["model"]),
                         train_overrides=" ".join(override_token(f, v) for f, v in lc.get("train_overrides", [])),
                         selfplay_overrides=" ".join(override_token(f, v)
                                                     for f, v in lc.get("selfplay_overrides", [])),
                         replicate=lc.get("replicate", 1), seed_offset=lc.get("seed_offset", 0)))
    write_csv(L.p("lines.csv"), LINES_FIELDS, rows)


def plural(n, one, many=None):
    return f"{n} {one if n == 1 else (many or one + 's')}"


def write_report(L, cur, new_st, rows, total, events):
    c, cfg = cur["cycle"], L.cfg
    out = [f"# {cfg['name']}: cycle {c}", "",
           f"{cfg['kind'].capitalize()} league. {total['start']} to {total['end']} ({total['wall_s']} s wall).", ""]
    r = cur["rounds"]
    p = entry_ply(cfg)
    out.append(f"- Field: {plural(total['field'], 'entry', 'entries')}; {plural(len(r), 'round')} (tournaments "
               f"{r[0]['t']}-{r[-1]['t']}), {plural(total['games'], 'game')}, {total['ply2_games']} with a model at "
               f"ply {p}." if r else "- No rounds.")
    if cfg.get("self_games"):
        g = cur.get("self_games") or {}
        out.append(f"- Self-games: {plural(g.get('games', 0), 'game')} "
                   f"({plural(g.get('entries', 0), 'entry', 'entries')} x {plural(g.get('rounds', 0), 'round')}), "
                   f"{g.get('plies', 0)} plies, priced "
                   f"{g.get('price_s', 0.0):.2f} s; training games only (not in the ratings), in the local data's "
                   f"price {total['data_price_target_s']} s.")
    out.append(f"- Priced CPU (prices {total['prices_version']}): games {total['price_s']} s (ply {p}: "
               f"{total['ply2_price_s']} s)" + (f", self-play generation {total['selfplay_price_s']} s"
                                                if total['selfplay_price_s'] != "" else "") + ".")
    out.append(f"- Measured CPU: games {total['tournament_cpu_s']} s (ply {p}: {total['ply2_cpu_s']} s), tournament "
               f"process {total['tournament_proc_cpu_s']} s, training {total['train_cpu_s']} s, self-play "
               f"{total['selfplay_cpu_s']} s (generation {total['selfplay_gen_cpu_s']} s), calibration "
               f"{total['cal_cpu_s']} s ({plural(total['cal_made'], 'version')})"
               + (f", self-games {total['self_games_proc_cpu_s']} s" if cfg.get("self_games") else "") + ".")
    if cur.get("copied"):
        k = cur["copied"]
        out.append(f"- Copied global cycle {k['global_cycle']} rounds {' '.join(str(x['t']) for x in k['rounds'])}: "
                   f"ply-2 price {k['ply2_price_s']:.1f} s, carry {k['carry_before_s']:.1f} s; "
                   f"{cur['rounds_planned']} rounds at an estimated {k['est_round_ply2_price_s']:.1f} s each "
                   f"({k['estimate']}). Global carry after the cycle: {new_st.get('global_carry_s', 0.0):.1f} s. "
                   f"Waited {cur.get('wait_s', 0)} s.")
    if p == 2:
        out += ["", "| line | version | ply 1 | ply 2 | champion | ply 2 | diff | z | decision | next |",
                "|---|---|---:|---:|---|---:|---:|---:|---|---|"]
    else:  # no ply-1 entries besides the main ones (create refuses them): one Elo column per version
        out += ["", f"| line | version | ply {p} | champion | ply {p} | diff | z | decision | next |",
                "|---|---|---:|---|---:|---:|---:|---|---|"]
    for row in rows:
        out.append(f"| {row['line']} | {row['version_name']} | " + (f"{row['elo1']} | " if p == 2 else "")
                   + f"{row['elo2']} | {row['champion_name']} | {row['champion_elo']} | {row['diff']} | {row['z']} | "
                   f"{row['decision']}{' ' + row['new_name'] if row['new_name'] else ''} | {row['next_version']} |")
    if L.is_global and new_st["anchors"]:
        out += ["", "| interval | anchor | version | locked | Elo | outside | available |", "|---|---|---|---|---:|---:|---|"]
        for lo in sorted(new_st["anchors"], key=int):
            a = new_st["anchors"][lo]
            out.append(f"| {lo}-{int(lo) + cfg['anchors']['step']} | {a['entry']} | "
                       f"{L.vname(a['line'], a['version'], True, new_st['lines'][a['line']]['crowned'])} | "
                       f"cycle {a['locked_cycle']} at {e1(a['locked_elo'])} | {e1(a.get('elo'))} | "
                       f"{a['outside_streak']} | {'yes' if a['available'] else 'no'} |")
    ev = [e for e in events if e["event"] not in ("first-champion",)]
    if ev:
        out += ["", "Events:"]
        out += [f"- {e['event']} {e['line']} {e['entry']} {e['version_name']} {e['value']} {e['detail']}".rstrip()
                for e in ev]
    atomic_write(L.p(f"cycle-{c:03d}.md"), "\n".join(out) + "\n")


# ---------------------------------------------------------------- run

PHASES_GLOBAL = ["calibration", "tournament", "batch", "decide", "train", "records"]
PHASES_EXPERIMENT = ["copy", "calibration", "tournament", "decide", "train", "self-play", "records"]


def phases_of(L):
    """The league's phases: its kind's, with self-games after decide when the config has "self_games": true."""
    phases = PHASES_GLOBAL if L.is_global else PHASES_EXPERIMENT
    if L.cfg.get("self_games"):
        i = phases.index("decide") + 1
        phases = phases[:i] + ["self-games"] + phases[i:]
    return phases


def run_cycle(L):
    cur = start_cycle(L)
    c = cur["cycle"]
    phases = phases_of(L)
    with_global = any(lc["option"] == "global" for lc in L.cfg["lines"])
    while True:
        phase = cur["phase"]
        if phase == "waiting":
            phase = "copy"
        inject(c, phase)
        if phase == "copy":
            if with_global:
                phase_copy(L, cur)
        elif phase == "calibration":
            phase_calibration(L, cur)
        elif phase == "tournament":
            phase_tournament(L, cur)
        elif phase == "batch":
            publish_batch(L, cur)
        elif phase == "decide":
            phase_decide(L, cur)
        elif phase == "self-games":
            phase_selfgames(L, cur)
        elif phase == "train":
            phase_train(L, cur)
        elif phase == "self-play":
            phase_selfplay(L, cur)
        elif phase == "records":
            phase_records(L, cur)
            return
        else:
            raise RuntimeError(f"unknown phase {phase}")
        L.set_phase(phases[phases.index(phase) + 1])


def cmd_run(ldir, cycles):
    L = League(ldir)
    if L.us is None:
        sys.exit(f"{L.dir}: made before prices (no prices in config.json); create the league again")
    lock = FileLock(L.p(".lock"), block=False)
    try:
        lock.__enter__()
    except OSError:
        sys.exit(f"{L.dir}: another driver runs this league")
    signal.signal(signal.SIGTERM, on_signal)
    signal.signal(signal.SIGINT, on_signal)
    ran = 0
    try:
        L.state["pid"] = os.getpid()
        if L.state["status"] == "done":
            L.log("the experiment is done")
            return EXIT_DONE
        L.save(index=True)
        while cycles is None or ran < cycles:
            if not L.state.get("current"):
                if L.cfg["kind"] == "experiment" and L.state["cycle"] >= L.cfg["cycles"]:
                    L.state["status"] = "done"
                    L.save(index=True)
                    return EXIT_DONE
                check_stop(L)
            run_cycle(L)
            ran += 1
            if L.state["status"] == "done":
                L.state["pid"] = None
                L.save(index=True)
                return EXIT_DONE
        L.state["status"] = "stopped"
        L.state["pid"] = None
        L.save(index=True)
        return 0
    except SystemExit as e:
        if e.code == EXIT_INJECTED:
            L.state["status"] = "stopped"
            L.state["pid"] = None
            L.save(index=True)
        raise
    except Interrupted as e:
        L.log(f"interrupted ({e}); the cycle resumes on the next run")
        L.state["status"] = "stopped"
        L.state["pid"] = None
        L.save(index=True)
        return 130
    except Exception as e:
        L.log(f"failed: {type(e).__name__}: {e}")
        L.state["status"] = "failed"
        L.state["pid"] = None
        L.save(index=True)
        raise
    finally:
        lock.__exit__(None, None, None)


# ---------------------------------------------------------------- status

def cmd_status(path):
    path = os.path.abspath(path)
    if os.path.exists(os.path.join(path, "config.json")):
        L = League(path)
        st, cfg = L.state, L.cfg
        s = league_summary(cfg["root"], L.dir)
        print(f"{cfg['name']} ({cfg['kind']}): {s['status']}, cycle {st['cycle']}"
              + (f" of {cfg['cycles']}" if cfg.get("cycles") else "")
              + (f", in cycle {st['current']['cycle']} phase {st['phase']}" if st.get("current") else ""))
        if cfg.get("plateau"):
            pl = cfg["plateau"]
            print(f"plateau rule: ends after {pl['cycles']} cycles without a new champion (not before cycle "
                  f"{pl['min_cycles']}; at most {cfg['cycles']}); the last crowning was in cycle "
                  f"{st.get('last_crown_cycle', '-')}"
                  + (f" (K scaled: round({pl['scaled']['k2']} x sqrt(2 / {pl['scaled']['lines']} lines)))"
                     if pl.get("scaled") else ""))
        if "entry_ply" in cfg or "self_games" in cfg:
            print(f"entries at ply {entry_ply(cfg)}; self-games {'on' if cfg.get('self_games') else 'off'}")
        print(f"{'line':32s} {'status':8s} {'version':12s} {'champion':12s} patience")
        for lc in cfg["lines"]:
            ls = st["lines"][lc["line"]]
            print(f"{lc['line']:32s} {ls['status']:8s} {L.vname(lc['line'], ls['version']):12s} "
                  f"{L.vname(lc['line'], ls['champion']):12s} {ls['patience'] if L.is_global else ''}")
        if st["anchors"]:
            print("anchors: " + ", ".join(f"{lo}: {a['entry']}{' (available)' if a['available'] else ''}"
                                          for lo, a in sorted(st["anchors"].items(), key=lambda x: int(x[0]))))
        t = read_csv(L.p("totals.csv"))
        if t:
            x = t[-1]
            print(f"last cycle {x['cycle']}: {x['games']} games, priced {x.get('price_s', '')} s "
                  f"(prices {x.get('prices_version', '')}); measured: game CPU {x['tournament_cpu_s']} s, train "
                  f"{x['train_cpu_s']} s, self-play {x['selfplay_cpu_s']} s, calibration {x['cal_cpu_s']} s, "
                  f"wall {x['wall_s']} s")
        return
    write_index(path)
    idx = read_json(os.path.join(path, "index.json"))
    for x in idx["leagues"]:
        print(f"{x['name']:24s} {x['kind']:10s} {x['status']:8s} cycle {x['cycle']}"
              + (f"/{x['cycles_planned']}" if x["cycles_planned"] else "")
              + f"  {plural(len(x['models']), 'model')} x {','.join(x['options'])} = {plural(x['lines'], 'line')}")


def cmd_stop(ldir):
    L = League(ldir)
    open(L.p("STOP"), "w").close()
    print(f"{L.p('STOP')} written: the driver stops after the current cycle (or while waiting)")


# ---------------------------------------------------------------- selftest

def selftest(dirpath, quick):
    ok = []

    def check(name, cond, detail=""):
        if not cond:
            raise AssertionError(f"{name}: {detail}")
        ok.append(name)

    # version names
    check("names: entering version", version_name("G", [0], 0) == "G.0.0")
    check("names: crowned version takes the new major",
          [version_name("G", [0, 5], v) for v in (4, 5, 6)] == ["G.0.4", "G.1.5", "G.1.6"])
    check("names: majors count crownings after the first",
          [version_name("G", [0, 5, 9], v) for v in (8, 9, 12)] == ["G.1.8", "G.2.9", "G.2.12"])
    check("names: frozen anchor", version_name("G", [0, 5], 7, frozen=True) == "G.1.7F")
    check("names: experiments carry their option's letter",
          [version_name(option_prefix("experiment", o), [0, 3], 3) for o in ("self-play", "local", "global")]
          == ["E.S.1.3", "E.L.1.3", "E.G.1.3"] and option_prefix("global", "global") == "G")
    check("names: entries", entry_name("F-L", 7, 1, True) == "F-L@7F-1" and parse_entry("F-L.sp@12-2") ==
          ("F-L.sp", 12, False, 2) and parse_entry("random-2") is None)

    # the ply-2 filter
    check("ply-2 filter", qualifies("F-L@3-2", "random") and qualifies("random-1", "T@0-2")
          and not qualifies("random-2", "F-L@3-1") and not qualifies("F-L@3F-1", "random-2")
          and not qualifies("A@1-1", "B@2-1") and qualifies("A@1-1", "B@2-2"))

    # champion test
    d, diff, z = champion_decision(130.0, 100.0, 15.0, 2.0)
    check("champion: z >= 2 crowns", d == "new-champion" and abs(z - 2.0) < 1e-9 and diff == 30.0)
    check("champion: z < 2 keeps", champion_decision(129.0, 100.0, 15.0, 2.0)[0] == "champion-kept")
    check("champion: missing rating", champion_decision(None, 100.0, 15.0, 2.0)[0] == "unrated")
    check("champion: no SE", champion_decision(150.0, 100.0, None, 2.0)[0] == "unrated")
    # its SE: a synthetic fit; compare with the dense inverse of the information matrix
    tmp = tempfile.mkdtemp(prefix="selftest-", dir=dirpath)
    with open(os.path.join(tmp, "games.csv"), "w") as f:
        f.write("tournament,white,black,result,plies\n")
        pl = ["random", "a", "b", "c"]
        k = 0
        for i in range(4):
            for j in range(4):
                if i != j:
                    for _ in range(5 + 3 * i + j):
                        f.write(f"{k},{pl[i]},{pl[j]},1-0,50\n")
                        k += 1
    rat = {"random": (0.0, 0, 0), "a": (100.0, 0, 0), "b": (180.0, 0, 0), "c": (40.0, 0, 0)}
    se = contrast_ses(tmp, rat, [(["b"], ["a"]), (["c"], ["random"])])
    # dense: information over a, b, c
    names = ["a", "b", "c"]
    cnt = {}
    for line in open(os.path.join(tmp, "games.csv")).readlines()[1:]:
        _, w, b, _ = line.split(",", 3)
        key = tuple(sorted((w, b)))
        cnt[key] = cnt.get(key, 0) + 1
    w2 = (math.log(10) / 400) ** 2
    info = [[0.0] * 3 for _ in range(3)]
    for (x, y), n in cnt.items():
        p = 1 / (1 + 10 ** (-(rat[x][0] - rat[y][0]) / 400))
        w = n * p * (1 - p) * w2
        for u in (x, y):
            if u in names:
                info[names.index(u)][names.index(u)] += w
        if x in names and y in names:
            info[names.index(x)][names.index(y)] -= w
            info[names.index(y)][names.index(x)] -= w
    inv = invert3(info)
    want_ba = math.sqrt(inv[1][1] + inv[0][0] - 2 * inv[0][1])
    want_c = math.sqrt(inv[2][2])
    check("champion: SE from the fit's covariance", abs(se[0] - want_ba) < 1e-9 and abs(se[1] - want_c) < 1e-9,
          f"{se} vs {want_ba}, {want_c}")
    se_a = contrast_ses(tmp, rat, [(["b"], ["a"]), (["c"], ["random"])], anchor="a")
    check("champion: a contrast's SE doesn't depend on the pinned player", se_a is not None
          and all(abs(x - y) < 1e-9 for x, y in zip(se, se_a)), f"{se} vs {se_a}")

    # batch-4 options: the plateau rule, the field without ply-1 entries, the rating zero
    rules = dict(cycles=50, min_cycles=100)
    check("plateau: not before min_cycles", not plateau_stop(99, 40, rules) and plateau_stop(100, 40, rules))
    check("plateau: K cycles since the last crowning", not plateau_stop(109, 60, rules) and plateau_stop(110, 60, rules)
          and not plateau_stop(150, 150, rules) and plateau_stop(3, 1, dict(cycles=2)))

    class FakeL:
        pass

    fl0 = FakeL()
    fl0.spec = lambda line, v: f"spec-{line}-{v}"
    fl0.p = lambda *parts: os.path.join(tmp, *parts)
    st0 = dict(lines={"X": dict(status="active", version=3, champion=1), "Y": dict(status="active", version=2,
                                                                                  champion=2)}, anchors={})
    xl = [dict(line="X", entered_cycle=1), dict(line="Y", entered_cycle=1)]
    fl0.cfg = dict(references=[], ply1_entries=False, lines=xl)
    check("field: without references and ply-1 entries, current and champion at ply 2",
          [(e["entry"], e["role"]) for e in field_of(fl0, st0, 4)] == [("X@3-2", "current"), ("X@1-2", "champion"),
                                                                       ("Y@2-2", "current+champion")])
    fl0.cfg = dict(references=["random"], lines=xl)
    check("field: by default the references and ply-1 entries are in",
          [e["entry"] for e in field_of(fl0, st0, 4)] == ["random", "X@3-1", "X@3-2", "X@1-2", "Y@2-1", "Y@2-2"])
    fl0.cfg = dict(references=[], ply1_entries=False, lines=xl, entry_ply=1)
    f1 = field_of(fl0, st0, 4)
    check("entry ply: the main entries at the config's entry_ply",
          [(e["entry"], e["ply"], e["role"]) for e in f1] == [("X@3-1", 1, "current"), ("X@1-1", 1, "champion"),
                                                               ("Y@2-1", 1, "current+champion")])
    check("entry ply: 2 when absent", entry_ply({}) == 2 and entry_ply(dict(entry_ply=1)) == 1)
    check("entry ply: the training rule at the entry ply", qualifies("A@1-1", "B@2-1", 1)
          and qualifies("A@1-1", "random-2", 1) and not qualifies("random-1", "random", 1)
          and not qualifies("A@1-2", "B@2-2", 1) and qualifies("A@1-2", "B@2-2") and not qualifies("A@1-1", "B@2-1"))
    fl2 = FakeL()
    fl2.spec = fl0.spec
    fl2.cfg = dict(references=["random", "random-2"], lines=xl)
    f2 = field_of(fl2, st0, 4)
    check("self-games: the entries whose game against itself qualifies, in field order",
          [e["entry"] for e in self_game_entries(fl0, f1)] == ["X@3-1", "X@1-1", "Y@2-1"]
          and [e["entry"] for e in f2] == ["random", "random-2", "X@3-1", "X@3-2", "X@1-2", "Y@2-1", "Y@2-2"]
          and [e["entry"] for e in self_game_entries(fl2, f2)] == ["X@3-2", "X@1-2", "Y@2-2"])
    fl2.is_global = False
    pe = phases_of(fl2)
    fl2.cfg = dict(fl2.cfg, self_games=True)
    ps = phases_of(fl2)
    fl2.is_global = True
    pg = phases_of(fl2)
    check("self-games: a phase only with self_games, after decide", pe == PHASES_EXPERIMENT and ps == [
        "copy", "calibration", "tournament", "decide", "self-games", "train", "self-play", "records"] and pg == [
        "calibration", "tournament", "batch", "decide", "self-games", "train", "records"])
    check("plateau: scaled K = round(k2 x sqrt(2 / lines))",
          [scaled_plateau_cycles(50, n) for n in (1, 2, 3, 4, 8, 14, 32)] == [71, 50, 41, 35, 25, 19, 13]
          and scaled_plateau_cycles(25, 8) == 13 and scaled_plateau_cycles(0.1, 50) == 1)
    os.makedirs(os.path.join(tmp, "tour"))
    with open(os.path.join(tmp, "tour", "ratings.csv"), "w") as f:
        f.write("rank,player,elo,ci95,running,games,score,wins,losses,draws,plies\n"
                "1,X@3-2,40.5,20.0,0,10,60,5,3,2,50\n2,X@0-2,-10.0,25.0,0,10,40,3,5,2,50\n")
    fl0.cfg = dict(rating_zero="X@0-2")
    rz = league_ratings(fl0)
    check("rating zero: ratings re-centred on it, the SE pinned at it",
          rz == {"X@3-2": (50.5, 20.0, 10), "X@0-2": (0.0, 25.0, 10)} and fit_pin(fl0, rz) == "X@0-2")
    fl0.cfg = dict(rating_zero="Z@0-2")
    rz = league_ratings(fl0)
    check("rating zero: while unrated, ratings as given, a rated player pinned",
          rz["X@3-2"][0] == 40.5 and fit_pin(fl0, rz) == "X@0-2")
    fl0.cfg = dict(references=["random"])
    check("rating zero: none by default (random is the anchor)", league_ratings(fl0)["X@3-2"][0] == 40.5
          and fit_pin(fl0, {}) == ANCHOR)

    # anchors
    rules = dict(step=100, margin=25, out_cycles=5, lowest=100)
    a, ev, leave = anchor_update({}, [("X@3-1", "X", 3, 250.0), ("Y@2-1", "Y", 2, 280.0), ("Z@1-1", "Z", 1, 90.0),
                                      ("W@4-1", "W", 4, 512.0)], {}, 1, rules)
    check("anchors: lock-in, ties to the higher rating", a["200"]["entry"] == "Y@2F-1" and a["500"]["entry"] ==
          "W@4F-1" and "100" not in a and "0" not in a and len(a) == 2 and [e[0] for e in ev] == ["anchor-locked"] * 2)
    a2, ev2, _ = anchor_update(a, [("X@4-1", "X", 4, 260.0)], {"Y@2F-1": (230.0, 20.0), "W@4F-1": (500.0, 20.0)}, 2,
                               rules)
    check("anchors: a held interval stays held", a2["200"]["entry"] == "Y@2F-1" and not ev2)
    a3, ev3, _ = anchor_update(a, [("Q@1-1", "Q", 1, 333.0)], {}, 2, rules)
    check("anchors: a jump fills only the interval it lands in", set(a3) == {"200", "300", "500"})
    # margin: 25 outside counts only beyond the margin; a cycle back inside resets the streak
    s = a
    for cyc, elo in enumerate([180.0, 174.0, 174.0, 174.0, 174.0], start=2):
        s, ev, _ = anchor_update(s, [], {"Y@2F-1": (elo, 20.0)}, cyc, rules)
    check("anchors: within the margin is not outside", s["200"]["outside_streak"] == 4 and not s["200"]["available"])
    s, ev, _ = anchor_update(s, [], {"Y@2F-1": (210.0, 20.0)}, 7, rules)
    check("anchors: back inside resets the streak", s["200"]["outside_streak"] == 0)
    for cyc in range(8, 12):
        s, ev, _ = anchor_update(s, [], {"Y@2F-1": (330.0, 20.0)}, cyc, rules)
    check("anchors: 4 cycles outside keep the interval", not s["200"]["available"])
    s, ev, leave = anchor_update(s, [("X@9-1", "X", 9, 50.0)], {"Y@2F-1": (330.0, 20.0)}, 12, rules)
    check("anchors: 5 straight cycles outside give the interval up", s["200"]["available"]
          and [e[0] for e in ev] == ["anchor-available"] and s["200"]["entry"] == "Y@2F-1" and not leave)
    s, ev, leave = anchor_update(s, [("X@10-1", "X", 10, 201.0), ("V@3-1", "V", 3, 299.0)],
                                 {"Y@2F-1": (330.0, 20.0)}, 13, rules)
    check("anchors: the next entry to land replaces it; the old one leaves then",
          s["200"]["entry"] == "V@3F-1" and leave == ["Y@2F-1"] and [e[0] for e in ev] == ["anchor-replaced",
                                                                                         "anchor-locked"])
    s2, _, _ = anchor_update(s, [("V@3-1", "V", 3, 420.0)], {}, 14, rules, used_entries=["V@3F-1"])
    check("anchors: a version anchors once", "400" not in s2)
    s3, _, _ = anchor_update(s, [("U@1-1", "U", 1, -40.0), ("U2@1-1", "U2", 1, 60.0)], {}, 14, rules)
    check("anchors: none below the lowest interval", set(s3) == set(s))

    # prices: a fixed formula over plies and constants
    us = {"tournament lr 2": (100.0, 10.0), "tournament random 0": (50.0, 1.0), "tournament lr 1": (0.0, 2.0),
          "self-play lr 0": (40.0, 3.0)}
    check("prices: moves of each side", moves_of(5) == (3, 2) and moves_of(6) == (3, 3) and moves_of(0) == (0, 0))
    check("prices: a game is each side's per-game price plus its moves' prices",
          abs(game_price(us, ("lr", 2), ("random", 0), 5) - (100 + 3 * 10 + 50 + 2 * 1) / 1e6) < 1e-15)
    check("prices: a self-play round is 2 x games x per game plus plies x per ply",
          abs(selfplay_round_price(us, "lr", 0, 10, 1000) - (2 * 10 * 40 + 1000 * 3) / 1e6) < 1e-15)
    pr = pricer(us, {"F-L.loc": "lr"})
    check("prices: players' sides (references at their ply, entries their line's kind at the entry's ply)",
          side_of("random", {}) == ("random", 0) and side_of("F-L.loc@3F-2", {"F-L.loc": "lr"}) == ("lr", 2)
          and pr("F-L.loc@3-2", "random", 5) == game_price(us, ("lr", 2), ("random", 0), 5))
    check("prices: deterministic", [pr("F-L.loc@3-2", "random", p) for p in range(300)]
          == [pr("F-L.loc@3-2", "random", p) for p in range(300)])
    check("prices: a config's table round-trips", prices_of_config(config_prices("T", us)) == us
          and prices_of_config({"version": "old", "us_per_ply": {"tournament lr 2": 7.0}})
          == {"tournament lr 2": (0.0, 7.0)})
    pcsv = os.path.join(tmp, "prices.csv")
    write_csv(pcsv, PRICES_FIELDS, [
        dict(version="A", context="tournament", kind="lr", depth=2, us_per_game="1", us_per_ply="2"),
        dict(version="B", context="tournament", kind="lr", depth=2, us_per_game="3", us_per_ply="4"),
        dict(version="B", context="self-play", kind="lr", depth=0, us_per_game="5", us_per_ply="6")])
    check("prices: versions; the last is the default", load_prices(path=pcsv) == (
        "B", {"tournament lr 2": (3.0, 4.0), "self-play lr 0": (5.0, 6.0)})
        and load_prices("A", path=pcsv) == ("A", {"tournament lr 2": (1.0, 2.0)}))
    try:
        load_prices("C", path=pcsv)
        check("prices: an unknown version is refused", False)
    except SystemExit:
        check("prices: an unknown version is refused", True)
    pcfg = dict(references=["random", "random-1"], prices=config_prices("T", us), lines=[
        dict(line="F-L.sp", kind="lr", option="self-play", selfplay_args=["--depth", "2"]),
        dict(line="T.loc", kind="bdt", option="local", selfplay_args=None)])
    check("prices: the keys a league needs", needed_prices(pcfg) == {
        "tournament random 0", "tournament random 1", "tournament lr 1", "tournament lr 2", "self-play lr 2",
        "tournament bdt 1", "tournament bdt 2"})
    try:
        check_prices(pcfg)
        check("prices: a league with a kind the version lacks is refused", False)
    except SystemExit as e:
        check("prices: a league with a kind the version lacks is refused", "tournament bdt 1" in str(e), str(e))
    grows = [dict(t=7, white="F-L.loc@3-2", black="random", plies="5", ply2=True, cpu_s=0.5),
             dict(t=7, white="F-L.loc@3-1", black="random", plies="4", ply2=False, cpu_s=None),
             dict(t=8, white="random", black="F-L.loc@3-2", plies="6", ply2=True, cpu_s=0.25)]
    for r in grows:
        r["price_s"] = pr(r["white"], r["black"], r["plies"])
    rs = round_stats(grows, 7, 2, 2, {})
    check("prices: rounds' prices and qualifying prices",
          abs(rs[0]["price_s"] - (grows[0]["price_s"] + grows[1]["price_s"])) < 1e-15
          and rs[0]["ply2_price_s"] == grows[0]["price_s"] and rs[1]["ply2_price_s"] == grows[2]["price_s"]
          and rs[0]["estimated"] == 1, f"{rs}")

    # data equalisation and global-round selection, priced; the global carry
    batch = dict(cycle=7, rounds=[dict(t=t, ply2_price_s=c) for t, c in [(30, 50.0), (31, 60.0), (32, 70.0),
                                                                          (33, 80.0)]])
    chosen, n, tot = plan_copy(batch, set(), 25.0, 5)
    check("copy: fewest newest rounds covering 5 rounds", [r["t"] for r in chosen] == [32, 33] and n == 6
          and tot == 150.0, f"{chosen} {n} {tot}")
    chosen, n, tot = plan_copy(batch, {(7, 33), (7, 32)}, 20.0, 5)
    check("copy: never reuses a round", [r["t"] for r in chosen] == [30, 31] and n == 6, f"{chosen} {n}")
    check("copy: waits when all are used", plan_copy(batch, {(7, t) for t in (30, 31, 32, 33)}, 20.0, 5) is None)
    check("copy: waits when the unused rest can't cover", plan_copy(batch, {(7, 33), (7, 32)}, 30.0, 5) is None)
    chosen, n, tot = plan_copy(batch, set(), 100.0, 5)
    check("copy: a whole unused batch too small for 5 rounds is taken", len(chosen) == 4 and n == 3, f"{n}")
    check("copy: no batch", plan_copy(None, set(), 10.0, 5) is None)
    chosen, n, tot = plan_copy(batch, set(), 25.0, 5, carry=60.0)
    check("copy: a lead carried from earlier cycles needs less copied", [r["t"] for r in chosen] == [33] and n == 6
          and tot == 80.0, f"{chosen} {n}")
    chosen, n, tot = plan_copy(batch, set(), 25.0, 5, carry=-40.0)
    check("copy: a trail carried needs more copied, and plays the rounds net of it",
          [r["t"] for r in chosen] == [31, 32, 33] and n == 7 and tot == 210.0, f"{chosen} {n}")
    chosen, n, tot = plan_copy(batch, set(), 25.0, 5, carry=500.0)
    check("copy: at least one round is copied", [r["t"] for r in chosen] == [33] and n == 23, f"{chosen} {n}")
    moves, fb = class_moves([dict(white="A@1-2", black="random", plies="9"),
                             dict(white="A@2-2", black="random", plies="11"),
                             dict(white="A@1-1", black="B@1-2", plies="20")])
    check("estimate: mean moves by pair of classes", moves[(("m", 2), ("r", 0))] == (5.5, 4.5)
          and fb == ((5 + 6 + 10) / 3, (4 + 5 + 10) / 3), f"{moves} {fb}")
    ust = {"tournament lr 2": (100.0, 10.0), "tournament lr 1": (0.0, 2.0), "tournament random 0": (50.0, 1.0)}
    names = ["random", "C@0-2", "C@0-1"]
    est = estimate_round_ply2_price(names, {n: side_of(n, {"C": "lr"}) for n in names}, ust, moves, fb)
    want = ((100 + 5.5 * 10) + (50 + 4.5 * 1)  # C@0-2 v random: its class pair's mean moves
            + (50 + 7 * 1) + (100 + 19 / 3 * 10)  # random v C@0-2: a pair not seen, the mean over all
            + (100 + 7 * 10) + (0 + 19 / 3 * 2.0)  # C@0-2 v C@0-1: not seen either
            + (0 + 10 * 2.0) + (100 + 10 * 10)) / 1e6  # C@0-1 v C@0-2
    check("estimate: a round's qualifying price at the classes' mean moves", abs(est - want) < 1e-15,
          f"{est} vs {want}")
    est_sg = estimate_self_games_price(names, {n: side_of(n, {"C": "lr"}) for n in names}, ust, moves, fb)
    check("estimate: a round's self-games, each qualifying entry against itself at its class's mean moves (else "
          "the mean over all)", abs(est_sg - ((100 + 7 * 10) + (100 + 19 / 3 * 10)) / 1e6) < 1e-15, f"{est_sg}")
    est1 = estimate_round_ply2_price(names, {n: side_of(n, {"C": "lr"}) for n in names}, ust, moves, fb, 1)
    want1 = (((0 + 7 * 2.0) + (50 + 19 / 3 * 1)) + ((50 + 7 * 1) + (0 + 19 / 3 * 2.0))  # C@0-1 v random and back
             + ((100 + 7 * 10) + (0 + 19 / 3 * 2.0))  # C@0-2 v C@0-1: not seen
             + ((0 + 10 * 2.0) + (100 + 10 * 10))) / 1e6  # C@0-1 v C@0-2: seen
    check("estimate: at entry ply 1, the pairs with a model at ply 1", abs(est1 - want1) < 1e-15, f"{est1} {want1}")
    check("self-play: plan in priced s", selfplay_plan(100.0, 0.0, None, 0.25) == 1
          and selfplay_plan(100.0, 10.0, 1.0, 0.25) == 25 and selfplay_plan(100.0, 99.6, 1.0, 0.25) == 0
          and selfplay_plan(100.0, 80.0, 1.0, 0.25) == 20 and selfplay_plan(100.0, 0.0, 30.0, 0.25) == 1
          and selfplay_plan(100.0, 100.0, None, 0.25) == 0)

    # the self-play budget rule: self-play-only experiments take selfplay_budget_s (default 120), others refuse it
    base = dict(kind="experiment", root=tmp, name="b", models=["F-L"], cycles=2)
    _, c1 = make_config(dict(base, options=["self-play"]))
    _, c2 = make_config(dict(base, options=["self-play"], selfplay_budget_s=45))
    check("budget: self-play-only takes 120 priced s by default, or the spec's",
          c1["selfplay_budget_s"] == 120.0 and c2["selfplay_budget_s"] == 45.0)
    for bad in (dict(base, options=["self-play", "local"], selfplay_budget_s=45),
                dict(base, options=["self-play"], selfplay_budget_s=0)):
        try:
            make_config(bad)
            check(f"budget: refused {bad['options']} {bad['selfplay_budget_s']}", False)
        except SystemExit:
            check(f"budget: refused {bad['options']} {bad['selfplay_budget_s']}", True)
    _, c3 = make_config(dict(base, options=["self-play", "local"]))

    class Fake:
        pass

    fk = Fake()
    fk.cfg = c1
    fk2 = Fake()
    fk2.cfg = c3
    check("budget: the target is the fixed budget, or the local data's price",
          selfplay_target(fk, dict(data_price_target_s=7.0)) == 120.0
          and selfplay_target(fk2, dict(data_price_target_s=7.0)) == 7.0 and c3["selfplay_budget_s"] is None)
    _, b0 = make_config(dict(base, options=["local"]))
    _, b4 = make_config(dict(base, options=["local"], references=[], ply1_entries=False,
                             plateau={"cycles": 50, "min_cycles": 100}))
    check("batch-4 options: absent from a spec, absent from the config",
          not {"rating_zero", "ply1_entries", "plateau"} & set(b0) and b0["references"] == DEFAULTS["references"])
    check("batch-4 options: a spec's options in the config; without random, the first line's version 0 at ply 2 is "
          "the rating zero", b4["rating_zero"] == "F-L.loc@0-2" and b4["ply1_entries"] is False
          and b4["plateau"] == {"cycles": 50, "min_cycles": 100} and b4["references"] == [])
    for bad, why in ((dict(base, options=["local"], plateau={"cycles": 0}), "a plateau of 0 cycles"),
                     (dict(base, options=["local"], plateau={"cycles": 5, "after": 3}), "an unknown plateau key"),
                     (dict(base, options=["local"], ply1_entries="no"), "ply1_entries not a boolean"),
                     (dict(kind="global", root=tmp, models=["F-L"], references=["random-1"]), "a global league "
                      "without random"),
                     (dict(kind="global", root=tmp, models=["F-L"], ply1_entries=False), "a global league without "
                      "ply-1 entries"),
                     (dict(kind="global", root=tmp, models=["F-L"], plateau={"cycles": 5}), "a global plateau")):
        try:
            make_config(bad)
            check(f"batch-4 options: refuses {why}", False)
        except SystemExit:
            check(f"batch-4 options: refuses {why}", True)
    # the options of 2026-11-10 ~22:15-22:30: a scaled plateau, self-games, the entries' ply
    h9 = dict(binary=os.path.join(BIN, "chessai-hybrid9"))
    check("11-10 options: absent from a spec, absent from the config",
          not {"self_games", "entry_ply"} & set(b0) and "scaled" not in b4["plateau"])
    _, s1 = make_config(dict(base, options=["local", "self-play"], plateau={"scaled": True, "min_cycles": 100}))
    _, s2 = make_config(dict(base, models=["F-L", "F-P"], options=["local"],
                             plateau={"scaled": {"k2": 60}, "min_cycles": 7}))
    check("plateau: a scaled plateau's K from the lines, its inputs kept",
          s1["plateau"] == {"cycles": 50, "min_cycles": 100, "scaled": {"k2": 50, "lines": 2}}
          and s2["plateau"] == {"cycles": 60, "min_cycles": 7, "scaled": {"k2": 60, "lines": 2}}, f"{s1['plateau']}")
    _, g1 = make_config(dict(base, options=["local", "self-play"], self_games=True, tournament=h9))
    _, g0 = make_config(dict(base, options=["local"], self_games=False))
    check("self-games: the option in the config as given", g1["self_games"] is True and g0["self_games"] is False)
    _, e1c = make_config(dict(base, options=["local", "self-play"], entry_ply=1, references=[]))
    sp1 = [lc for lc in e1c["lines"] if lc["option"] == "self-play"][0]
    _, e1d = make_config(dict(base, models=[{"model": "F-L", "set": {"--depth": 0}, "to": "selfplay"}],
                              options=["self-play", "local"], entry_ply=1, references=[]))
    sp0 = [lc for lc in e1d["lines"] if lc["option"] == "self-play"][0]
    _, e1r = make_config(dict(base, models=["F-L-d2jit"], options=["self-play", "local"], entry_ply=1, references=[]))
    spr = [lc for lc in e1r["lines"] if lc["option"] == "self-play"][0]
    _, e2c = make_config(dict(base, options=["local", "self-play"], entry_ply=2))
    check("entry ply: in the config; with 1, no ply-1 entries, its version 0 the rating zero, the training rule at 1",
          e1c["entry_ply"] == 1 and e1c["ply1_entries"] is False and e1c["rating_zero"] == "F-L.sp@0-1"
          and e1c["train"]["qualify"] == "a model at ply 1" and e2c["entry_ply"] == 2 and "ply1_entries" not in e2c)
    check("entry ply: a self-play line plays at the entry ply unless the spec or the recipe sets --depth",
          selfplay_depth(sp1) == 1 and sp1["selfplay_depth_default"] == 1
          and sp1["selfplay_games"] == round_size(e1c["selfplay"]["round_anchor_games"], load_costs(), 1)
          and selfplay_depth(sp0) == 0 and "selfplay_depth_default" not in sp0
          and selfplay_depth(spr) == 2 and "selfplay_depth_default" not in spr
          and selfplay_depth([lc for lc in e2c["lines"] if lc["option"] == "self-play"][0]) == 2)
    for bad, why in ((dict(base, options=["local"], plateau={"scaled": True, "cycles": 5}), "a plateau with cycles "
                      "and scaled"),
                     (dict(base, options=["local"], plateau={"scaled": {"k2": 0}}), "a scaled plateau with k2 0"),
                     (dict(base, options=["local"], plateau={"scaled": False}), "a plateau scaled false"),
                     (dict(base, options=["local"], plateau={"scaled": {"k": 5}}), "an unknown scaled key"),
                     (dict(base, options=["local"], self_games="yes"), "self_games not a boolean"),
                     (dict(base, options=["self-play"], self_games=True, tournament=h9), "self-games without "
                      "local lines"),
                     (dict(base, options=["local"], self_games=True, tournament=dict(binary="/bin/false")),
                      "self-games without replay-games"),
                     (dict(base, options=["local"], entry_ply=3), "entry_ply 3"),
                     (dict(base, options=["local"], entry_ply=True), "entry_ply true"),
                     (dict(base, options=["local"], entry_ply=1, ply1_entries=True), "entry_ply 1 with ply-1 entries"),
                     (dict(kind="global", root=tmp, models=["F-L"], entry_ply=2), "entry_ply in the global league")):
        try:
            make_config(bad)
            check(f"11-10 options: refuses {why}", False)
        except SystemExit:
            check(f"11-10 options: refuses {why}", True)
    check("budget: a self-play line's games per round are fixed in the config",
          all(lc["selfplay_games"] == round_size(c1["selfplay"]["round_anchor_games"], load_costs(),
                                                 selfplay_depth(lc)) for lc in c1["lines"]))

    # model variants, sweeps, replicates and their seeds
    rec = load_recipes()
    vs = expand_models([{"model": "F-L", "sweep": {"--lr-rate": [0.025, 0.05]}, "replicates": 2},
                        {"model": "F-L", "set": {"--depth": 2}}, "F-P-tau0"], rec, ["self-play", "local"])
    check("variants: ids and labels", [v["id"] for v in vs] == [
        "F-L+lr-rate=0.025#1", "F-L+lr-rate=0.025#2", "F-L+lr-rate=0.05#1", "F-L+lr-rate=0.05#2",
        "F-L+depth=2", "F-P-tau0"] and [v["label"] for v in vs][:2] == ["F-L lr-rate=0.025 #1", "F-L lr-rate=0.025 #2"]
          and vs[4]["label"] == "F-L depth=2", f"{[v['id'] for v in vs]}")
    check("variants: auto puts a flag where the binaries take it",
          vs[0]["train_overrides"] == [("--lr-rate", "0.025")] and vs[0]["selfplay_overrides"] == [
              ("--lr-rate", "0.025")] and vs[4]["train_overrides"] == [] and vs[4]["selfplay_overrides"] == [
              ("--depth", "2")])
    grid = expand_models([{"model": "F-L", "sweep": {"--lr-rate": [0.1, 0.2], "--temperature": [0.3, 1]}}], rec,
                         ["self-play"])
    check("variants: a grid of two flags, first flag outermost", [v["id"] for v in grid] == [
        "F-L+lr-rate=0.1+temperature=0.3", "F-L+lr-rate=0.1+temperature=1", "F-L+lr-rate=0.2+temperature=0.3",
        "F-L+lr-rate=0.2+temperature=1"], f"{[v['id'] for v in grid]}")
    for bad, why in (([{"model": "F-L", "set": {"--no-such-flag": 1}}], "an unknown flag"),
                     ([{"model": "F-L", "set": {"--temperature": 1}, "to": "train"}], "a flag train doesn't take"),
                     ([{"model": "F-L", "set": {"--seed": 3}}], "the driver's flags"),
                     (["F-L", "F-L"], "a model twice"),
                     ([{"model": "F-L", "set": {"--depth": 2}}], "a self-play flag without self-play lines")):
        try:
            expand_models(bad, rec, ["local"] if why.startswith("a self-play flag") else ["self-play"])
            check(f"variants: refuses {why}", False)
        except SystemExit:
            check(f"variants: refuses {why}", True)
    lines = [experiment_line(v, "self-play") for v in vs[:2]]
    sd = [dict(parse_flags(x["selfplay_args"]))["--seed"] for x in lines]
    check("replicates: self-play seeds differ by the seed offset only", sd == ["21", "22"]
          and [x["line"] for x in lines] == ["F-L+lr-rate=0.025#1.sp", "F-L+lr-rate=0.025#2.sp"]
          and lines[0]["train_args"] == lines[1]["train_args"], f"{sd}")
    fk.cfg = dict(train=dict(seed=1000))
    check("replicates: training seeds", train_seed(fk, lines[0], 3) == 1003
          and train_seed(fk, lines[1], 3) == 1003 + REPLICATE_SEED_STEP and train_seed(fk, {}, 0) == 1000)
    moe = [r for r in rec if r["kind"] in INIT_SEED_FLAGS["--moe-seed"]]
    if moe:
        r0 = moe[0]
        a0 = seeded_args(r0["selfplay_args"], r0["selfplay_binary"], "self-play", r0["kind"], 0)
        a1 = seeded_args(r0["selfplay_args"], r0["selfplay_binary"], "self-play", r0["kind"], 1)
        base_moe = dict(parse_flags(a0)).get("--moe-seed") or binary_flags(r0["selfplay_binary"],
                                                                           "self-play")[1]["--moe-seed"]
        check("replicates: a mixture's initial-weight seed moves too", a0 == r0["selfplay_args"]
              and dict(parse_flags(a1))["--moe-seed"] == str(int(base_moe) + 1), f"{a1}")

    # self-play rounds: counts recovered from the log; a round saved without them is rolled back
    sp_dir = os.path.join(tmp, "runs", "X.sp", "sp")
    os.makedirs(sp_dir)
    for k in (1, 2, 3):
        for e in ("model", "state"):
            open(os.path.join(sp_dir, f"lr{k}.{e}"), "w").close()
    with open(os.path.join(sp_dir, "ladder.csv"), "w") as f:
        f.write("round,x\n0,a\n1,b\n2,c\n")
    with open(os.path.join(tmp, "runs", "X.sp.log"), "w") as f:
        f.write("round 0: +2 -1 =1, 300 plies, play 0.1s (3000 plies/s), train 0.1s\n"
                "round 1: +1 -1 =2, 200 plies, play 0.1s (2000 plies/s), train 0.1s\n")
    fl = Fake()
    fl.p = lambda *parts: os.path.join(tmp, *parts)
    fl.us = {"self-play lr 0": (40.0, 3.0)}
    fl.logged = []
    fl.log = fl.logged.append
    v, counts = sync_selfplay(fl, dict(line="X.sp", kind="lr", selfplay_args=[]))
    check("self-play: counts from the log, a round without them rolled back", v == 2
          and counts == {0: (4, 300), 1: (4, 200)} and not os.path.exists(os.path.join(sp_dir, "lr3.model"))
          and os.path.exists(os.path.join(sp_dir, "lr2.model"))
          and open(os.path.join(sp_dir, "ladder.csv")).read() == "round,x\n0,a\n1,b\n"
          and read_plies(os.path.join(sp_dir, "plies.csv")) == counts and len(fl.logged) == 1, f"{v} {counts}")
    check("self-play: plies.csv prices each round", [r["price_s"] for r in read_csv(os.path.join(sp_dir, "plies.csv"))]
          == [f"{selfplay_round_price(fl.us, 'lr', 0, 4, n):.6f}" for n in (300, 200)])

    # waiting: an experiment copies only unused rounds, waits for a new batch, then goes on
    g = os.path.join(tmp, "global")
    os.makedirs(os.path.join(g, "batch"))
    write_json(os.path.join(g, "config.json"), dict(kind="global", name="global",
                                                    lines=[dict(line="A", kind="lr", model="A", option="global")]))
    uw = {"tournament lr 2": (0.0, 2e6), "tournament random 0": (0.0, 0.0)}  # 2 s per move of A at ply 2

    def publish(cyc, ts, plies):
        new = os.path.join(g, "batch.new")
        shutil.rmtree(new, ignore_errors=True)
        rows = []
        for t in ts:
            gd = os.path.join(new, f"round{t}", "A@1-2~random")
            os.makedirs(gd)
            for f in GAME_FILES:
                open(os.path.join(gd, f), "w").close()
            rows.append(dict(t=t, white="A@1-2", black="random", result="1-0", plies=plies, cpu_s=1.0, ply2=True,
                             price_s=""))
        write_csv(os.path.join(new, "games.csv"), BATCH_GAMES_FIELDS, rows)
        write_json(os.path.join(new, "batch.json"), dict(cycle=cyc, made=now(), rounds=[
            dict(t=t, games=1, ply2_games=1, cpu_s=1.0, ply2_cpu_s=1.0) for t in ts]))
        with FileLock(os.path.join(g, "batch.lock")):
            shutil.rmtree(os.path.join(g, "batch"), ignore_errors=True)
            os.rename(new, os.path.join(g, "batch"))

    publish(1, [0, 1, 2], 10)  # each round 10 priced s
    ex = os.path.join(tmp, "experiments", "w")
    os.makedirs(ex)
    cfg = dict(name="w", kind="experiment", root=tmp, lines=[], references=["random"], global_source=g, min_rounds=5,
               wait_poll_s=0.05, cycles=3, rounds_per_cycle=5, prices=config_prices("T", uw))
    write_json(os.path.join(ex, "config.json"), cfg)
    write_json(os.path.join(ex, "state.json"), dict(cycle=0, lines={}, anchors={}, used_global_rounds=[],
                                                    last_round_ply2_cpu_s=6.0, status="running", phase="copy",
                                                    global_carry_s=0.0))
    Lw = League(ex)
    real_estimate = globals()["experiment_round_estimate"]
    globals()["experiment_round_estimate"] = lambda L, cur, rows: (6.0, "fixed for the test")
    cur = dict(cycle=1, events=[], rounds_planned=None)
    check("waiting: copies the newest rounds covering 5 rounds, priced by the experiment", try_copy(Lw, cur)
          and [r["t"] for r in cur["copied"]["rounds"]] == [0, 1, 2] and cur["rounds_planned"] == 5
          and cur["copied"]["ply2_price_s"] == 30.0 and len(copied_games(Lw)) == 3, f"{cur.get('copied')}")
    cur = dict(cycle=2, events=[], rounds_planned=None)
    check("waiting: a used batch makes it wait", not try_copy(Lw, cur))
    Lw.state["phase"] = "copy"
    Lw.state["current"] = cur
    th = threading.Thread(target=lambda: (time.sleep(0.4), publish(2, [3, 4, 5, 6], 8)))
    th.start()
    t0 = time.time()
    phase_copy(Lw, cur)
    th.join()
    check("waiting: goes on when a new batch appears", cur["copied"]["global_cycle"] == 2
          and [r["t"] for r in cur["copied"]["rounds"]] == [3, 4, 5, 6] and time.time() - t0 >= 0.3
          and cur["copied"]["ply2_price_s"] == 32.0 and cur["rounds_planned"] == 5
          and [e["event"] for e in cur["events"]] == ["wait-start", "copied", "wait-end"]
          and Lw.state["used_global_rounds"] == [[1, 0], [1, 1], [1, 2], [2, 3], [2, 4], [2, 5], [2, 6]],
          f"{cur['events']}")
    globals()["experiment_round_estimate"] = real_estimate
    shutil.rmtree(tmp, ignore_errors=True)
    for name in ok:
        print(f"ok  {name}")
    print(f"{len(ok)} rule checks passed")
    if not quick:
        replay_test(dirpath)
        options_test(dirpath)
        selfgames_test(dirpath, 1)
        selfgames_test(dirpath, 2)


def invert3(m):
    a, b, c = m[0]
    d, e, f = m[1]
    g, h, i = m[2]
    det = a * (e * i - f * h) - b * (d * i - f * g) + c * (d * h - e * g)
    return [[(e * i - f * h) / det, (c * h - b * i) / det, (b * f - c * e) / det],
            [(f * g - d * i) / det, (a * i - c * g) / det, (c * d - a * f) / det],
            [(d * h - e * g) / det, (b * g - a * h) / det, (a * e - b * d) / det]]


def driver(args, env_extra=None, check_code=None):
    env = dict(os.environ)
    env.pop("LEAGUES_FAIL_AT", None)
    if env_extra:
        env.update(env_extra)
    r = subprocess.run([sys.executable, os.path.abspath(__file__)] + args, env=env, capture_output=True, text=True)
    if check_code is not None and r.returncode != check_code:
        raise AssertionError(f"{args} {env_extra}: exit {r.returncode}, not {check_code}:\n{r.stdout[-2000:]}"
                             f"\n{r.stderr[-2000:]}")
    return r


MEASURED = {"date", "start", "end", "copied_at", "note", "wall_s", "cpu_s", "ply2_cpu_s", "train_cpu_s", "cal_cpu_s",
            "data_cpu_s", "selfplay_cpu_s", "selfplay_gen_cpu_s", "tournament_cpu_s", "tournament_wall_s",
            "tournament_proc_cpu_s", "global_cpu_s", "global_ply2_cpu_s", "wait_s", "data_cpu_target_s", "estimated",
            "self_games_proc_cpu_s", "self_games_wall_s"}


def snapshot(ldir, root):
    """What a replay must reproduce: games, ratings, models, self-play rounds and every record, without the measured
    columns (dates, CPU, wall times; MEASURED) and with the league's and root's paths made relative."""
    def rel(s):
        return s.replace(ldir, "<league>").replace(root, "<root>")

    out = {}
    for f in ("tour/games.csv", "tour/ratings.csv", "tour/players.txt", "tour/retired.txt", "anchors.csv",
              "entries.csv", "lines.csv", "batch/games.csv"):
        p = os.path.join(ldir, f)
        if os.path.exists(p):
            text = open(p).read()
            if f == "batch/games.csv":  # its cpu_s column is measured
                text = "\n".join(",".join(x.split(",")[:5] + x.split(",")[6:]) for x in text.splitlines())
            out[f] = rel(text)
    for f in ("cycles.csv", "events.csv", "history.csv", "rounds.csv", "totals.csv", "copied.csv", "self_games.csv"):
        rows = read_csv(os.path.join(ldir, f))
        out[f] = [{k: rel(v) for k, v in r.items() if k not in MEASURED} for r in rows]
    bj = read_json(os.path.join(ldir, "batch", "batch.json"))
    if bj:
        out["batch.json"] = dict(cycle=bj["cycle"], prices_version=bj.get("prices_version"),
                                 rounds=[{k: v for k, v in r.items() if k not in MEASURED} for r in bj["rounds"]])
    for base, _, files in os.walk(os.path.join(ldir, "runs")):
        for n in files:
            p = os.path.join(base, n)
            if n.endswith(".model") or n.endswith(".state"):
                out[os.path.relpath(p, ldir)] = file_md5(p)
            elif n in ("plies.csv", "ladder.csv", "results.txt"):
                out[os.path.relpath(p, ldir)] = open(p).read()
    st = read_json(os.path.join(ldir, "state.json"))
    out["state"] = {k: st.get(k) for k in ("cycle", "lines", "anchors", "anchor_entries", "used_global_rounds",
                                          "global_carry_s", "last_rounds", "status", "last_crown_cycle")}
    return out


def replay_test(dirpath):
    """Two roots, each a global league (F-L, T-L-Ne) and an experiment (F-L under self-play, local and global),
    run in step (global cycle k, then experiment cycle k): root a straight through, root b interrupted at many
    points of both leagues (every interrupted run resumes). Both must give the same games, ratings, models,
    self-play rounds and records: every decision uses prices and seeds, nothing measured."""
    base = os.path.join(dirpath, "replay")
    shutil.rmtree(base, ignore_errors=True)
    os.makedirs(base)
    gspec = dict(kind="global", models=["F-L", "T-L-Ne"], nice=19, threads=2, jobs=2, rounds_per_cycle=2,
                 calibration={"games": 20})
    xspec = dict(kind="experiment", name="x", models=["F-L"], options=["self-play", "local", "global"], cycles=3,
                 nice=19, threads=2, jobs=2, min_rounds=2, calibration={"games": 20},
                 selfplay={"round_anchor_games": 20, "chunk": 0.25})
    faults_b = {("global", 1): ["1:calibration", "1:tournament-partial", "1:batch", "1:train-one", "1:records-half"],
                ("x", 1): ["1:copy", "1:tournament-partial", "1:train-one", "1:self-play-chunk", "1:records-half"],
                ("global", 2): ["2:decide"],
                ("x", 2): ["2:copy", "2:self-play", "2:self-play-chunk", "2:records"],
                ("global", 3): [],
                ("x", 3): ["3:calibration", "3:train", "3:records-half"]}
    runs, cpu = {}, {}
    t0 = os.times()
    for name in ("a", "b"):
        root = os.path.join(base, name)
        for kind, spec in (("global", gspec), ("x", xspec)):
            sp = os.path.join(base, f"{name}-{kind}.json")
            write_json(sp, dict(spec, root=root))
            driver(["create", sp], check_code=0)
        dirs = {"global": os.path.join(root, "global"), "x": os.path.join(root, "experiments", "x")}
        injected = 0
        for k in (1, 2, 3):
            for kind in ("global", "x"):
                ldir = dirs[kind]
                for f in (faults_b[(kind, k)] if name == "b" else []):
                    r = driver(["run", ldir, "--cycles", "1"], {"LEAGUES_FAIL_AT": f})
                    if r.returncode != EXIT_INJECTED:
                        raise AssertionError(f"{kind} fault {f}: exit {r.returncode}\n{r.stdout[-1500:]}\n"
                                             f"{r.stderr[-1500:]}")
                    injected += 1
                while read_json(os.path.join(ldir, "state.json"))["cycle"] < k:
                    r = driver(["run", ldir, "--cycles", "1"])
                    if r.returncode not in (0, EXIT_DONE):
                        raise AssertionError(f"{kind} cycle {k}: exit {r.returncode}\n{r.stdout[-1500:]}\n"
                                             f"{r.stderr[-1500:]}")
        runs[name] = {kind: snapshot(d, root) for kind, d in dirs.items()}
        t1 = os.times()
        cpu[name] = (t1.children_user + t1.children_system) - (t0.children_user + t0.children_system)
        t0 = t1
        if name == "b":
            print(f"    root b: {injected} interruptions")
    for kind in ("global", "x"):
        a, b = runs["a"][kind], runs["b"][kind]
        diff = sorted(k for k in set(a) | set(b) if a.get(k) != b.get(k))
        if diff:
            raise AssertionError(f"replay: {kind} differs in {diff}")
    x = runs["a"]["x"]
    st = x["state"]
    sp_rounds = len([k for k in x if k.startswith("runs/F-L.sp/sp/lr") and k.endswith(".model")])
    opts = {r["option"] for r in x["cycles.csv"]}
    if not (st["status"] == "done" and st["cycle"] == 3 and opts == {"self-play", "local", "global"}
            and x["copied.csv"] and sp_rounds > 0 and "runs/F-L.sp/sp/plies.csv" in x):
        raise AssertionError(f"replay: the experiment didn't run as planned: {st} {opts} {sp_rounds}")
    print(f"ok  replay: an experiment with self-play, local and global lines and its global league, run straight and "
          f"interrupted {sum(len(v) for v in faults_b.values())} times, give the same games, ratings, models, "
          f"self-play rounds and records ({len(runs['a']['global'])} and {len(x)} items compared; "
          f"{sp_rounds} self-play rounds; global carry {st['global_carry_s']:.2f} priced s; CPU {cpu['a']:.0f} s "
          f"straight, {cpu['b']:.0f} s interrupted)")


def options_test(dirpath):
    """An experiment with the batch-4 options (no references, no ply-1 entries, the plateau rule; hybrid8 as the
    tournament binary), run straight (root a) and interrupted (root b): the same games, ratings, models and records.
    Its field has only ply-2 model entries, the tournament has no anchor, the ratings are re-centred on the rating
    zero, the last cycle is the one the plateau rule (or the cap) gives from the recorded decisions, it trains
    nothing, and a later run exits with 4 (done)."""
    base = os.path.join(dirpath, "options")
    shutil.rmtree(base, ignore_errors=True)
    os.makedirs(base)
    rules = {"cycles": 1, "min_cycles": 2}
    cap = 6
    spec = dict(kind="experiment", name="y", models=["F-L", "F-P"], options=["local"], cycles=cap, nice=19,
                threads=2, jobs=2, rounds_per_cycle=2, min_rounds=2, calibration={"games": 20}, references=[],
                ply1_entries=False, plateau=rules, tournament={"binary": os.path.join(BIN, "chessai-hybrid8")})
    faults_b = {1: ["1:calibration", "1:tournament-partial", "1:records-half"], 2: ["2:decide", "2:train",
                                                                                   "2:records-half"]}
    runs, injected = {}, 0
    for name in ("a", "b"):
        root = os.path.join(base, name)
        sp = os.path.join(base, f"{name}-y.json")
        write_json(sp, dict(spec, root=root))
        driver(["create", sp], check_code=0)
        ldir = os.path.join(root, "experiments", "y")
        for k in range(1, cap + 1):
            if read_json(os.path.join(ldir, "state.json"))["status"] == "done":
                break
            for f in (faults_b.get(k, []) if name == "b" else []):
                r = driver(["run", ldir, "--cycles", "1"], {"LEAGUES_FAIL_AT": f})
                if r.returncode != EXIT_INJECTED:
                    raise AssertionError(f"options fault {f}: exit {r.returncode}\n{r.stdout[-1500:]}\n"
                                         f"{r.stderr[-1500:]}")
                injected += 1
            while True:
                st = read_json(os.path.join(ldir, "state.json"))
                if st["cycle"] >= k or st["status"] == "done":
                    break
                r = driver(["run", ldir, "--cycles", "1"])
                if r.returncode not in (0, EXIT_DONE):
                    raise AssertionError(f"options cycle {k}: exit {r.returncode}\n{r.stdout[-1500:]}\n"
                                         f"{r.stderr[-1500:]}")
        driver(["run", ldir, "--cycles", "1"], check_code=EXIT_DONE)
        runs[name] = (snapshot(ldir, root), ldir)
    a, b = runs["a"][0], runs["b"][0]
    diff = sorted(k for k in set(a) | set(b) if a.get(k) != b.get(k))
    if diff:
        raise AssertionError(f"options: straight and interrupted differ in {diff}")
    ldir = runs["a"][1]
    cfg = read_json(os.path.join(ldir, "config.json"))
    zero = cfg["rating_zero"]
    entries = read_csv(os.path.join(ldir, "entries.csv"))
    hist = read_csv(os.path.join(ldir, "history.csv"))
    cyc = read_csv(os.path.join(ldir, "cycles.csv"))
    ev = read_csv(os.path.join(ldir, "events.csv"))
    players = open(os.path.join(ldir, "tour", "players.txt")).read()
    last, stop = 0, None
    for c in range(1, cap + 1):
        if any(r["decision"] in ("first-champion", "new-champion") for r in cyc if int(r["cycle"]) == c):
            last = c
        if plateau_stop(c, last, rules) or c >= cap:
            stop = c
            break
    by_plateau = plateau_stop(stop, last, rules)
    done = [r for r in ev if r["event"] == "done"]
    st = a["state"]
    problems = []
    if zero != "F-L.loc@0-2" or cfg.get("ply1_entries") is not False:
        problems.append(f"config {zero} {cfg.get('ply1_entries')}")
    if not entries or not all(r["ply"] == "2" and r["line"] for r in entries) or "random" in players:
        problems.append("an entry that is not a model at ply 2")
    if "relative to the field's mean" not in open(os.path.join(ldir, "tour", "ratings.md")).read():
        problems.append("the tournament had an anchor")
    zrows = [r for r in hist if r["entry"] == zero]
    if not zrows or zrows[0]["cycle"] != "1" or not all(r["elo"] in ("0.0", "") for r in zrows):
        problems.append(f"the rating zero's rows {zrows}")
    if any(r["entry1"] or r["elo1"] for r in cyc):
        problems.append("a ply-1 entry in cycles.csv")
    if st["cycle"] != stop or st["status"] != "done" or st["last_crown_cycle"] != last:
        problems.append(f"stopped at {st['cycle']} ({st['status']}, last crowning {st['last_crown_cycle']}); the "
                        f"rule says {stop} (last crowning {last})")
    if len(done) != 1 or done[0]["cycle"] != str(stop) or done[0]["detail"].startswith("plateau") != by_plateau:
        problems.append(f"done events {done}")
    if any(r["train_games"] for r in cyc if r["cycle"] == str(stop)):
        problems.append("the last cycle trained")
    if problems:
        raise AssertionError("options: " + "; ".join(problems))
    print(f"ok  options: an experiment without references or ply-1 entries, with the plateau rule, run straight and "
          f"interrupted {injected} times, gives the same games, ratings, models and records "
          f"({len(a)} items compared); only ply-2 entries ({len(entries)}); the rating zero {zero} at 0; done "
          f"after cycle {stop} by {'the plateau rule' if by_plateau else 'the cap'} (last crowning in cycle {last}); "
          f"the last cycle trained nothing; a later run exits with {EXIT_DONE}")


def selfgames_test(dirpath, ply):
    """An experiment with the options of 2026-11-10 ~22:15-22:30: self-games, a scaled plateau and (ply 1) the main
    entries at ply 1; F-L and F-P under self-play and local, no references, hybrid9 as the tournament binary. Run
    straight (root a) and interrupted (root b, including inside the self-games phase): the same games, ratings,
    models, self-games and records. Root c is the same experiment without self-games, for one cycle. Checks: every
    entry and game at the entry ply; no self-game in tour/games.csv; one self-game per main entry per round in each
    cycle that trains and none in the last; the local lines train on the round-robins' qualifying games plus the
    self-games; the local data's price (the self-play budget) is the round-robins' plus the self-games'; cycle 1's
    games, ratings and decisions are root c's, and its self-play budget exceeds c's by the self-games' price; the
    plateau's K is round(k2 x sqrt(2 / lines))."""
    base = os.path.join(dirpath, f"selfgames-ply{ply}")
    shutil.rmtree(base, ignore_errors=True)
    os.makedirs(base)
    cap = 4
    spec = dict(kind="experiment", name="z", models=["F-L", "F-P"], options=["self-play", "local"], cycles=cap,
                nice=19, threads=2, jobs=2, rounds_per_cycle=2, min_rounds=2, calibration={"games": 20},
                selfplay={"round_anchor_games": 20, "chunk": 0.5}, references=[], ply1_entries=False,
                plateau={"scaled": {"k2": 2}, "min_cycles": 3}, self_games=True,
                tournament={"binary": os.path.join(BIN, "chessai-hybrid9")})
    if ply != 2:
        spec["entry_ply"] = ply
    faults_b = {1: ["1:self-games", "1:self-games-partial", "1:train-one", "1:self-play-chunk"],
                2: ["2:self-games-partial", "2:records-half"], 3: ["3:self-games", "3:records-half"]}
    runs, injected, cpu = {}, 0, {}
    t0 = os.times()
    for name in ("a", "b", "c"):
        root = os.path.join(base, name)
        sp = os.path.join(base, f"{name}-z.json")
        write_json(sp, dict(spec, root=root) if name != "c" else dict({k: v for k, v in spec.items()
                                                                       if k != "self_games"}, root=root))
        driver(["create", sp], check_code=0)
        ldir = os.path.join(root, "experiments", "z")
        for k in range(1, (1 if name == "c" else cap) + 1):
            if read_json(os.path.join(ldir, "state.json"))["status"] == "done":
                break
            for f in (faults_b.get(k, []) if name == "b" else []):
                r = driver(["run", ldir, "--cycles", "1"], {"LEAGUES_FAIL_AT": f})
                if r.returncode != EXIT_INJECTED:
                    raise AssertionError(f"self-games fault {f}: exit {r.returncode}\n{r.stdout[-1500:]}\n"
                                         f"{r.stderr[-1500:]}")
                injected += 1
            while True:
                st = read_json(os.path.join(ldir, "state.json"))
                if st["cycle"] >= k or st["status"] == "done":
                    break
                r = driver(["run", ldir, "--cycles", "1"])
                if r.returncode not in (0, EXIT_DONE):
                    raise AssertionError(f"self-games cycle {k}: exit {r.returncode}\n{r.stdout[-1500:]}\n"
                                         f"{r.stderr[-1500:]}")
        runs[name] = (snapshot(ldir, root), ldir)
        t1 = os.times()
        cpu[name] = (t1.children_user + t1.children_system) - (t0.children_user + t0.children_system)
        t0 = t1
    a, b = runs["a"][0], runs["b"][0]
    diff = sorted(k for k in set(a) | set(b) if a.get(k) != b.get(k))
    if diff:
        raise AssertionError(f"self-games (ply {ply}): straight and interrupted differ in {diff}")
    ldir, cdir = runs["a"][1], runs["c"][1]
    cfg = read_json(os.path.join(ldir, "config.json"))
    rd = {f: read_csv(os.path.join(ldir, f)) for f in ("cycles.csv", "rounds.csv", "totals.csv", "history.csv",
                                                       "self_games.csv")}
    cd = {f: read_csv(os.path.join(cdir, f)) for f in ("cycles.csv", "totals.csv", "history.csv")}
    games = read_csv(os.path.join(ldir, "tour", "games.csv"))
    st = a["state"]
    problems = []
    k_want = scaled_plateau_cycles(2, len(cfg["lines"]))
    if cfg["plateau"] != {"cycles": k_want, "min_cycles": 3, "scaled": {"k2": 2, "lines": len(cfg["lines"])}}:
        problems.append(f"plateau {cfg['plateau']}")
    if entry_ply(cfg) != ply or not cfg.get("self_games"):
        problems.append(f"config entry ply {entry_ply(cfg)}, self_games {cfg.get('self_games')}")
    if any(g["white"] == g["black"] for g in games):
        problems.append("a self-game in tour/games.csv")
    if not games or not all(parse_entry(g["white"])[3] == ply and parse_entry(g["black"])[3] == ply for g in games):
        problems.append(f"a round-robin game not at ply {ply}")
    last = st["cycle"]
    for c in range(1, last + 1):
        cs = str(c)
        field = [r["entry"] for r in rd["history.csv"] if r["cycle"] == cs]
        sg = [r for r in rd["self_games.csv"] if r["cycle"] == cs]
        rounds = [r for r in rd["rounds.csv"] if r["cycle"] == cs]
        tot = [r for r in rd["totals.csv"] if r["cycle"] == cs][0]
        want_n = 0 if c == last else len(rounds) * len(field)
        if len(sg) != want_n or int(tot["self_games"]) != want_n:
            problems.append(f"cycle {c}: {len(sg)} self-games (totals {tot['self_games']}), not {want_n}")
        if any(r["white"] != r["entry"] or r["black"] != r["entry"] or r["entry"] not in field
               or parse_entry(r["entry"])[3] != ply for r in sg):
            problems.append(f"cycle {c}: a self-game not of a main entry against itself")
        if sorted((int(r["t"]), r["entry"]) for r in sg) != sorted((int(x["t"]), e) for x in rounds for e in field
                                                                  if want_n):
            problems.append(f"cycle {c}: the self-games are not one per entry per round")
        sg_price = sum(float(r["price_s"]) for r in sg)
        if abs(float(tot["self_games_price_s"] or 0) - sg_price) > 0.006:
            problems.append(f"cycle {c}: totals' self-games price {tot['self_games_price_s']} vs {sg_price}")
        if abs(float(tot["data_price_target_s"]) - float(tot["ply2_price_s"]) - sg_price) > 0.011:
            problems.append(f"cycle {c}: the local data's price {tot['data_price_target_s']} is not the round-robins' "
                            f"{tot['ply2_price_s']} plus the self-games' {sg_price:.3f}")
        q = sum(int(r["ply2_games"]) for r in rounds)
        for r in rd["cycles.csv"]:
            if r["cycle"] != cs:
                continue
            if r["option"] == "local" and c != last and int(r["train_games"]) != q + len(sg):
                problems.append(f"cycle {c}: {r['line']} trained on {r['train_games']} games, not {q} + {len(sg)}")
            if r["option"] == "self-play" and c == 1 and abs(float(r["selfplay_budget_s"])
                                                             - float(tot["data_price_target_s"])) > 0.011:
                problems.append(f"cycle 1: {r['line']}'s budget {r['selfplay_budget_s']} is not the local data's "
                                f"price {tot['data_price_target_s']}")
            if r["option"] == "self-play" and c == 1 and int(r["selfplay_rounds"] or 0) < 1:
                problems.append(f"cycle 1: {r['line']} played no self-play round")
    key = ("line", "version", "entry2", "elo2", "champion_entry", "champion_elo", "diff", "z", "decision")
    a1 = [{k: r[k] for k in key} for r in rd["cycles.csv"] if r["cycle"] == "1"]
    c1 = [{k: r[k] for k in key} for r in cd["cycles.csv"] if r["cycle"] == "1"]
    games_c = read_csv(os.path.join(cdir, "tour", "games.csv"))
    rr = int(cfg["rounds_per_cycle"])
    if (a1 != c1 or [r for r in rd["history.csv"] if r["cycle"] == "1"] != cd["history.csv"]
            or [g for g in games if int(g["tournament"]) < rr] != games_c):
        problems.append("cycle 1's games, ratings or decisions differ from the run without self-games")
    ta, tc = rd["totals.csv"][0], cd["totals.csv"][0]
    bud = {r["line"]: float(r["selfplay_budget_s"]) for r in rd["cycles.csv"] if r["cycle"] == "1"
           and r["option"] == "self-play"}
    bud_c = {r["line"]: float(r["selfplay_budget_s"]) for r in cd["cycles.csv"] if r["option"] == "self-play"}
    if not bud or any(abs(bud[x] - bud_c[x] - float(ta["self_games_price_s"])) > 0.011 for x in bud):
        problems.append(f"cycle 1: self-play budgets {bud} against {bud_c} without self-games (self-games' price "
                        f"{ta['self_games_price_s']})")
    if "self_games" in tc or os.path.exists(os.path.join(cdir, "self_games.csv")):
        problems.append("self-games records in the run without them")
    if problems:
        raise AssertionError(f"self-games (ply {ply}): " + "; ".join(problems))
    n_sg = len(rd["self_games.csv"])
    print(f"ok  self-games at ply {ply}: an experiment with self-games and a scaled plateau (K {k_want} for "
          f"{len(cfg['lines'])} lines), run straight and interrupted {injected} times, gives the same games, ratings, "
          f"models, self-games and records ({len(a)} items compared); {n_sg} self-games over {last} cycles, none in "
          f"the ratings; cycle 1 as without them except training and the self-play budget (higher by their price "
          f"{ta['self_games_price_s']} s); done after cycle {last}; CPU {cpu['a']:.0f} s straight, {cpu['b']:.0f} s "
          f"interrupted, {cpu['c']:.0f} s without")


# ---------------------------------------------------------------- main

def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)
    a = sub.add_parser("create")
    a.add_argument("spec")
    a = sub.add_parser("add")
    a.add_argument("league")
    a.add_argument("recipes", nargs="+")
    a = sub.add_parser("run")
    a.add_argument("league")
    a.add_argument("--cycles", type=int)
    a = sub.add_parser("status")
    a.add_argument("path", nargs="?", default=HERE)
    a = sub.add_parser("stop")
    a.add_argument("league")
    a = sub.add_parser("index")
    a.add_argument("root")
    a = sub.add_parser("selftest")
    a.add_argument("--dir", default=None)
    a.add_argument("--quick", action="store_true")
    a = sub.add_parser("prices")
    a.add_argument("spec")
    a.add_argument("--fit-only", action="store_true")
    a.add_argument("--measure-only", action="store_true")
    a.add_argument("--check", action="store_true")
    args = ap.parse_args()
    if args.cmd == "prices":
        sys.exit(subprocess.call([sys.executable, os.path.join(HERE, "calibrate.py"), args.spec]
                                 + [f"--{f.replace('_', '-')}" for f in ("fit_only", "measure_only", "check")
                                    if getattr(args, f)]))
    if args.cmd == "create":
        cmd_create(args.spec)
    elif args.cmd == "add":
        cmd_add(args.league, args.recipes)
    elif args.cmd == "run":
        sys.exit(cmd_run(args.league, args.cycles))
    elif args.cmd == "status":
        cmd_status(args.path)
    elif args.cmd == "stop":
        cmd_stop(args.league)
    elif args.cmd == "index":
        write_index(os.path.abspath(args.root))
    elif args.cmd == "selftest":
        d = os.path.abspath(args.dir) if args.dir else tempfile.mkdtemp(prefix="leagues-selftest-")
        os.makedirs(d, exist_ok=True)
        selftest(d, args.quick)


if __name__ == "__main__":
    main()
