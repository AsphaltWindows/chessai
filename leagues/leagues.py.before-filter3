                                         f"{r.stderr[-1500:]}")
        driver(["run", ldir, "--cycles", "1"], check_code=EXIT_DONE)
        runs[name] = (snapshot(ldir, root), ldir)
    a, b = runs["a"][0], runs["b"][0]
    diff = sorted(k for k in set(a) | set(b) if a.get(k) != b.get(k))
