def invert3(m):
    a, b, c = m[0]
    d, e, f = m[1]
    g, h, i = m[2]
    det = a * (e * i - f * h) - b * (d * i - f * g) + c * (d * h - e * g)
    return [[(e * i - f * h) / det, (c * h - b * i) / det, (b * f - c * e) / det],
            [(f * g - d * i) / det, (a * i - c * g) / det, (c * d - a * f) / det],
            [(d * h - e * g) / det, (b * g - a * h) / det, (a * e - b * d) / det]]


def driver(args, env_extra=None, check_code=None):
    env = dict(os.environ)
    env.pop("LEAGUES_FAIL_AT", None)
    if env_extra:
        env.update(env_extra)
    r = subprocess.run([sys.executable, os.path.abspath(__file__)] + args, env=env, capture_output=True, text=True)
    if check_code is not None and r.returncode != check_code:
        raise AssertionError(f"{args} {env_extra}: exit {r.returncode}, not {check_code}:\n{r.stdout[-2000:]}"
                             f"\n{r.stderr[-2000:]}")
    return r


