                       f"{a['outside_streak']} | {'yes' if a['available'] else 'no'} |")
    ev = [e for e in events if e["event"] not in ("first-champion",)]
    if ev:
        out += ["", "Events:"]
        out += [f"- {e['event']} {e['line']} {e['entry']} {e['version_name']} {e['value']} {e['detail']}".rstrip()
                for e in ev]
    atomic_write(L.p(f"cycle-{c:03d}.md"), "\n".join(out) + "\n")


# ---------------------------------------------------------------- run

PHASES_GLOBAL = ["calibration", "tournament", "batch", "decide", "train", "records"]
PHASES_EXPERIMENT = ["copy", "calibration", "tournament", "decide", "train", "self-play", "records"]


def phases_of(L):
    """The league's phases: its kind's, with self-games after decide when the config has "self_games": true (and
    topup-games after them with self_games_topup), and cold-games after the tournament with cold_games."""
    phases = PHASES_GLOBAL if L.is_global else PHASES_EXPERIMENT
    if L.cfg.get("self_games"):
        i = phases.index("decide") + 1
        phases = phases[:i] + ["self-games"] + phases[i:]
    if L.cfg.get("self_games_topup"):
        i = phases.index("self-games") + 1
        phases = phases[:i] + ["topup-games"] + phases[i:]
    if L.cfg.get("cold_games") is not None:
        i = phases.index("tournament") + 1
        phases = phases[:i] + ["cold-games"] + phases[i:]
    return phases


def run_cycle(L):
    cur = start_cycle(L)
    c = cur["cycle"]
    phases = phases_of(L)
    with_global = any(lc["option"] == "global" for lc in L.cfg["lines"])
    while True:
        phase = cur["phase"]
        if phase == "waiting":
            phase = "copy"
        inject(c, phase)
        if phase == "copy":
            if with_global:
                phase_copy(L, cur)
        elif phase == "calibration":
            phase_calibration(L, cur)
        elif phase == "tournament":
            phase_tournament(L, cur)
        elif phase == "batch":
            publish_batch(L, cur)
        elif phase == "decide":
            phase_decide(L, cur)
        elif phase == "self-games":
            phase_selfgames(L, cur)
        elif phase == "cold-games":
            phase_cold(L, cur)
        elif phase == "topup-games":
            phase_topup(L, cur)
        elif phase == "train":
            phase_train(L, cur)
        elif phase == "self-play":
            phase_selfplay(L, cur)
        elif phase == "records":
            phase_records(L, cur)
            return
        else:
            raise RuntimeError(f"unknown phase {phase}")
        L.set_phase(phases[phases.index(phase) + 1])


def cmd_run(ldir, cycles):
    L = League(ldir)
    if L.us is None:
        sys.exit(f"{L.dir}: made before prices (no prices in config.json); create the league again")
    refuse_global_1109(L, "run")
    try:
        games_per_entry(L.cfg)
        games_per_cycle(L.cfg)
        frozen_refs_check(L.cfg)
        reference_window_of(L.cfg)
        cold_games_of(L.cfg)
        train_filter_of(L.cfg)
        topup_of(L.cfg)
    except ValueError as e:
        sys.exit(f"{L.dir}: config.json: {e}")
    lock = FileLock(L.p(".lock"), block=False)
    try:
        lock.__enter__()
    except OSError:
        sys.exit(f"{L.dir}: another driver runs this league")
    signal.signal(signal.SIGTERM, on_signal)
    signal.signal(signal.SIGINT, on_signal)
    ran = 0
    try:
        L.state["pid"] = os.getpid()
        if L.state["status"] == "done":
            L.log("the experiment is done")
            return EXIT_DONE
        L.save(index=True)
        while cycles is None or ran < cycles:
            if not L.state.get("current"):
                if L.cfg["kind"] == "experiment" and L.state["cycle"] >= L.cfg["cycles"]:
                    L.state["status"] = "done"
                    L.save(index=True)
                    return EXIT_DONE
                check_stop(L)
            run_cycle(L)
            ran += 1
            if L.state["status"] == "done":
                L.state["pid"] = None
                L.save(index=True)
                return EXIT_DONE
        L.state["status"] = "stopped"
        L.state["pid"] = None
        L.save(index=True)
        return 0
    except SystemExit as e:
        if e.code == EXIT_INJECTED:
            L.state["status"] = "stopped"
            L.state["pid"] = None
            L.save(index=True)
        raise
    except Interrupted as e:
        L.log(f"interrupted ({e}); the cycle resumes on the next run")
        L.state["status"] = "stopped"
        L.state["pid"] = None
        L.save(index=True)
        return 130
    except Exception as e:
        L.log(f"failed: {type(e).__name__}: {e}")
        L.state["status"] = "failed"
        L.state["pid"] = None
        L.save(index=True)
        raise
    finally:
        lock.__exit__(None, None, None)


