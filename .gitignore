c_src/.idea
py_src/.idea
cpp_src/.idea
*.so
*.model
*.games
games/**
models/**
# Research docs and their archive are tracked (the user, 2026-11-10); data and models stay out
!models/*.md
!models/archive/
!models/archive/**
selfplay/**
.idea/
rs/target/
__pycache__/

# Cycle system (cycles/, cycles/champ/): code, configs, lineages and cycle
# reports only; runs, games, models, backups, logs and state stay out
cycles/*/
!cycles/champ/
cycles/champ/*/
cycles/**/*.log
cycles/**/*.out
cycles/**/*.lock
cycles/**/*.bak-*
cycles/**/state.json
cycles/**/cycles.csv
cycles/**/totals.csv

# New league system (leagues/): code, docs, prices, recipes and specs; the
# leagues themselves (global/, experiments/, arenas/, index.json) and the
# smoke root stay out
leagues/index.json
leagues/.index.lock
leagues/global/
leagues/experiments/
leagues/arenas/
leagues/*.log
leagues-smoke/

# Data inside leagues/ (2026-11-13): warm-start model states and the Play page's calibration cache
leagues/starts/
leagues/play-games/owncal/
