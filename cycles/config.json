    "round_rule_binary": "models/from-scratch/bin/chessai-cyc",
    "reference_runs": {
      "lr": "models/from-scratch/F-L-s21",
      "cnbp": "models/from-scratch/F-N-s11",
      "moe": "models/from-scratch/moe-s21",
      "fm": "models/from-scratch/F-FM-s21",
      "probit": "models/from-scratch/probit/selfplay/F-P-s21"
    }
  },
  "freeze_rule": {"after_dormant": 10, "milestone_step": 100, "milestone_window": 10, "reference_window": 50,
                  "exempt": []}
}
