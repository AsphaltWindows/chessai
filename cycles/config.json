  "jobs": 2,
  "threads_per_job": 4,
  "nice": 10,
  "patience": 2,
  "dormancy_se": 1.5,
  "requalify_se": 1.0,
  "heldout": {
    "lr": "games/heldout-lr-d2-s555/round0",
    "cnbp": "games/heldout-cnbp-d2-s555/round0"
  },
  "own_games": {
    "enabled": true,
    "binary": "models/from-scratch/bin/chessai-cyc5-labels",
    "binary_by_lineage": {"T-L-Nc-fresh-c": "models/from-scratch/bin/chessai-resid4",
                          "T-L-Ne-fresh-c": "models/from-scratch/bin/chessai-resid4",
                          "T-L-Le-fresh-c": "models/from-scratch/bin/chessai-resid4",
                          "T-N-Nc-fresh-c": "models/from-scratch/bin/chessai-resid4",
                          "T-L-Ne-pre-c": "models/from-scratch/bin/chessai-presplit",
                          "T-L-Le-pre-c": "models/from-scratch/bin/chessai-presplit",
                          "D-L-Nc-c": "models/from-scratch/bin/chessai-dag",
                          "F-P-c": "models/from-scratch/bin/chessai-probit",
                          "F-P-tau0-c": "models/from-scratch/bin/chessai-probit",
                          "F-P-tau0-d2jit-c": "models/from-scratch/bin/chessai-probit"},
    "opponents": "lineages",
    "dormant": true,
    "first_pool": "",
    "pools_dir": "cycles/pools",
    "keep_pools": false
  },
  "gate": {
    "games": 1000,
    "depth": 2,
    "threshold": 0.5,
    "seed": 1
  },
  "measure": {
    "dir": "cycles/.measure",
    "rounds": 2,
    "games_by_depth": {
      "0": 1000,
      "1": 1000,
      "2": 200,
      "3": 50,
      "4": 10
    },
    "games_by_kind": {
      "moe": 300,
      "fm": 300
