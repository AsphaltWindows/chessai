{
  "root": "/home/iv/dev/chessai",
  "registry": "cycles/lineages.txt",
  "costs": "cycles/costs.csv",
  "runs_dir": "cycles/runs",
  "state": "cycles/state.json",
  "log_csv": "cycles/cycles.csv",
  "log_dir": "cycles",
  "league_dir": "selfplay/league-cycles",
  "league_py": "cycles/league.py",
